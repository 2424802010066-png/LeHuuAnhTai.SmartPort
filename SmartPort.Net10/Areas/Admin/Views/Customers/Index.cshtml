@model List<SmartPort.Models.KhachHang>
@{
    ViewBag.Title = "Quản lý khách hàng";
    Dictionary<int, int> soBooking = ViewBag.SoBooking;
}
<div class="card-sp">
    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="q" value="@ViewBag.Q" class="form-control form-control-sm" style="width:260px;" placeholder="Tên công ty / MST / người liên hệ" />
            <button class="btn btn-sm btn-navy" type="submit"><i class="bi bi-search"></i></button>
        </form>
        <a class="btn btn-sm btn-accent" href="@Url.Action("Form")"><i class="bi bi-plus-lg me-1"></i>Thêm khách hàng</a>
    </div>
    <div class="table-responsive">
        <table class="table table-sp">
            <thead>
                <tr><th>Công ty</th><th>MST</th><th>Người liên hệ</th><th>Điện thoại</th><th>Email</th><th class="text-center">Booking</th><th class="text-end">Thao tác</th></tr>
            </thead>
            <tbody>
                @foreach (var k in Model)
                {
                    <tr>
                        <td class="fw-semibold">@k.TenCongTy<div class="text-muted small fw-normal">@k.DiaChi</div></td>
                        <td>@k.MaSoThue</td>
                        <td>@k.NguoiLienHe</td>
                        <td>@k.SoDienThoai</td>
                        <td class="small">@k.Email</td>
                        <td class="text-center">@(soBooking.ContainsKey(k.MaKH) ? soBooking[k.MaKH] : 0)</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Form", new { id = k.MaKH })"><i class="bi bi-pencil"></i></a>
                            @using (Html.BeginForm("Delete", "Customers", new { id = k.MaKH }, FormMethod.Post, null, new { @class = "d-inline", onsubmit = "return confirm('Xóa khách hàng?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
