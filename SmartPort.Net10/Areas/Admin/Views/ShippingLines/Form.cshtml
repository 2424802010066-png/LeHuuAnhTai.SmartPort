@model SmartPort.Models.HangTau
@{
    ViewBag.Title = Model.MaHangTau == 0 ? "Thêm hãng tàu" : "Sửa hãng tàu " + Model.TenHangTau;
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-sp">
            <div class="card-header"><i class="bi bi-globe2 me-2 text-primary"></i>@ViewBag.Title</div>
            <div class="p-4">
                @using (Html.BeginForm("Save", "ShippingLines", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.MaHangTau)
                    @Html.ValidationSummary(true)
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Tên hãng tàu <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.TenHangTau, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.TenHangTau)
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Mã SCAC</label>
                            @Html.TextBoxFor(m => m.MaSCAC, new { @class = "form-control", placeholder = "VD: MAEU" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Quốc gia</label>
                            @Html.TextBoxFor(m => m.QuocGia, new { @class = "form-control" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Website</label>
                            @Html.TextBoxFor(m => m.Website, new { @class = "form-control" })
                        </div>
                        <div class="col-12 mt-4">
                            <button class="btn btn-accent px-4" type="submit"><i class="bi bi-save me-1"></i>Lưu</button>
                            <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Quay lại</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
