@{
    ViewBag.Title = "Tổng quan";
    ForecastResult fc = ViewBag.Forecast;
    int chuaGanBen = ViewBag.SoChuyenChuaGanBen;
}

<div class="row g-3 mb-3">
    <div class="col-6 col-xl-2">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="ico ico-cyan"><i class="bi bi-water"></i></div>
            <div><div class="num">@ViewBag.TauTrongCang</div><div class="lbl">Tàu trong cảng</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-2">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="ico ico-blue"><i class="bi bi-calendar2-week"></i></div>
            <div><div class="num">@ViewBag.ChuyenSapDen</div><div class="lbl">Chuyến đến trong 7 ngày</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-2">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="ico ico-orange"><i class="bi bi-box-seam"></i></div>
            <div><div class="num">@ViewBag.ContTrongBai</div><div class="lbl">Container trong bãi</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-2">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="ico ico-red"><i class="bi bi-hourglass-split"></i></div>
            <div><div class="num">@ViewBag.BookingChoDuyet</div><div class="lbl">Booking chờ duyệt</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-2">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="ico ico-green"><i class="bi bi-cash-stack"></i></div>
            <div><div class="num" style="font-size:1.1rem;">@Ui.Vnd((decimal)ViewBag.DoanhThuThang)</div><div class="lbl">Doanh thu DV tháng này</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-2">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="ico ico-purple"><i class="bi bi-buildings"></i></div>
            <div><div class="num">@ViewBag.SoKhachHang</div><div class="lbl">Khách hàng</div></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="ai-box h-100">
            <span class="ai-tag"><i class="bi bi-stars"></i> AI DỰ BÁO SẢN LƯỢNG</span>
            <div class="row align-items-center mt-2 g-3">
                <div class="col-md-4">
                    <div class="big">@Ui.Num(fc.NextMonthTEU) TEU</div>
                    <div style="color:#c9dcef;">Dự báo @fc.NextMonthLabel</div>
                </div>
                <div class="col-md-4">
                    <div class="big">@(fc.GrowthPercent >= 0 ? "+" : "")@fc.GrowthPercent%</div>
                    <div style="color:#c9dcef;">So với tháng gần nhất</div>
                </div>
                <div class="col-md-4">
                    <div class="big">@(fc.Slope >= 0 ? "+" : "")@Ui.Num((decimal)fc.Slope)</div>
                    <div style="color:#c9dcef;">TEU/tháng theo xu hướng (hồi quy tuyến tính)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="stat-card h-100 d-flex flex-column justify-content-center">
            @if (chuaGanBen > 0)
            {
                <div class="d-flex align-items-center gap-3">
                    <div class="ico ico-orange"><i class="bi bi-exclamation-triangle"></i></div>
                    <div>
                        <div class="fw-bold">@chuaGanBen chuyến tàu chưa được phân bến</div>
                        <div class="text-muted small">Dùng AI để gợi ý bến tối ưu theo thông số tàu</div>
                    </div>
                </div>
                <a class="btn btn-accent mt-3" href="@Url.Action("Berth", "AiTools")"><i class="bi bi-stars me-1"></i>AI phân bổ bến ngay</a>
            }
            else
            {
                <div class="d-flex align-items-center gap-3">
                    <div class="ico ico-green"><i class="bi bi-check2-circle"></i></div>
                    <div>
                        <div class="fw-bold">Tất cả chuyến đã có bến</div>
                        <div class="text-muted small">Điều độ đang trong tầm kiểm soát</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="card-sp mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-stars me-2 text-warning"></i>Trợ lý AI vận hành — cảnh báo &amp; gợi ý thông minh</span>
        <span class="badge-st st-run">Quét tự động</span>
    </div>
    <div class="p-3">
        @{ List<SmartAlert> alerts = ViewBag.Alerts; }
        @if (alerts.Count == 0)
        {
            <div class="text-center text-muted py-3"><i class="bi bi-check2-circle text-success me-1"></i>Mọi chỉ số vận hành đều ổn — không có cảnh báo nào.</div>
        }
        @foreach (var a in alerts)
        {
            <div class="alert-item @a.Muc">
                <div class="a-ico"><i class="bi @a.Icon"></i></div>
                <div class="a-msg">@a.Msg</div>
                <a class="btn btn-sm btn-outline-primary a-link" href="@Url.Content("~" + a.Url)">Xử lý <i class="bi bi-arrow-right"></i></a>
            </div>
        }
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="card-sp">
            <div class="card-header"><i class="bi bi-graph-up me-2 text-primary"></i>Sản lượng container (TEU) — lịch sử &amp; dự báo AI</div>
            <div class="p-3" style="height:320px;"><canvas id="teuChart"></canvas></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-sp">
            <div class="card-header"><i class="bi bi-pie-chart me-2 text-primary"></i>Container theo trạng thái</div>
            <div class="p-3" style="height:320px;"><canvas id="contChart"></canvas></div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-5">
        <div class="card-sp">
            <div class="card-header"><i class="bi bi-bar-chart me-2 text-primary"></i>Doanh thu khai thác 6 tháng (tỷ đồng)</div>
            <div class="p-3" style="height:300px;"><canvas id="revChart"></canvas></div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card-sp">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-receipt me-2 text-primary"></i>Booking mới nhất</span>
                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", "Bookings")">Tất cả</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sp">
                    <thead><tr><th>Số booking</th><th>Khách hàng</th><th>Ngày tạo</th><th class="text-end">Tổng tiền</th><th>Trạng thái</th></tr></thead>
                    <tbody>
                        @foreach (DatDichVu b in ViewBag.BookingMoi)
                        {
                            <tr>
                                <td><a class="fw-semibold" href="@Url.Action("Details", "Bookings", new { id = b.MaBooking })">@b.MaSoBooking</a></td>
                                <td>@(b.KhachHang != null ? b.KhachHang.TenCongTy : "—")</td>
                                <td>@Ui.D(b.NgayTao)</td>
                                <td class="text-end">@Ui.Vnd(b.TongTien)</td>
                                <td><span class="badge-st @Ui.Badge(b.TrangThai)">@b.TrangThai</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="card-sp">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-calendar2-week me-2 text-primary"></i>Chuyến tàu sắp tới / đang làm hàng</span>
        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", "VesselCalls")">Điều độ</a>
    </div>
    <div class="table-responsive">
        <table class="table table-sp">
            <thead><tr><th>Chuyến</th><th>Tàu</th><th>ETA</th><th>ETD</th><th>Bến</th><th>Cont N/X</th><th>Trạng thái</th></tr></thead>
            <tbody>
                @foreach (ChuyenTau c in ViewBag.ChuyenSapToi)
                {
                    <tr>
                        <td class="fw-semibold">@c.MaChuyenHieu</td>
                        <td>@(c.Tau != null ? c.Tau.TenTau : "—")</td>
                        <td>@Ui.Dt(c.ETA)</td>
                        <td>@Ui.Dt(c.ETD)</td>
                        <td>@(c.Ben != null ? c.Ben.TenBen : "")@(c.Ben == null ? "" : "")@if (c.Ben == null) {<span class="badge-st st-warn">Chưa phân bến</span>}</td>
                        <td>@c.ContNhap / @c.ContXuat</td>
                        <td><span class="badge-st @Ui.Badge(c.TrangThai)">@c.TrangThai</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
<script>
    var teuData = @Html.Raw(ViewBag.TeuChart);
    var contData = @Html.Raw(ViewBag.ContChart);
    var revData = @Html.Raw(ViewBag.RevChart);

    // Noi lien duong du bao voi diem thuc te cuoi cung
    var lastRealIdx = -1;
    for (var i = 0; i < teuData.real.length; i++) if (teuData.real[i] !== null) lastRealIdx = i;
    if (lastRealIdx >= 0) teuData.pred[lastRealIdx] = teuData.real[lastRealIdx];

    new Chart(document.getElementById('teuChart'), {
        type: 'line',
        data: {
            labels: teuData.labels,
            datasets: [
                { label: 'Thực tế', data: teuData.real, borderColor: '#0d4f8b', backgroundColor: 'rgba(13,79,139,.08)', fill: true, tension: .35, pointRadius: 3 },
                { label: 'AI dự báo', data: teuData.pred, borderColor: '#ff7d2d', borderDash: [6, 5], backgroundColor: 'rgba(255,125,45,.06)', fill: true, tension: .35, pointRadius: 4, pointStyle: 'rectRot' }
            ]
        },
        options: { maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } }, scales: { y: { grid: { color: '#eef2f7' } }, x: { grid: { display: false } } } }
    });

    new Chart(document.getElementById('contChart'), {
        type: 'doughnut',
        data: {
            labels: contData.labels,
            datasets: [{ data: contData.data, backgroundColor: ['#1266b0', '#f59e0b', '#10b981', '#8b5cf6', '#64748b', '#ef4444'], borderWidth: 2 }]
        },
        options: { maintainAspectRatio: false, cutout: '62%', plugins: { legend: { position: 'bottom' } } }
    });

    new Chart(document.getElementById('revChart'), {
        type: 'bar',
        data: {
            labels: revData.labels,
            datasets: [{ label: 'Tỷ đồng', data: revData.data, backgroundColor: '#1173c4', borderRadius: 7, maxBarThickness: 40 }]
        },
        options: { maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { grid: { color: '#eef2f7' } }, x: { grid: { display: false } } } }
    });
</script>
}
