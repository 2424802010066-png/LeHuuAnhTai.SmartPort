<div class="ai-box mb-3">
    <span class="ai-tag"><i class="bi bi-signpost-split-fill"></i> SƠ ĐỒ QUY TRÌNH VẬN HÀNH · SOP</span>
    <div style="color:#c9dcef;font-size:.9rem;" class="mt-2">
        <strong>Phần A — 12 giai đoạn</strong> gate-to-gate theo quy trình ePort cảng Việt Nam ·
        <strong>Phần B — @dm.Length chức năng chi tiết</strong> đánh số liên tục (@soAI chức năng có AI).
        Bấm bất kỳ dòng nào để mở đúng chức năng.
    </div>
</div>

<h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-1-square me-1"></i>PHẦN A — LUỒNG CHÍNH 12 GIAI ĐOẠN</h6>
<div class="qt-luong mb-4">
    @foreach (var b in buocs)
    {
        <a class="qt-buoc card-sp" href="@b.Link">
            <span class="qt-so">@b.So</span>
            <span class="qt-noidung">
                <span class="qt-ten">@b.Ten @if (b.AI) { <span class="badge ms-1" style="background:#8b5cf6;font-size:.58rem;">AI</span> }</span>
                <span class="qt-vaitro">@b.VaiTro</span>
                <span class="qt-mota">@b.MoTa</span>
            </span>
            <i class="bi bi-arrow-right-circle qt-mui"></i>
        </a>
    }
</div>

<h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-2-square me-1"></i>PHẦN B — DANH MỤC ĐẦY ĐỦ @dm.Length CHỨC NĂNG (đánh số liên tục)</h6>
<div class="card-sp p-3">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr class="small text-muted"><th style="width:52px;">#</th><th>CHỨC NĂNG</th><th>VAI TRÒ</th><th style="width:60px;">AI</th><th style="width:50px;"></th></tr></thead>
            <tbody>
                @{
                    var stt = 0;
                    string nhomTruoc = null;
                }
                @foreach (var x in dm)
                {
                    if (x.GD != nhomTruoc)
                    {
                        nhomTruoc = x.GD;
                        <tr class="qt-nhom"><td colspan="5">@x.GD</td></tr>
                    }
                    stt++;
                    <tr class="qt-dong" onclick="location.href='@x.Link'">
                        <td><span class="qt-stt">@stt</span></td>
                        <td>@x.Ten</td>
                        <td class="small text-muted">@x.VT</td>
                        <td>@if (x.AI) { <span class="badge" style="background:#8b5cf6;font-size:.6rem;">AI</span> }</td>
                        <td><a href="@x.Link" class="btn btn-sm btn-outline-sp py-0"><i class="bi bi-box-arrow-up-right"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .qt-luong { position: relative; max-width: 880px; padding-left: 26px; }
    .qt-luong::before { content: ""; position: absolute; left: 47px; top: 30px; bottom: 30px; width: 3px; border-radius: 2px; background: linear-gradient(180deg, #1c5fa8, #22c55e); opacity: .35; }
    .qt-buoc { position: relative; display: flex; align-items: center; gap: 16px; padding: 12px 18px; margin-bottom: 10px; text-decoration: none; transition: transform .18s, box-shadow .18s; }
    .qt-buoc:hover { transform: translateX(6px); box-shadow: 0 10px 26px rgba(10, 47, 87, .18); }
    .qt-so { flex: 0 0 44px; width: 44px; height: 44px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 900; font-size: 1.15rem; color: #fff; background: linear-gradient(135deg, #0d4f8b, #1c8fd6); box-shadow: 0 4px 12px rgba(13, 79, 139, .35); z-index: 1; }
    .qt-noidung { display: flex; flex-direction: column; gap: 2px; }
    .qt-ten { font-weight: 800; color: #0a2f57; font-size: .98rem; }
    .qt-vaitro { font-size: .68rem; font-weight: 700; letter-spacing: 1.2px; color: #b45309; }
    .qt-mota { font-size: .83rem; color: #475569; line-height: 1.45; }
    .qt-mui { margin-left: auto; font-size: 1.3rem; color: #1c5fa8; opacity: .55; }
    .qt-buoc:hover .qt-mui { opacity: 1; }
    .qt-nhom td { background: rgba(13, 79, 139, .08); font-weight: 800; font-size: .74rem; letter-spacing: 1.4px; color: #0a2f57; padding: 7px 10px; }
    .qt-dong { cursor: pointer; }
    .qt-stt { display: inline-flex; width: 28px; height: 28px; border-radius: 50%; align-items: center; justify-content: center; font-weight: 800; font-size: .8rem; color: #0d4f8b; background: rgba(13, 79, 139, .1); }
    html[data-theme="dark"] .qt-ten { color: #cfe3fb; }
    html[data-theme="dark"] .qt-mota { color: #9fb6cc; }
    html[data-theme="dark"] .qt-nhom td { background: rgba(127, 208, 245, .1); color: #cfe3fb; }
    html[data-theme="dark"] .qt-stt { background: rgba(127, 208, 245, .12); color: #9fd8ff; }
</style>
