        new { GD = "DÒNG TIỀN", Ten = "Thẻ xe: thẻ tháng miễn lượt · thẻ trả trước trừ dần", VT = "Thu ngân", Link = Url.Action("TheXe", "PhiCong"), AI = false },
        new { GD = "DÒNG TIỀN", Ten = "Bảng giao ca thu phí cổng (in ký nhận tiền)", VT = "Thu ngân", Link = Url.Action("TongKet", "PhiCong"), AI = false },

