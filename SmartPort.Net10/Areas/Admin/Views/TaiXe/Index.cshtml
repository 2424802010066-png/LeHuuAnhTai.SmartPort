@model List<SmartPort.Models.TaiXe>
@{ ViewBag.Title = "Hồ sơ tài xế"; }

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <span class="fs-5 fw-bold" style="color:#0a2f57;"><i class="bi bi-person-vcard me-1"></i>Hồ sơ tài xế</span>
    <a class="btn btn-accent" href="@Url.Action("Quet")"><i class="bi bi-qr-code-scan me-1"></i>Quét CCCD đăng ký</a>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>@TempData["ThongBao"]</div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>@TempData["Loi"]</div>
}

<div class="row g-3 mb-3">
    <div class="col-4">
        <div class="stat-card"><div class="lbl">TỔNG HỒ SƠ</div><div class="num">@ViewBag.Tong</div><div class="small text-muted">tài xế đã đăng ký</div></div>
    </div>
    <div class="col-4">
        <div class="stat-card" style="border-left:4px solid #dc2626;">
            <div class="lbl">GPLX HẾT HẠN</div>
            <div class="num" style="color:@(ViewBag.SoHetHan > 0 ? "#dc2626" : "#15803d");">@ViewBag.SoHetHan</div>
            <div class="small text-muted">không được lái xe</div>
        </div>
    </div>
    <div class="col-4">
        <div class="stat-card" style="border-left:4px solid #b45309;">
            <div class="lbl">SẮP HẾT HẠN</div>
            <div class="num" style="color:#b45309;">@ViewBag.SoSapHetHan</div>
            <div class="small text-muted">trong 30 ngày tới</div>
        </div>
    </div>
</div>

<div class="card-sp p-3">
    <form method="get" class="d-flex gap-2 mb-3">
        <input class="form-control" name="q" value="@ViewBag.Q" placeholder="Tìm họ tên, số CCCD, biển số, số GPLX..." />
        <button class="btn btn-outline-sp" type="submit"><i class="bi bi-search"></i></button>
    </form>

    @if (Model.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-person-vcard" style="font-size:2.6rem;opacity:.35;"></i>
            <div class="mt-2">Chưa có hồ sơ tài xế nào.</div>
            <div class="small">Bấm <b>Quét CCCD đăng ký</b> để tạo hồ sơ đầu tiên.</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sp align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tài xế</th>
                        <th>CCCD</th>
                        <th>Bằng lái</th>
                        <th>Xe</th>
                        <th class="text-center">Lượt vào</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr class="@(t.GplxHetHan ? "table-danger" : "")">
                            <td>
                                <div class="fw-semibold">@(t.HoTen ?? "—")</div>
                                <div class="small text-muted">
                                    @(t.GioiTinh ?? "") @(t.Tuoi != null ? "· " + t.Tuoi + " tuổi" : "")
                                    @(!string.IsNullOrEmpty(t.DienThoai) ? "· " + t.DienThoai : "")
                                </div>
                                @if (!string.IsNullOrEmpty(t.DiaChi))
                                {
                                    <div class="small text-muted" style="max-width:320px;">@t.DiaChi</div>
                                }
                            </td>
                            <td class="small" style="font-family:Consolas,monospace;">@t.SoGiayTo</td>
                            <td class="small">
                                @if (string.IsNullOrEmpty(t.SoGPLX))
                                {
                                    <span class="text-muted">chưa có</span>
                                }
                                else
                                {
                                    <div>@t.SoGPLX @(string.IsNullOrEmpty(t.HangGPLX) ? "" : "· hạng " + t.HangGPLX)</div>
                                    @if (t.HanGPLX != null)
                                    {
                                        <div class="@(t.GplxHetHan ? "text-danger fw-bold" : t.GplxSapHetHan ? "text-warning fw-bold" : "text-muted")">
                                            @(t.GplxHetHan ? "⛔ hết hạn " : t.GplxSapHetHan ? "⚠ sắp hết hạn " : "hạn ")@t.HanGPLX.Value.ToString("dd/MM/yyyy")
                                        </div>
                                    }
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(t.BienSo))
                                {
                                    <a class="lk-xe" href="@Url.Action("HoSoXe", "Gate", new { bienSo = t.BienSo })">@t.BienSo</a>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="fw-bold">@t.SoLanVao</span>
                                @if (t.LanVaoCuoi != null)
                                {
                                    <div class="small text-muted">@t.LanVaoCuoi.Value.ToString("HH:mm dd/MM")</div>
                                }
                            </td>
                            <td class="text-end">
                                @using (Html.BeginForm("Xoa", "TaiXe", new { id = t.MaTX }, FormMethod.Post, null,
                                        new { @class = "d-inline", onsubmit = "return confirm('Xóa hồ sơ của " + (t.HoTen ?? t.SoGiayTo) + "?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="small text-muted mt-2">
            🔒 Hệ thống <b>không lưu ảnh CCCD</b> — chỉ giữ các trường cần cho việc ra vào cổng.
        </div>
    }
</div>
