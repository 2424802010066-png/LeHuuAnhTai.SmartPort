    <div class="admin-main">
        <div class="topbar">
            <button class="btn btn-light btn-side-toggle" type="button" onclick="document.getElementById('sideBar').classList.toggle('open')"><i class="bi bi-list"></i></button>
            <h1 class="page-title"><i class="bi bi-grid-1x2 me-2 text-primary"></i>@(ViewBag.Title ?? "Quản trị")</h1>

            @* TIM KIEM TOAN CUC — go so cont / bien so / so lenh / ten khach la ra het.
               Co day roi thi nhan vien khong con phai nho "cai nay nam o man hinh nao". *@
            <div class="tim-toan-cuc" id="timBoc">
                <i class="bi bi-search tim-icon"></i>
                <input id="oTim" class="tim-o" type="text" autocomplete="off" spellcheck="false"
                       placeholder="Tìm số container, biển số, số lệnh, khách hàng..."
                       aria-label="Tìm kiếm toàn hệ thống" />
                <kbd class="tim-kbd">Ctrl K</kbd>
                <div class="tim-ketqua" id="timKq"></div>
            </div>

            <div class="user-chip">
                <div class="dropdown">
                    <button class="theme-btn-a position-relative" id="bellBtn" type="button" data-bs-toggle="dropdown" title="Thông báo">
                        <i class="bi bi-bell-fill"></i>
                        <span id="bellBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none;font-size:.58rem;">0</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow" style="min-width:290px;">
                        <div class="dropdown-header fw-bold" style="color:#0a2f57;"><i class="bi bi-bell me-1"></i>Cần chú ý</div>
                        <div id="bellList"><div class="dropdown-item-text small text-muted">Đang kiểm tra...</div></div>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item small text-center" href="@Url.Action("Index", "System")"><i class="bi bi-heart-pulse me-1"></i>Vận hành hệ thống</a>
                    </div>
                </div>
                <button class="theme-btn-a" id="themeToggle" type="button" title="Chuyển chế độ tối/sáng"><i class="bi bi-moon-stars-fill"></i></button>
                <div class="text-end d-none d-sm-block">
                    <div class="fw-semibold" style="font-size:.9rem;">@hoTen</div>
                    <div class="text-muted" style="font-size:.74rem;">@(vaiTro == "Admin" ? "Quản trị viên" : "Nhân viên khai thác")</div>
                </div>
                <div class="avatar">@initial</div>
                <a class="btn btn-sm btn-outline-secondary" title="Đăng xuất" href="@Url.Action("Logout", "Account", new { area = "" })"><i class="bi bi-box-arrow-right"></i></a>
            </div>
        </div>

        <div class="content">
            @if (TempData["Ok"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show alert-float" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Ok"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Err"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show alert-float" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Err"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (Phien["MkMacDinh"] != null)
            {
                <div class="alert alert-warning alert-dismissible d-flex align-items-center gap-2 py-2 mb-3" role="alert">
                    <i class="bi bi-shield-exclamation fs-5"></i>
                    <div class="small">
                        <b>Bạn đang dùng mật khẩu mặc định.</b> Hệ thống vận hành thật yêu cầu mật khẩu riêng —
                        <a class="fw-bold" href="@Url.Action("Profile", "Account", new { area = "" })">đổi mật khẩu ngay</a>.
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        document.querySelectorAll('.alert-float').forEach(function (el) {
            setTimeout(function () { el.classList.remove('show'); setTimeout(function () { el.remove(); }, 400); }, 5000);
        });
        (function () {
            var btn = document.getElementById('themeToggle');
            if (!btn) return;
            function icon() {
                var dark = document.documentElement.getAttribute('data-theme') === 'dark';
                btn.innerHTML = dark ? '<i class="bi bi-sun-fill"></i>' : '<i class="bi bi-moon-stars-fill"></i>';
            }
            icon();
            btn.addEventListener('click', function () {
                var dark = document.documentElement.getAttribute('data-theme') === 'dark';
                document.documentElement.setAttribute('data-theme', dark ? 'light' : 'dark');
                try { localStorage.setItem('sp-theme', dark ? 'light' : 'dark'); } catch (e) { }
                icon();
            });
        })();
    </script>
    <script>window.APP_ROOT = '@Url.Content("~/")';</script>
    <script src="@Url.Content("~/Scripts/effects.js")?v=1"></script>
    <script>
        /* Chuong thong bao: poll 30s — su co an ninh / don cho duyet /
           tau sap cap / lien he moi. Chi doi badge khi so thay doi. */
        (function () {
            var badge = document.getElementById('bellBadge'), list = document.getElementById('bellList');
            if (!badge || !list) return;
            function nap() {
                fetch('@Url.Action("ThongBao", "System")', { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        var tong = (d.suCoMoi || 0) + (d.donChoDuyet || 0) + (d.tauSapCap || 0) + (d.lienHeMoi || 0);
                        badge.textContent = tong > 99 ? '99+' : tong;
                        badge.style.display = tong > 0 ? '' : 'none';
                        if (!d.items || !d.items.length) {
                            list.innerHTML = '<div class="dropdown-item-text small text-muted">✅ Không có gì cần chú ý.</div>';
                        } else {
                            list.innerHTML = d.items.map(function (it) {
                                return '<a class="dropdown-item small d-flex align-items-center gap-2" href="' + it.url + '">' +
                                    '<span class="badge bg-' + it.mau + '" style="width:26px;"><i class="bi bi-' + it.icon + '"></i></span>' +
                                    '<span>' + it.text + '</span></a>';
                            }).join('');
                        }
                    })
                    .catch(function () { });
            }
            nap();
            setInterval(nap, 30000);
        })();
    </script>
    <script>
        /* ==========================================================
           TIM KIEM TOAN CUC
           - Go >=2 ky tu, cho 220ms roi moi goi (khong ban request theo tung phim)
           - Dieu huong bang mui ten + Enter, Esc de dong -> khong can roi ban phim
           - Ctrl/Cmd + K o bat ky trang nao cung nhay vao o tim
           ========================================================== */
        (function () {
            var o = document.getElementById('oTim'), kq = document.getElementById('timKq'), boc = document.getElementById('timBoc');
            if (!o || !kq) return;
            var hen = null, dsHien = [], chon = -1, lanCuoi = '';

            function dong() { kq.classList.remove('hien'); chon = -1; }
            function ve(items) {
                dsHien = items || [];
                chon = -1;
                if (!dsHien.length) {
                    kq.innerHTML = '<div class="tim-trong">Không tìm thấy “' + thoat(o.value) + '”.<br>' +
                        '<span style="font-size:.72rem;">Thử số container (MSCU1234567), biển số xe, số lệnh hoặc tên khách hàng.</span></div>';
                } else {
                    kq.innerHTML = dsHien.map(function (it, i) {
                        return '<a class="tim-hang" data-i="' + i + '" href="' + thoat(it.url) + '">' +
                            '<span class="tim-cham" style="background:' + thoat(it.mau) + '"><i class="bi ' + thoat(it.icon) + '"></i></span>' +
                            '<span><span class="tim-td">' + thoat(it.tieuDe) + '</span>' +
                            '<span class="tim-mt d-block">' + thoat(it.moTa) + '</span></span>' +
                            '<span class="tim-nhom">' + thoat(it.nhom) + '</span></a>';
                    }).join('');
                }
                kq.classList.add('hien');
            }
            function thoat(s) {
                return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                });
            }
            function tim() {
                var q = o.value.trim();
                if (q.length < 2) { dong(); return; }
                if (q === lanCuoi && kq.classList.contains('hien')) return;
                lanCuoi = q;
                fetch('@Url.Action("TimKiem", "System")?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (d) { if (o.value.trim() === q) ve(d.items); })
                    .catch(function () { dong(); });
            }
            o.addEventListener('input', function () { clearTimeout(hen); hen = setTimeout(tim, 220); });
            o.addEventListener('focus', function () { if (dsHien.length && o.value.trim().length >= 2) kq.classList.add('hien'); });
            o.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') { dong(); o.blur(); return; }
                if (!dsHien.length || !kq.classList.contains('hien')) return;
                if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                    e.preventDefault();
                    chon += (e.key === 'ArrowDown' ? 1 : -1);
                    if (chon < 0) chon = dsHien.length - 1;
                    if (chon >= dsHien.length) chon = 0;
                    Array.prototype.forEach.call(kq.querySelectorAll('.tim-hang'), function (a, i) {
                        a.classList.toggle('chon', i === chon);
                        if (i === chon) a.scrollIntoView({ block: 'nearest' });
                    });
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    var i = chon >= 0 ? chon : 0;
                    if (dsHien[i] && dsHien[i].url) location.href = dsHien[i].url;
                }
            });
            document.addEventListener('click', function (e) { if (boc && !boc.contains(e.target)) dong(); });
            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) { e.preventDefault(); o.focus(); o.select(); }
            });
        })();
    </script>

    @*  ===== TRỢ LÝ NGHIỆP VỤ =====
        Khung chat cho nhân viên NHỜ VIỆC, khác PortBot ở trang công khai
        (bên đó chỉ trả lời câu hỏi của khách vãng lai).
        Token chống giả mạo nằm ở đây vì việc dùng tiền phải POST có token.  *@
    @Html.AntiForgeryToken()

    <button type="button" class="tl-fab" id="tlFab" data-goc="@Url.Content("~").TrimEnd('/')"
            title="Trợ lý nghiệp vụ — nhờ việc gì cũng được">
        <i class="bi bi-stars"></i><span class="tl-cham"></span>
    </button>

    <div class="tl-panel" id="tlPanel">
        <div class="tl-dau">
            <div class="tl-avt"><i class="bi bi-stars"></i></div>
            <div>
                <div class="tl-ten">Trợ lý nghiệp vụ</div>
                <div class="tl-phu">Nhờ việc bằng tiếng Việt</div>
            </div>
            <button type="button" id="tlClose" title="Đóng"><i class="bi bi-x-lg"></i></button>
        </div>

        <div class="tl-body" id="tlBody">
            <div class="tl-bong tl-bot">
                Chào <b>@(ViewBag.HoTen ?? "bạn")</b>, cần tôi làm gì?
                <br>Tôi tra cứu được, tính được phí, và <b>làm được việc</b> —
                lập phiếu thu, sinh bản tin hãng tàu, chạy agent rà soát.
                <div class="tl-goiys">
                    <button type="button" class="tl-goiy">công nợ hôm nay</button>
                    <button type="button" class="tl-goiy">cont nào tồn quá 30 ngày</button>
                    <button type="button" class="tl-goiy">xe qua cổng hôm nay</button>
                    <button type="button" class="tl-goiy">tồn bãi</button>
                </div>
            </div>
            <div class="tl-typing" id="tlTyping"><span></span><span></span><span></span></div>
        </div>

        <div class="tl-chan">
            <input type="text" id="tlInput" autocomplete="off"
                   placeholder="vd: lập phiếu cho MSCU2277456" />
            <button type="button" id="tlSend" title="Gửi"><i class="bi bi-send-fill"></i></button>
        </div>
    </div>

    <script src="@Url.Content("~/Scripts/troly.js")?v=1"></script>

    @RenderSection("scripts", required: false)
    <script>if ('serviceWorker' in navigator) { navigator.serviceWorker.register('/sw.js').catch(function () { }); }</script>
</body>
</html>
