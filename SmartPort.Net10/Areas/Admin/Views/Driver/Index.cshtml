@{
    ViewBag.Title = "Giám sát tài xế & khoang hàng";
    var suCo = ViewBag.SuCo7Ngay as List<SmartPort.Models.SuCoAnNinh>;
}

<div class="ai-box mb-3">
    <span class="ai-tag"><i class="bi bi-truck-front-fill"></i> IN-CABIN & CARGO AI · EDGE MONITORING</span>
    <div class="row align-items-center mt-2">
        <div class="col-lg-9">
            <h5 class="fw-bold mb-1">Camera AI 2 chiều trên xe: giám sát TÀI XẾ và KHOANG HÀNG</h5>
            <div style="color:#c9dcef;font-size:.9rem;">
                <strong>Camera 1 (DMS)</strong> — MediaPipe FaceLandmarker <strong>478 điểm mốc khuôn mặt</strong>
                phát hiện <strong>ngủ gật · ngáp · quay đầu mọi hướng &gt;5s · dùng điện thoại</strong>
                + <strong>mạng nơ-ron tự mã hóa TỰ HỌC</strong> tư thế lái của từng tài xế để bắt
                <strong>trạng thái bất thường chưa từng thấy</strong> (học online, tinh chỉnh bằng phản hồi ✔/✖)
                → còi cảnh báo tại chỗ + báo trung tâm điều hành.
                <strong>Camera 2 (Cargo)</strong> — phát hiện <strong>hàng nghiêng/đổ</strong> và
                <strong>người lạ xâm nhập</strong> khoang hàng.
            </div>
        </div>
        <div class="col-lg-3 text-lg-end mt-2 mt-lg-0">
            <span id="dvEngine" class="badge-st st-info"><i class="bi bi-hourglass-split me-1"></i>Đang khởi động...</span>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#b91c1c,#f87171);">
            <div class="ps-num">@ViewBag.SoNguGat</div>
            <div class="ps-lbl">Cảnh báo ngủ gật (7 ngày)</div>
            <i class="bi bi-emoji-dizzy"></i>
        </div>
    </div>
    <div class="col-md-4 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#b45309,#fbbf24);">
            <div class="ps-num">@ViewBag.SoDienThoai</div>
            <div class="ps-lbl">Dùng điện thoại (7 ngày)</div>
            <i class="bi bi-phone"></i>
        </div>
    </div>
    <div class="col-md-4 col-12">
        <div class="pay-stat" style="background:linear-gradient(120deg,#0a2f57,#1c5fa8);">
            <div class="ps-num">@ViewBag.SoHang</div>
            <div class="ps-lbl">Sự cố khoang hàng (7 ngày)</div>
            <i class="bi bi-box-seam"></i>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- ============ CAMERA 1: DMS ============ -->
    <div class="col-lg-6">
        <div class="card-sp p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0" style="color:#0a2f57;">
                    <i class="bi bi-person-video3 me-1"></i>CAMERA 1 — Giám sát tài xế (DMS)
                </h6>
                <span class="badge bg-danger">● LIVE</span>
            </div>
            <div id="dmsStatus" class="small mb-2 text-muted">Đang tải model khuôn mặt...</div>

            <div style="position:relative;border-radius:12px;overflow:hidden;background:#0b1520;min-height:250px;">
                <video id="dmsVideo" playsinline muted style="width:100%;display:none;"></video>
                <canvas id="dmsCanvas" style="width:100%;display:block;"></canvas>
                <!-- Den canh bao lon giua man hinh -->
                <div id="dmsAlert" style="display:none;position:absolute;inset:0;align-items:center;justify-content:center;background:rgba(185,28,28,.32);backdrop-filter:blur(1px);">
                    <div style="background:#b91c1c;color:#fff;font-weight:900;font-size:1.25rem;padding:14px 26px;border-radius:14px;box-shadow:0 12px 40px rgba(0,0,0,.5);animation:dvBlink .6s step-end infinite;">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i><span id="dmsAlertText">CẢNH BÁO</span>
                    </div>
                </div>
            </div>

            <!-- HUD chi so realtime -->
            <div class="row g-2 mt-2 text-center">
                <div class="col-3"><div class="dv-hud"><div class="dv-hud-num" id="hudMat">—</div><div class="dv-hud-lbl">Mắt mở</div></div></div>
                <div class="col-3"><div class="dv-hud"><div class="dv-hud-num" id="hudNgap">0</div><div class="dv-hud-lbl">Ngáp/phút</div></div></div>
                <div class="col-3"><div class="dv-hud"><div class="dv-hud-num" id="hudQuay">—</div><div class="dv-hud-lbl">Quay đầu (5s = báo)</div></div></div>
                <div class="col-3"><div class="dv-hud"><div class="dv-hud-num" id="hudPhone">—</div><div class="dv-hud-lbl">Điện thoại</div></div></div>
            </div>

            <!-- AI tu hoc trang thai bat thuong (autoencoder online) -->
            <div class="dv-ano mt-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                    <div class="small"><b>🧠 AI tự học</b> <span class="text-muted">(mạng tự mã hóa · online)</span> — <span id="anoTT" class="text-muted">chờ bật camera...</span></div>
                    <div id="anoFb" style="display:none;">
                        <button id="btnAnoDung" type="button" class="btn btn-sm btn-outline-success py-0 me-1">✔ Cảnh báo đúng</button>
                        <button id="btnAnoNham" type="button" class="btn btn-sm btn-outline-danger py-0">✖ Báo nhầm — dạy lại AI</button>
                    </div>
                </div>
                <div style="height:7px;border-radius:4px;background:rgba(13,79,139,.12);overflow:hidden;margin-top:5px;">
                    <div id="anoBar" style="height:100%;width:0%;background:#22c55e;transition:width .25s;"></div>
                </div>
            </div>

            <div class="row g-2 mt-1">
                <div class="col-md-5"><button id="btnDmsCam" class="btn btn-navy w-100" disabled><i class="bi bi-camera-video me-1"></i>Bật camera tài xế</button></div>
                <div class="col-md-4"><button class="btn btn-outline-primary w-100 dv-sample-face" disabled data-src="/Content/img/dms-demo-face.jpg?v=1"><i class="bi bi-person-badge me-1"></i>Ảnh mẫu tài xế</button></div>
                <div class="col-md-3 d-flex align-items-center"><div id="dmsKq" class="small">Chưa chạy.</div></div>
            </div>
            <div class="small text-muted mt-2">
                💡 Thử nhanh: bật camera, giữ tư thế lái bình thường <b>~20 giây</b> cho AI tự học nền. Sau đó thử:
                <b>nhắm mắt ~2 giây</b> (ngủ gật), <b>ngáp to</b>,
                <b>quay đầu trái/phải/lên/xuống hoặc nghiêng đầu quá 5 giây</b> (mất tập trung — có đồng hồ đếm),
                <b>giơ điện thoại cạnh mặt</b>, hoặc làm một <b>tư thế "lạ"</b> bất kỳ — mạng tự mã hóa sẽ tự phát hiện
                dù chưa từng được lập trình cho tư thế đó. Bấm <b>✔/✖</b> để dạy AI sau mỗi cảnh báo.
            </div>
        </div>
    </div>

    <!-- ============ CAMERA 2: CARGO ============ -->
    <div class="col-lg-6">
        <div class="card-sp p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0" style="color:#0a2f57;">
                    <i class="bi bi-box-seam me-1"></i>CAMERA 2 — Khoang hàng (Cargo Vision)
                </h6>
                <div class="form-check form-switch small mb-0">
                    <input class="form-check-input" type="checkbox" id="swXeDung" checked />
                    <label class="form-check-label" for="swXeDung" title="Khi xe dừng, phát hiện người trong khoang = xâm nhập">Xe đang dừng</label>
                </div>
            </div>
            <div id="cgStatus" class="small mb-2 text-muted">Đang tải YOLO26...</div>

            <div style="position:relative;border-radius:12px;overflow:hidden;background:#0b1520;min-height:250px;">
                <video id="cgVideo" playsinline muted style="width:100%;display:none;"></video>
                <canvas id="cgCanvas" style="width:100%;display:block;"></canvas>
            </div>

            <div class="row g-2 mt-2">
                <div class="col-md-4"><button class="btn btn-outline-primary w-100 cg-sample" disabled data-src="/Content/img/cargo-ngay.png?v=2"><i class="bi bi-box me-1"></i>Hàng ngay ngắn</button></div>
                <div class="col-md-4"><button class="btn btn-outline-warning w-100 cg-sample" disabled data-src="/Content/img/cargo-nghieng.png?v=2"><i class="bi bi-box-arrow-down-right me-1"></i>Hàng bị nghiêng</button></div>
                <div class="col-md-4"><button id="btnCgCam" class="btn btn-navy w-100" disabled><i class="bi bi-camera-video me-1"></i>Camera khoang</button></div>
            </div>
            <div class="row g-2 mt-1">
                <div class="col-md-6"><button id="btnCgScan" class="btn btn-accent w-100" disabled><i class="bi bi-search me-1"></i>Phân tích khoang hàng</button></div>
                <div class="col-md-6 d-flex align-items-center"><div id="cgKq" class="small">Chưa phân tích.</div></div>
            </div>
            <div class="small text-muted mt-2">
                💡 Thử nhanh: bấm <b>"Hàng bị nghiêng"</b> để xem AI đo góc nghiêng &gt; 25° và hú còi;
                hoặc bật camera khoang và <b>nghiêng một hộp hàng</b> / <b>đưa người vào khung</b> (chế độ Xe đang dừng).
            </div>
        </div>
    </div>

    <!-- ============ NHAT KY SU CO ============ -->
    <div class="col-12">
        <div class="card-sp p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0" style="color:#0a2f57;"><i class="bi bi-journal-text me-1"></i>Sự cố tài xế / khoang hàng — 7 ngày</h6>
                <a class="btn btn-sm btn-outline-sp" href="@Url.Action("Index", "Security")"><i class="bi bi-building-lock me-1"></i>Phòng an ninh</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead><tr class="small text-muted"><th>THỜI GIAN</th><th>LOẠI</th><th>MỨC ĐỘ</th><th>VỊ TRÍ/XE</th><th>MÔ TẢ</th><th>TRẠNG THÁI</th></tr></thead>
                    <tbody id="dvSuCoBody">
                        @if (suCo == null || suCo.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">Chưa ghi nhận sự cố nào — đội xe đang vận hành an toàn 🎉</td></tr>
                        }
                        else
                        {
                            foreach (var s in suCo)
                            {
                                <tr>
                                    <td class="small">@s.ThoiGian.ToString("HH:mm dd/MM")</td>
                                    <td class="small fw-semibold">@s.TenLoai</td>
                                    <td><span class="badge @(s.MucDo == "Nguy hiểm" ? "bg-danger" : "bg-warning text-dark")">@s.MucDo</span></td>
                                    <td class="small">@s.ViTri</td>
                                    <td class="small text-muted">@s.MoTa</td>
                                    <td><span class="badge @(s.TrangThai == "Mới" ? "bg-danger" : "bg-success")">@s.TrangThai</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<canvas id="dvWork" style="display:none;"></canvas>

<style>
    .dv-hud { background: rgba(13,79,139,.07); border-radius: 10px; padding: 7px 4px; }
    .dv-hud-num { font-weight: 900; font-size: 1.02rem; color: #0a2f57; line-height: 1.15; }
    .dv-hud-lbl { font-size: .68rem; color: #64748b; }
    html[data-theme="dark"] .dv-hud { background: rgba(127,208,245,.08); }
    html[data-theme="dark"] .dv-hud-num { color: #cfe3fb; }
    html[data-theme="dark"] .dv-hud-lbl { color: #9fb6cc; }
    @@keyframes dvBlink { 50% { opacity: .35; } }
</style>

@section scripts {
<script src="@Url.Content("~/Scripts/driver.js")?v=6"></script>
}
