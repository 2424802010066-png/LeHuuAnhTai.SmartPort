@model List<SmartPort.Models.Tau>
@{
    ViewBag.Title = "Quản lý tàu biển";
}
<div class="card-sp">
    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="q" value="@ViewBag.Q" class="form-control form-control-sm" style="width:240px;" placeholder="Tìm tên tàu, số IMO..." />
            <button class="btn btn-sm btn-navy" type="submit"><i class="bi bi-search"></i></button>
        </form>
        <a class="btn btn-sm btn-accent" href="@Url.Action("Form")"><i class="bi bi-plus-lg me-1"></i>Thêm tàu</a>
    </div>
    <div class="table-responsive">
        <table class="table table-sp">
            <thead>
                <tr><th>Tên tàu</th><th>Số IMO</th><th>Hãng tàu</th><th>Loại</th><th>Quốc tịch</th><th class="text-end">LOA (m)</th><th class="text-end">Mớn nước (m)</th><th class="text-end">TEU</th><th class="text-end">Thao tác</th></tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">Chưa có tàu nào.</td></tr>
                }
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="fw-semibold">@t.TenTau</td>
                        <td>@t.SoIMO</td>
                        <td>@(t.HangTau != null ? t.HangTau.TenHangTau : "—")</td>
                        <td>@t.LoaiTau</td>
                        <td>@t.QuocTich</td>
                        <td class="text-end">@Ui.Num(t.ChieuDai)</td>
                        <td class="text-end">@Ui.Num(t.MonNuoc)</td>
                        <td class="text-end">@Ui.Num(t.SucChuaTEU)</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Form", new { id = t.MaTau })"><i class="bi bi-pencil"></i></a>
                            @using (Html.BeginForm("Delete", "Vessels", new { id = t.MaTau }, FormMethod.Post, null, new { @class = "d-inline", onsubmit = "return confirm('Xóa tàu " + t.TenTau + "?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
