@using SmartPort.Models
@{
    ViewBag.Title = "Tồn rỗng theo hãng tàu";
    var nhom = ViewBag.Nhom as List<object>;
    var hangTaus = ViewBag.HangTaus as List<HangTau>;
}

<div class="ai-box mb-3" style="background:linear-gradient(120deg,#134e4a,#0f766e);">
    <span class="ai-tag"><i class="bi bi-box2-fill"></i> TỒN RỖNG THEO HÃNG TÀU · DEPOT</span>
    <div style="color:#ccfbf1;font-size:.9rem;" class="mt-2">
        Depot <strong>không sở hữu vỏ container</strong> — chỉ giữ hộ cho hãng tàu. Vì vậy tồn bãi
        phải tách theo <strong>từng hãng</strong> để báo cáo và để cấp rỗng đúng hãng.
        Đây là màn hình mà cảng tổng hợp không cần nhưng depot rỗng dùng mỗi ngày.
    </div>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>@TempData["ThongBao"]</div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger py-2"><i class="bi bi-exclamation-triangle me-1"></i>@TempData["Loi"]</div>
}

<div class="row g-3 mb-3">
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#134e4a,#14b8a6);">
            <div class="ps-num">@ViewBag.TongCont</div>
            <div class="ps-lbl">Container đang trong bãi</div>
            <i class="bi bi-box-seam"></i>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#0a2f57,#1c5fa8);">
            <div class="ps-num">@ViewBag.SoHang</div>
            <div class="ps-lbl">Hãng tàu đang gửi vỏ</div>
            <i class="bi bi-globe2"></i>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#b45309,#fbbf24);">
            <div class="ps-num">@ViewBag.ChuaGan</div>
            <div class="ps-lbl">Chưa gán hãng tàu — cần xử lý</div>
            <i class="bi bi-question-circle"></i>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#7f1d1d,#dc2626);">
            <div class="ps-num">@ViewBag.ChoDuyetEOR</div>
            <div class="ps-lbl">Phiếu EOR chờ hãng tàu duyệt</div>
            <i class="bi bi-tools"></i>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card-sp p-3">
            <h6 class="fw-bold mb-3" style="color:#134e4a;"><i class="bi bi-list-columns me-1"></i>Tồn bãi phân theo hãng tàu</h6>
            @if (nhom == null || nhom.Count == 0)
            {
                <div class="text-center text-muted py-4">Không có container nào trong bãi.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr class="small text-muted">
                                <th>HÃNG TÀU</th><th class="text-center">TỔNG</th>
                                <th>PHÂN THEO LOẠI</th><th class="text-center">VỎ TỐT</th><th class="text-center">CẦN SỬA</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (dynamic n in nhom)
                            {
                                var chuaGan = n.MaHangTau == null;
                                <tr>
                                    <td class="fw-semibold @(chuaGan ? "text-warning" : "")" style="@(chuaGan ? "" : "color:#0a2f57;")">
                                        @(chuaGan ? "⚠ " : "🚢 ")@n.TenHang
                                    </td>
                                    <td class="text-center"><span class="badge bg-dark fs-6">@n.Tong</span></td>
                                    <td>
                                        @foreach (object[] l in n.TheoLoai)
                                        {
                                            <span class="badge bg-light text-dark border me-1">@l[0]: <b>@l[1]</b></span>
                                        }
                                    </td>
                                    <td class="text-center text-success fw-bold">@n.Tot</td>
                                    <td class="text-center fw-bold @(n.Hong > 0 ? "text-danger" : "text-muted")">@n.Hong</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="small text-muted">
                    💡 Con số này là thứ hãng tàu hỏi depot mỗi ngày. Có màn hình này thì trả lời trong 5 giây
                    thay vì mở Excel đếm tay.
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card-sp p-3">
            <h6 class="fw-bold mb-2" style="color:#134e4a;"><i class="bi bi-link-45deg me-1"></i>Gán hãng tàu cho container</h6>
            <div class="small text-muted mb-3">
                Việc đầu tiên khi triển khai cho một depot: gán vỏ đang nằm bãi về đúng hãng.
                Dán danh sách số container (cách nhau bởi dấu phẩy hoặc xuống dòng).
            </div>
            @using (Html.BeginForm("GanHangTau", "Depot", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <label class="form-label small fw-semibold">HÃNG TÀU</label>
                <select class="form-select mb-2" name="maHangTau" required>
                    @if (hangTaus != null)
                    {
                        foreach (var h in hangTaus)
                        {
                            <option value="@h.MaHangTau">@h.TenHangTau</option>
                        }
                    }
                </select>
                <label class="form-label small fw-semibold">SỐ CONTAINER</label>
                <textarea class="form-control mb-2" name="soConts" rows="5" placeholder="MSCU2299876&#10;TCLU1234567&#10;..."></textarea>
                <button class="btn btn-accent w-100" type="submit"><i class="bi bi-save me-1"></i>Gán hãng tàu</button>
            }
            <hr />
            <a class="btn btn-outline-sp w-100" href="@Url.Action("Eor", "Depot")">
                <i class="bi bi-tools me-1"></i>Phiếu sửa chữa vỏ (EOR)
            </a>
        </div>
    </div>
</div>
