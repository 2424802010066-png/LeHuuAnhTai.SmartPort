@model List<SmartPort.Models.DemXeCong>
@{
    ViewBag.Title = "Đối soát cổng — chống gian lận";
    var congs = (ViewBag.Congs as List<string>) ?? new List<string>();
}

<div class="ai-box mb-3" style="background:linear-gradient(120deg,#450a0a,#b91c1c);">
    <span class="ai-tag"><i class="bi bi-shield-exclamation"></i> ĐỐI SOÁT CỔNG · CHỐNG GIAN LẬN</span>
    <div style="color:#fee2e2;font-size:.9rem;" class="mt-2">
        Phần mềm <strong>chỉ biết những gì được nhập vào nó</strong>. Bảo vệ cho xe qua mà không bấm ghi nhận
        rồi thu tiền bỏ túi thì hệ thống không tự phát hiện được.
        Cách duy nhất: một <strong>nguồn đếm độc lập</strong> (cảm biến vòng từ dưới mặt đường, hoặc đếm tay theo ca)
        rồi đối chiếu cuối ca. Con số “hệ thống ghi nhận” dưới đây <strong>do máy tự đếm, không ai gõ được</strong>.
    </div>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>@TempData["ThongBao"]</div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger py-2"><i class="bi bi-exclamation-triangle me-1"></i>@TempData["Loi"]</div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="lbl">KỲ ĐÃ ĐỐI SOÁT</div>
            <div class="num">@ViewBag.SoKy</div>
            <div class="small text-muted">@ViewBag.SoKhop kỳ khớp hoàn toàn</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="border-left:4px solid #dc2626;">
            <div class="lbl">KỲ NGHI VẤN</div>
            <div class="num" style="color:@(ViewBag.SoNghiVan > 0 ? "#dc2626" : "#15803d");">@ViewBag.SoNghiVan</div>
            <div class="small text-muted">lệch trên 5 lượt</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="border-left:4px solid #b45309;">
            <div class="lbl">TIỀN NGHI THẤT THOÁT</div>
            <div class="num" style="color:#b45309;">@ViewBag.TienNghiThatThoat.ToString("N0") <span style="font-size:.9rem;">đ</span></div>
            <div class="small text-muted">@ViewBag.TongLech lượt × @ViewBag.GiaTB.ToString("N0")đ (giá TB)</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="lbl">MỞ BARIE TAY</div>
            <div class="num" style="color:@(ViewBag.TongMoTay > 0 ? "#b45309" : "#15803d");">@ViewBag.TongMoTay</div>
            <div class="small text-muted">@ViewBag.ChuaGiaiTrinh kỳ lệch chưa giải trình</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card-sp p-3">
            <h6 class="fw-bold mb-2" style="color:#b91c1c;"><i class="bi bi-plus-square me-1"></i>Ghi đối soát cuối ca</h6>
            @using (Html.BeginForm("Luu", "DoiSoatCong", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="row g-2 mb-2">
                    <div class="col-7">
                        <label class="form-label small fw-semibold">CỔNG</label>
                        <select class="form-select" name="cong" id="cong">
                            <option value="*">Tất cả cổng</option>
                            @foreach (var c in congs)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    </div>
                    <div class="col-5">
                        <label class="form-label small fw-semibold">CA</label>
                        <select class="form-select" name="ca">
                            <option value="Ca 1">Ca 1</option>
                            <option value="Ca 2">Ca 2</option>
                            <option value="Ca 3">Ca 3</option>
                            <option value="Cả ngày">Cả ngày</option>
                        </select>
                    </div>
                </div>

                <label class="form-label small fw-semibold">TỪ LÚC</label>
                <input class="form-control mb-2" type="datetime-local" name="tuLuc" id="tuLuc"
                       value="@(((DateTime)ViewBag.MacDinhTu).ToString("yyyy-MM-ddTHH:mm"))" required />

                <label class="form-label small fw-semibold">ĐẾN LÚC</label>
                <input class="form-control mb-2" type="datetime-local" name="denLuc" id="denLuc"
                       value="@(((DateTime)ViewBag.MacDinhDen).ToString("yyyy-MM-ddTHH:mm"))" required />

                <div class="alert alert-light border py-2 mb-2">
                    <div class="small text-muted">Hệ thống ghi nhận trong khoảng này:</div>
                    <div class="fs-4 fw-bold" id="soHT" style="color:#0a2f57;">—</div>
                    <div class="small text-muted">Con số này máy tự đếm, không sửa được.</div>
                </div>

                <label class="form-label small fw-semibold">SỐ ĐẾM THỰC TẾ</label>
                <input class="form-control mb-1" type="number" name="soDemThucTe" min="0" required
                       placeholder="Từ cảm biến hoặc đếm tay" style="font-size:1.2rem;font-weight:700;" />
                <div class="small text-muted mb-2" id="goiYLech"></div>

                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">MỞ BARIE TAY</label>
                        <input class="form-control" type="number" name="moBarieTay" min="0" value="0" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">NGUỒN ĐẾM</label>
                        <select class="form-select" name="nguon">
                            <option value="ThuCong">Đếm tay</option>
                            <option value="CamBien">Cảm biến</option>
                        </select>
                    </div>
                </div>

                <label class="form-label small fw-semibold">GHI CHÚ</label>
                <input class="form-control mb-3" name="ghiChu" placeholder="VD: mưa lớn, xe cứu hỏa vào diễn tập..." />

                <button class="btn btn-accent w-100" type="submit"><i class="bi bi-check2-square me-1"></i>Ghi đối soát</button>
            }
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card-sp p-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <h6 class="fw-bold mb-0" style="color:#0a2f57;"><i class="bi bi-clock-history me-1"></i>Lịch sử đối soát</h6>
                <div class="d-flex gap-1">
                    @foreach (var n in new[] { 7, 30, 90 })
                    {
                        <a class="btn btn-sm @(ViewBag.SoNgay == n ? "btn-accent" : "btn-outline-sp") py-0"
                           href="@Url.Action("Index", new { soNgay = n })">@n ngày</a>
                    }
                </div>
            </div>

            @if (Model.Count == 0)
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-shield-check" style="font-size:2.6rem;opacity:.35;"></i>
                    <div class="mt-2">Chưa có bản đối soát nào.</div>
                    <div class="small">Cuối mỗi ca, bảo vệ/thu ngân ghi số đếm thực tế ở khung bên trái.</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sp align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Kỳ</th>
                                <th class="text-center">Đếm</th>
                                <th class="text-center">Hệ thống</th>
                                <th class="text-center">Lệch</th>
                                <th>Đánh giá</th>
                                <th class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@(d.Cong == "*" ? "Tất cả cổng" : "Cổng " + d.Cong) · @d.Ca</div>
                                        <div class="small text-muted">
                                            @d.TuLuc.ToString("HH:mm dd/MM") → @d.DenLuc.ToString("HH:mm dd/MM/yyyy")
                                        </div>
                                        <div class="small text-muted">@d.NguoiNhap · @(d.Nguon == "CamBien" ? "cảm biến" : "đếm tay")</div>
                                    </td>
                                    <td class="text-center fw-bold">@d.SoDemThucTe</td>
                                    <td class="text-center">@d.SoHeThong</td>
                                    <td class="text-center fw-bold" style="color:@d.MauMucDo;">
                                        @(d.ChenhLech > 0 ? "+" : "")@d.ChenhLech
                                    </td>
                                    <td>
                                        <span class="badge" style="background:@d.MauMucDo;">@d.MucDo</span>
                                        @if (d.MoBarieTay > 0)
                                        {
                                            <div><span class="badge bg-warning text-dark" style="font-size:.56rem;">mở tay @d.MoBarieTay lần</span></div>
                                        }
                                        @if (!string.IsNullOrEmpty(d.GhiChu))
                                        {
                                            <div class="small text-muted">@d.GhiChu</div>
                                        }
                                        @if (d.DaGiaiTrinh)
                                        {
                                            <div class="small" style="color:#15803d;"><i class="bi bi-check2 me-1"></i>@d.GiaiTrinh</div>
                                        }
                                        else if (Math.Abs(d.ChenhLech) > 2)
                                        {
                                            <div class="small text-danger"><i class="bi bi-exclamation-circle me-1"></i>Chưa giải trình</div>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        @if (Math.Abs(d.ChenhLech) > 2 && !d.DaGiaiTrinh)
                                        {
                                            using (Html.BeginForm("GiaiTrinh", "DoiSoatCong", new { id = d.MaDem }, FormMethod.Post, null, new { @class = "d-inline-flex gap-1" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input class="form-control form-control-sm" name="noiDung" placeholder="Lý do lệch..." style="width:150px;" required />
                                                <button class="btn btn-sm btn-outline-success" type="submit" title="Ghi giải trình"><i class="bi bi-pencil-square"></i></button>
                                            }
                                        }
                                        @using (Html.BeginForm("Xoa", "DoiSoatCong", new { id = d.MaDem }, FormMethod.Post, null,
                                                new { @class = "d-inline", onsubmit = "return confirm('Xóa bản đối soát này?');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="small text-muted mt-2">
                    Lệch <b>1–2 lượt</b> thường là sai số cảm biến hoặc xe lùi lại — chưa kết luận được.
                    Lệch <b>trên 5 lượt</b> hệ thống tự mở một sự cố an ninh để có người phải xử lý, không để trôi.
                </div>
            }
        </div>
    </div>
</div>

<script>
    /* Hien so he thong dem duoc NGAY khi doi khoang thoi gian — de nguoi nhap
       thay con so doi chung TRUOC khi go so dem thuc te. */
    (function () {
        var cong = document.getElementById('cong'), tu = document.getElementById('tuLuc'),
            den = document.getElementById('denLuc'), o = document.getElementById('soHT'),
            goi = document.getElementById('goiYLech'),
            oDem = document.querySelector('input[name="soDemThucTe"]');
        if (!o) return;
        var soHT = null;

        function nap() {
            if (!tu.value || !den.value) return;
            o.textContent = '...';
            fetch('@Url.Action("DemHeThong", "DoiSoatCong")?cong=' + encodeURIComponent(cong.value) +
                  '&tu=' + encodeURIComponent(tu.value) + '&den=' + encodeURIComponent(den.value),
                  { credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (d) { soHT = d.so; o.textContent = d.so + ' lượt'; veLech(); })
                .catch(function () { o.textContent = '—'; });
        }
        function veLech() {
            if (soHT === null || !oDem.value) { goi.textContent = ''; return; }
            var lech = parseInt(oDem.value, 10) - soHT;
            if (isNaN(lech)) { goi.textContent = ''; return; }
            var l = Math.abs(lech);
            var mo = l === 0 ? '✅ Khớp hoàn toàn'
                   : l <= 2 ? 'ℹ️ Lệch ' + lech + ' — sai số nhỏ, chấp nhận được'
                   : l <= 5 ? '⚠️ Lệch ' + lech + ' — cần kiểm tra lại'
                   : '🚨 Lệch ' + lech + ' — nghi vấn, sẽ mở sự cố an ninh';
            goi.textContent = mo;
            goi.style.color = l === 0 ? '#15803d' : l <= 2 ? '#0891b2' : l <= 5 ? '#b45309' : '#dc2626';
            goi.style.fontWeight = l > 2 ? '700' : '400';
        }
        [cong, tu, den].forEach(function (e) { e.addEventListener('change', nap); });
        oDem.addEventListener('input', veLech);
        nap();
    })();
</script>
