@model List<SmartPort.Models.LienHe>
@{
    ViewBag.Title = "Hộp thư liên hệ";
}
<div class="card-sp">
    <div class="card-header"><i class="bi bi-chat-left-text me-2 text-primary"></i>Liên hệ từ khách truy cập website</div>
    <div class="table-responsive">
        <table class="table table-sp">
            <thead>
                <tr><th>Người gửi</th><th>Chủ đề</th><th style="width:36%;">Nội dung</th><th>Ngày gửi</th><th class="text-center">Trạng thái</th><th class="text-end">Thao tác</th></tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Chưa có liên hệ nào.</td></tr>
                }
                @foreach (var l in Model)
                {
                    <tr class="@(l.DaXuLy ? "table-light" : "")">
                        <td>
                            <div class="fw-semibold">@l.HoTen</div>
                            <div class="text-muted small">@l.Email · @l.SoDienThoai</div>
                        </td>
                        <td>@l.ChuDe</td>
                        <td class="small">@l.NoiDung</td>
                        <td class="small">@Ui.Dt(l.NgayGui)</td>
                        <td class="text-center">
                            @if (l.DaXuLy)
                            {
                                <span class="badge-st st-ok">Đã xử lý</span>
                            }
                            else
                            {
                                <span class="badge-st st-warn">Chưa xử lý</span>
                            }
                        </td>
                        <td class="text-end" style="white-space:nowrap;">
                            @using (Html.BeginForm("Toggle", "Contacts", new { id = l.MaLH }, FormMethod.Post, null, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm @(l.DaXuLy ? "btn-outline-secondary" : "btn-outline-success")" type="submit" title="@(l.DaXuLy ? "Đánh dấu chưa xử lý" : "Đánh dấu đã xử lý")">
                                    <i class="bi @(l.DaXuLy ? "bi-arrow-counterclockwise" : "bi-check2")"></i>
                                </button>
                            }
                            @using (Html.BeginForm("Delete", "Contacts", new { id = l.MaLH }, FormMethod.Post, null, new { @class = "d-inline", onsubmit = "return confirm('Xóa liên hệ này?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
