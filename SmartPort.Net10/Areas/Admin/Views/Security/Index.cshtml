@model List<SmartPort.Models.SuCoAnNinh>
@{
    ViewBag.Title = "Phòng an ninh — Trung tâm cảnh báo AI";
    var khuNong = ViewBag.KhuNong as List<string> ?? new List<string>();
    // Toa do cac khu tren so do cang (SVG 700x300)
    var khuMap = new Dictionary<string, int[]> {
        { "Cổng chính",    new[] { 90, 235 } },
        { "Cổng phụ",      new[] { 250, 245 } },
        { "Bãi container", new[] { 300, 130 } },
        { "Cầu bến",       new[] { 520, 60 } },
        { "Kho CFS",       new[] { 555, 210 } }
    };
}

<div class="ai-box mb-3">
    <span class="ai-tag"><i class="bi bi-building-lock"></i> PHÒNG AN NINH · TRUNG TÂM CẢNH BÁO AI</span>
    <div class="row align-items-center mt-2">
        <div class="col-lg-9">
            <h5 class="fw-bold mb-1">Mọi sự cố camera AI phát hiện đều đổ về đây — kèm ảnh, video và vị trí</h5>
            <div style="color:#c9dcef;font-size:.9rem;">
                Trang tự làm mới mỗi 10 giây; có sự cố mới sẽ <strong>đổ chuông</strong>.
                Sơ đồ cảng đánh dấu <strong>điểm nóng đỏ</strong> đúng khu vực đang gặp nguy hiểm.
            </div>
        </div>
        <div class="col-lg-3 text-lg-end mt-2 mt-lg-0">
            <a class="btn btn-sm btn-light fw-semibold" href="@Url.Action("Monitor")"><i class="bi bi-camera-video me-1"></i>Trạm camera AI</a>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#dc2626,#f87171);">
            <div class="ps-num" id="anSoMoi">@ViewBag.SuCoMoi</div>
            <div class="ps-lbl">Sự cố CHƯA xử lý</div>
            <i class="bi bi-exclamation-octagon"></i>
        </div>
    </div>
    <div class="col-md-4 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#b45309,#f59e0b);">
            <div class="ps-num">@ViewBag.NguyHiemHomNay</div>
            <div class="ps-lbl">Mức NGUY HIỂM hôm nay</div>
            <i class="bi bi-fire"></i>
        </div>
    </div>
    <div class="col-md-4 col-12">
        <div class="pay-stat" style="background:linear-gradient(120deg,#15803d,#22c55e);">
            <div class="ps-num">@ViewBag.DaXuLy</div>
            <div class="ps-lbl">Đã xử lý (100 gần nhất)</div>
            <i class="bi bi-check-circle"></i>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- ===== SO DO CANG — DIEM NONG ===== -->
    <div class="col-lg-5">
        <div class="card-sp p-3">
            <h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-geo-alt me-1"></i>Sơ đồ cảng — vị trí đang gặp sự cố</h6>
            <svg id="anMap" viewBox="0 0 700 300" style="width:100%;border-radius:12px;background:linear-gradient(180deg,#0e5a9e 0%,#0e5a9e 28%,#8a939b 28%);">
                <!-- Bien + cau ben -->
                <rect x="0" y="0" width="700" height="84" fill="#0e5a9e" />
                <rect x="380" y="70" width="290" height="26" rx="4" fill="#4b5a66" />
                <text x="520" y="45" text-anchor="middle" font-size="15" fill="#cfe8ff" font-family="Segoe UI">⚓ CẦU BẾN</text>
                <!-- Bai container -->
                <g>
                    <rect x="180" y="108" width="240" height="64" rx="6" fill="#37424b" />
                    <rect x="192" y="116" width="42" height="20" fill="#e5691d" /><rect x="240" y="116" width="42" height="20" fill="#1c5fa8" />
                    <rect x="288" y="116" width="42" height="20" fill="#15803d" /><rect x="336" y="116" width="42" height="20" fill="#7c3aed" />
                    <rect x="192" y="142" width="42" height="20" fill="#0891b2" /><rect x="240" y="142" width="42" height="20" fill="#e5691d" />
                    <rect x="288" y="142" width="42" height="20" fill="#b45309" /><rect x="336" y="142" width="42" height="20" fill="#1c5fa8" />
                    <text x="300" y="196" text-anchor="middle" font-size="14" fill="#e8eef4" font-family="Segoe UI">BÃI CONTAINER</text>
                </g>
                <!-- Kho CFS -->
                <rect x="480" y="170" width="150" height="70" rx="8" fill="#5d6a75" />
                <text x="555" y="262" text-anchor="middle" font-size="13" fill="#e8eef4" font-family="Segoe UI">KHO CFS</text>
                <!-- Cong -->
                <rect x="40" y="210" width="100" height="50" rx="8" fill="#0a2f57" />
                <text x="90" y="285" text-anchor="middle" font-size="13" fill="#e8eef4" font-family="Segoe UI">CỔNG CHÍNH</text>
                <rect x="205" y="222" width="90" height="42" rx="8" fill="#123c66" />
                <text x="250" y="288" text-anchor="middle" font-size="12" fill="#e8eef4" font-family="Segoe UI">CỔNG PHỤ</text>

                <!-- Diem nong (JS + server render) -->
                @foreach (var khu in khuMap)
                {
                    var hot = khuNong.Contains(khu.Key);
                    <g class="an-dot" data-khu="@khu.Key" style="@(hot ? "" : "display:none;")">
                        <circle cx="@khu.Value[0]" cy="@khu.Value[1]" r="16" fill="none" stroke="#ef4444" stroke-width="3">
                            <animate attributeName="r" values="10;22;10" dur="1.6s" repeatCount="indefinite" />
                            <animate attributeName="opacity" values=".9;.1;.9" dur="1.6s" repeatCount="indefinite" />
                        </circle>
                        <circle cx="@khu.Value[0]" cy="@khu.Value[1]" r="8" fill="#ef4444" />
                    </g>
                }
            </svg>
            <div class="small text-muted mt-2">Chấm đỏ nhấp nháy = khu vực có sự cố <b>chưa xử lý</b> — cập nhật tự động.</div>
        </div>
    </div>

    <!-- ===== DANH SACH SU CO ===== -->
    <div class="col-lg-7">
        <div class="card-sp p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0" style="color:#0a2f57;"><i class="bi bi-bell me-1"></i>Sự cố mới nhất</h6>
                <span class="small text-muted">tự làm mới 10s · <span id="anClock">—</span></span>
            </div>
            <div id="anList" style="max-height:560px;overflow-y:auto;">
                @foreach (var s in Model)
                {
                    <div class="an-item @(s.TrangThai == "Mới" ? "moi" : "")" data-id="@s.MaSC">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <span class="badge @(s.MucDo == "Nguy hiểm" ? "bg-danger" : "bg-warning text-dark")">@s.MucDo</span>
                                <b class="ms-1">@s.TenLoai</b>
                                <span class="badge bg-secondary ms-1"><i class="bi bi-geo-alt"></i> @s.ViTri</span>
                            </div>
                            <span class="small text-muted text-nowrap">@s.ThoiGian.ToString("HH:mm:ss dd/MM")</span>
                        </div>
                        <div class="small mt-1">@s.MoTa</div>
                        <div class="d-flex gap-2 mt-2 align-items-center flex-wrap">
                            @if (!string.IsNullOrEmpty(s.AnhBase64))
                            {
                                <button class="btn btn-sm btn-outline-sp an-xem-anh" data-id="@s.MaSC"><i class="bi bi-image me-1"></i>Xem ảnh</button>
                            }
                            @if (!string.IsNullOrEmpty(s.VideoPath))
                            {
                                <a class="btn btn-sm btn-outline-sp" target="_blank" href="@Url.Content(s.VideoPath)"><i class="bi bi-play-circle me-1"></i>Video</a>
                            }
                            @if (s.TrangThai == "Mới")
                            {
                                <button class="btn btn-sm btn-success an-resolve" data-id="@s.MaSC"><i class="bi bi-check2 me-1"></i>Đã xử lý</button>
                            }
                            else
                            {
                                <span class="small text-success"><i class="bi bi-check-circle me-1"></i>@s.NguoiXuLy · @(s.ThoiGianXuLy.HasValue ? s.ThoiGianXuLy.Value.ToString("HH:mm dd/MM") : "")</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal xem anh -->
<div id="anModal" style="display:none;position:fixed;inset:0;z-index:2000;background:rgba(4,12,24,.8);align-items:center;justify-content:center;padding:20px;">
    <div style="max-width:820px;width:100%;background:var(--card);border-radius:14px;padding:14px;">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <b style="color:#0a2f57;">Ảnh bằng chứng</b>
            <button id="anModalClose" class="btn btn-sm btn-outline-sp">Đóng ✕</button>
        </div>
        <img id="anModalImg" alt="" style="width:100%;border-radius:10px;" />
    </div>
</div>

<style>
    .an-item { border: 1px solid var(--line); border-left: 5px solid #94a3b8; border-radius: 12px; padding: 10px 14px; margin-bottom: 10px; }
    .an-item.moi { border-left-color: #dc2626; background: rgba(220,38,38,.05); }
</style>

@section scripts {
<script>
(function () {
    var ROOT = window.APP_ROOT || '/';
    var soMoiCu = parseInt(document.getElementById('anSoMoi').textContent, 10) || 0;

    // Chuong bao khi co su co MOI do ve
    function chuong() {
        try {
            var a = new (window.AudioContext || window.webkitAudioContext)();
            [[988, 0], [784, 0.22], [988, 0.44]].forEach(function (n) {
                var o = a.createOscillator(), g = a.createGain();
                o.type = 'sine'; o.frequency.value = n[0];
                g.gain.setValueAtTime(0.35, a.currentTime + n[1]);
                g.gain.exponentialRampToValueAtTime(0.0001, a.currentTime + n[1] + 0.5);
                o.connect(g); g.connect(a.destination);
                o.start(a.currentTime + n[1]); o.stop(a.currentTime + n[1] + 0.55);
            });
        } catch (e) { }
    }

    function refresh() {
        fetch(ROOT + 'Admin/Security/Recent', { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d.ok) return;
                document.getElementById('anClock').textContent = new Date().toLocaleTimeString('vi-VN');
                if (d.soMoi > soMoiCu) { chuong(); location.reload(); return; }
                soMoiCu = d.soMoi;
                document.getElementById('anSoMoi').textContent = d.soMoi;
                // cap nhat diem nong so do
                document.querySelectorAll('.an-dot').forEach(function (g) {
                    g.style.display = d.khuNong.indexOf(g.getAttribute('data-khu')) >= 0 ? '' : 'none';
                });
            }).catch(function () { });
    }
    setInterval(refresh, 10000);
    refresh();

    // Xem anh
    document.addEventListener('click', function (e) {
        var btn = e.target.closest('.an-xem-anh');
        if (btn) {
            fetch(ROOT + 'Admin/Security/Anh?id=' + btn.getAttribute('data-id'), { credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (d.ok && d.anh) {
                        document.getElementById('anModalImg').src = d.anh;
                        document.getElementById('anModal').style.display = 'flex';
                    }
                });
        }
        var rs = e.target.closest('.an-resolve');
        if (rs) {
            rs.disabled = true;
            fetch(ROOT + 'Admin/Security/Resolve?id=' + rs.getAttribute('data-id'), { method: 'POST', credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (d) { if (d.ok) location.reload(); });
        }
    });
    document.getElementById('anModalClose').addEventListener('click', function () {
        document.getElementById('anModal').style.display = 'none';
    });
})();
</script>
}
