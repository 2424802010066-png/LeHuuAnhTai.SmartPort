@{
    ViewBag.Title = "Kiểm đếm & phân loại hàng hóa AI";
    var lichSu = ViewBag.LichSu as List<SmartPort.Models.KiemDem>;
}

<div class="ai-box mb-3">
    <span class="ai-tag"><i class="bi bi-ui-checks-grid"></i> SMARTTALLY · KIỂM ĐẾM & PHÂN LOẠI AI</span>
    <div class="row align-items-center mt-2">
        <div class="col-lg-9">
            <h5 class="fw-bold mb-1">Nhập thông tin lô — AI đếm số lượng và chia làn phân loại</h5>
            <div style="color:#c9dcef;font-size:.9rem;">
                YOLO26 <strong>đếm</strong> đối tượng theo lớp đã chọn, đối chiếu với <strong>số lượng khai báo</strong>;
                đồng thời so đặc trưng màu với <strong>vật mẫu chuẩn</strong>:
                giống mẫu → <strong>lăn PHẢI</strong> (xanh), khác mẫu → <strong>lăn TRÁI</strong> (cam) — mô phỏng băng chuyền phân loại.
            </div>
        </div>
        <div class="col-lg-3 text-lg-end mt-2 mt-lg-0">
            <a class="btn btn-sm btn-light fw-semibold" href="@Url.Action("Index")"><i class="bi bi-building-lock me-1"></i>Phòng an ninh</a>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card-sp p-3 mb-3">
            <h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-1-circle me-1"></i>Thông tin lô hàng</h6>
            <label class="form-label small fw-semibold mb-1">Tên lô hàng *</label>
            <input id="tlTenLo" class="form-control form-control-sm mb-2" placeholder="VD: Lô nước suối 500ml" />
            <div class="row g-2">
                <div class="col-6">
                    <label class="form-label small fw-semibold mb-1">Số lượng khai báo</label>
                    <input id="tlDuKien" type="number" class="form-control form-control-sm" placeholder="24" />
                </div>
                <div class="col-6">
                    <label class="form-label small fw-semibold mb-1">Loại hàng (lớp đếm)</label>
                    <select id="tlLop" class="form-select form-select-sm">
                        <option value="bottle">Chai/lọ</option>
                        <option value="cup">Cốc/ly</option>
                        <option value="suitcase">Vali/kiện hàng</option>
                        <option value="book">Sách/hộp mỏng</option>
                        <option value="cell phone">Điện thoại</option>
                        <option value="apple">Táo</option>
                        <option value="orange">Cam</option>
                        <option value="banana">Chuối</option>
                    </select>
                </div>
                <div class="col-6">
                    <label class="form-label small fw-semibold mb-1">Chiều cao</label>
                    <input id="tlCao" class="form-control form-control-sm" placeholder="VD: 21 cm" />
                </div>
                <div class="col-6">
                    <label class="form-label small fw-semibold mb-1">Trọng lượng</label>
                    <input id="tlNang" class="form-control form-control-sm" placeholder="VD: 0,5 kg" />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold mb-1">Ghi chú</label>
                    <input id="tlGhiChu" class="form-control form-control-sm" placeholder="Tùy chọn" />
                </div>
            </div>
        </div>

        <div class="card-sp p-3">
            <h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-3-circle me-1"></i>Kết quả</h6>
            <div id="tlKq" class="small" style="line-height:1.7;">Chưa có lượt đếm nào.</div>
            <button id="btnSaveTally" class="btn btn-accent w-100 mt-2" disabled><i class="bi bi-save me-1"></i>Lưu phiên kiểm đếm</button>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card-sp p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0" style="color:#0a2f57;"><i class="bi bi-2-circle me-1"></i>Camera kiểm đếm</h6>
                <span id="tlStatus" class="small text-muted">Đang tải...</span>
            </div>
            <div style="position:relative;border-radius:12px;overflow:hidden;background:#0b1520;min-height:300px;">
                <div style="position:absolute;left:0;top:0;bottom:0;width:46px;background:linear-gradient(90deg,rgba(245,158,11,.35),transparent);display:flex;align-items:center;justify-content:center;color:#f59e0b;font-weight:900;writing-mode:vertical-rl;letter-spacing:2px;z-index:2;">⬅ LÀN TRÁI · KHÁC MẪU</div>
                <div style="position:absolute;right:0;top:0;bottom:0;width:46px;background:linear-gradient(270deg,rgba(34,197,94,.35),transparent);display:flex;align-items:center;justify-content:center;color:#22c55e;font-weight:900;writing-mode:vertical-rl;letter-spacing:2px;z-index:2;">LÀN PHẢI · GIỐNG MẪU ➜</div>
                <canvas id="tlCanvas" style="width:100%;display:block;"></canvas>
                <video id="tlVideo" playsinline muted style="display:none;"></video>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-md-4"><button id="btnCam" class="btn btn-navy w-100" disabled><i class="bi bi-camera-video me-1"></i>Bật camera</button></div>
                <div class="col-md-4"><input type="file" id="fileInput" accept="image/*" class="form-control" disabled /></div>
                <div class="col-md-4"><button id="btnCount" class="btn btn-accent w-100" disabled><i class="bi bi-123 me-1"></i>Đếm &amp; phân loại</button></div>
            </div>
            <div class="small text-muted mt-2">💡 Thử nhanh dễ nhất: đặt vài <b>chai nước</b> lên bàn (1 chai khác màu) → chọn lớp "Chai/lọ" → Đếm &amp; phân loại.</div>

            <!-- ===== TRAM QC: PHAT HIEN THUNG HANG LOI ===== -->
            <hr class="my-3" />
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                <h6 class="fw-bold mb-0" style="color:#0a2f57;">
                    <i class="bi bi-clipboard2-check me-1"></i>Trạm QC — Soi lỗi thùng hàng
                    <span class="badge bg-danger" style="font-size:.6rem;">DEFECT AI</span>
                </h6>
                <a class="btn btn-sm btn-outline-sp" href="@Url.Action("Media")"><i class="bi bi-collection-play me-1"></i>Kho ảnh/video AI</a>
            </div>
            <p class="small text-muted mb-2">
                AI tìm thùng carton (YOLO + phân tích màu), <b>soi bề mặt từng thùng</b> tìm vùng
                <b>ướt/thẫm màu/hư hại</b> — thùng lỗi bị khoanh <b class="text-danger">ĐỎ</b>,
                hệ thống <b>hú còi + đọc cảnh báo</b>, tự lưu ảnh vào <b>Kho media</b> và báo <b>Phòng an ninh</b>.
            </p>
            <div class="row g-2">
                <div class="col-md-5">
                    <button class="btn btn-outline-primary w-100 tl-sample" disabled data-src="@Url.Content("~/Content/img/box-qc-demo.png")?v=2">
                        <i class="bi bi-box-seam me-1"></i>Ảnh mẫu: 2 thùng (1 bị ướt góc)
                    </button>
                </div>
                <div class="col-md-4">
                    <button id="btnQC" class="btn btn-danger w-100" disabled><i class="bi bi-search me-1"></i>Kiểm tra lỗi thùng hàng</button>
                </div>
                <div class="col-md-3 d-flex align-items-center">
                    <div id="tlQcKq" class="small" style="line-height:1.5;">Chưa kiểm tra.</div>
                </div>
            </div>
        </div>

        <!-- ===== DEM LUY KE THEO VIDEO + SAN PHAM MAU ===== -->
        <div class="card-sp p-3 mb-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                <h6 class="fw-bold mb-0" style="color:#0a2f57;">
                    <i class="bi bi-camera-reels me-1"></i>Đếm theo VIDEO — đúng sản phẩm mẫu
                    <span class="badge" style="background:#7c3aed;font-size:.6rem;">FEW-SHOT AI</span>
                </h6>
                <span id="tlMauSo" class="badge bg-secondary">0/6 mẫu</span>
            </div>
            <p class="small text-muted mb-2">
                <b>① Đăng ký sản phẩm:</b> chụp/tải <b>4–6 ảnh</b> hoặc <b>video quay tổng quát</b> về sản phẩm →
                AI học đặc trưng để <b>chỉ đếm đúng sản phẩm đó</b>.
                <b>② Đếm:</b> nhập mục tiêu (VD 500) → chạy video/băng chuyền, bộ đếm chạy <b>0/500 → 500/500</b>;
                đủ số lượng sẽ <b>báo chuông + đọc thông báo</b>. Sản phẩm <b class="text-danger">sai mẫu</b> →
                <b>hú còi + đọc "cảnh báo lỗi"</b> và lưu ảnh vào Kho media.
            </p>
            <div id="tlMauThumbs" class="d-flex flex-wrap gap-2 mb-2"></div>
            <div class="row g-2 mb-2">
                <div class="col-md-3">
                    <label class="btn btn-outline-primary btn-sm w-100 mb-0">
                        <i class="bi bi-images me-1"></i>Tải 4–6 ảnh mẫu
                        <input type="file" id="tlMauFile" accept="image/*" multiple hidden />
                    </label>
                </div>
                <div class="col-md-3">
                    <label class="btn btn-outline-primary btn-sm w-100 mb-0">
                        <i class="bi bi-film me-1"></i>Video mẫu (tự trích 6 hình)
                        <input type="file" id="tlMauVid" accept="video/*" hidden />
                    </label>
                </div>
                <div class="col-md-3"><button id="btnMauCam" class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-camera me-1"></i>Chụp mẫu từ camera</button></div>
                <div class="col-md-2"><button id="btnMauDemo" class="btn btn-outline-success btn-sm w-100"><i class="bi bi-stars me-1"></i>Mẫu demo</button></div>
                <div class="col-md-1"><button id="btnMauXoa" class="btn btn-outline-danger btn-sm w-100" title="Xóa mẫu"><i class="bi bi-trash"></i></button></div>
            </div>
            <hr class="my-2" />
            <div class="row g-2 align-items-center">
                <div class="col-md-3 text-center">
                    <div id="tlVidDem" class="fw-bold" style="font-size:2rem;color:#0a2f57;line-height:1;">0/—</div>
                    <div class="progress mt-1" style="height:8px;"><div id="tlVidBar" class="progress-bar" style="width:0%;"></div></div>
                    <div id="tlVidKq" class="small mt-1 text-muted">Chưa chạy.</div>
                </div>
                <div class="col-md-3">
                    <label class="btn btn-outline-sp btn-sm w-100 mb-1">
                        <i class="bi bi-upload me-1"></i>Nạp video băng chuyền
                        <input type="file" id="tlVidInput" accept="video/*" hidden />
                    </label>
                    <button id="btnVidDemo" class="btn btn-outline-sp btn-sm w-100"><i class="bi bi-collection-play me-1"></i>Video demo băng chuyền</button>
                    <button id="btnVidClear" class="btn btn-outline-secondary btn-sm w-100 mt-1"><i class="bi bi-x-circle me-1"></i>Gỡ video (đếm bằng camera)</button>
                </div>
                <div class="col-md-3"><button id="btnVidStart" class="btn btn-accent w-100" disabled><i class="bi bi-play-fill me-1"></i>Bắt đầu đếm video</button></div>
                <div class="col-md-3"><button id="btnVidStop" class="btn btn-outline-danger w-100" disabled><i class="bi bi-stop-fill me-1"></i>Dừng</button></div>
            </div>
            <div class="small text-muted mt-2">💡 Thử nhanh nhanh: bấm <b>Mẫu demo</b> → nhập Số lượng khai báo = <b>11</b> → <b>Video demo băng chuyền</b> → <b>Bắt đầu đếm video</b> (mở loa 🔊).</div>
        </div>

        <div class="card-sp p-3">
            <h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-clock-history me-1"></i>Lịch sử kiểm đếm</h6>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead><tr class="small text-muted"><th>THỜI GIAN</th><th>LÔ HÀNG</th><th>KHAI BÁO</th><th>AI ĐẾM</th><th>PHẢI/TRÁI</th><th>GHI CHÚ</th></tr></thead>
                    <tbody>
                        @if (lichSu != null)
                        {
                            foreach (var k in lichSu)
                            {
                                var lech = (k.DuKien ?? 0) - (k.DemDuoc ?? 0);
                                <tr>
                                    <td class="small">@k.ThoiGian.ToString("HH:mm dd/MM")</td>
                                    <td class="fw-semibold small">@k.TenLo</td>
                                    <td>@(k.DuKien.HasValue ? k.DuKien.Value.ToString() : "—")</td>
                                    <td>
                                        <b>@(k.DemDuoc.HasValue ? k.DemDuoc.Value.ToString() : "—")</b>
                                        @if (k.DuKien.HasValue && k.DemDuoc.HasValue)
                                        {
                                            if (lech == 0) { <span class="badge bg-success ms-1">Khớp</span> }
                                            else { <span class="badge bg-danger ms-1">Lệch @Math.Abs(lech)</span> }
                                        }
                                    </td>
                                    <td class="small"><span class="text-success fw-bold">@(k.SoGiong ?? 0)</span> / <span style="color:#b45309;" class="fw-bold">@(k.SoKhac ?? 0)</span></td>
                                    <td class="small text-muted">@k.GhiChu</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<canvas id="tlWork" style="display:none;"></canvas>
<video id="tlVidFile" muted playsinline style="display:none;"></video>

@section scripts {
<script src="@Url.Content("~/Scripts/tally.js")?v=12"></script>
}
