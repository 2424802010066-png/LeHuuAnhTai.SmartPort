@model List<SmartPort.Models.MediaAI>
@{
    ViewBag.Title = "Kho ảnh & video AI";
    string nguonLoc = ViewBag.Nguon as string;
}

<div class="ai-box mb-3">
    <span class="ai-tag"><i class="bi bi-collection-play"></i> KHO LƯU TRỮ MEDIA AI</span>
    <div class="row align-items-center mt-2">
        <div class="col-lg-9">
            <h5 class="fw-bold mb-1">Nơi tập trung mọi ảnh &amp; video do AI ghi lại</h5>
            <div style="color:#c9dcef;font-size:.9rem;">
                Mỗi lần AI phát hiện (thùng hàng lỗi, sự cố an ninh, kiểm đếm...) hệ thống tự lưu
                <strong>ảnh bằng chứng</strong> và <strong>video</strong> về đây — xem lại, đối chiếu, tải về bất kỳ lúc nào.
            </div>
        </div>
        <div class="col-lg-3 text-lg-end mt-2 mt-lg-0">
            <span class="badge-st st-ok"><i class="bi bi-image me-1"></i>@ViewBag.TongAnh ảnh · <i class="bi bi-camera-reels ms-1 me-1"></i>@ViewBag.TongVideo video</span>
        </div>
    </div>
</div>

<div class="card-sp p-3 mb-3">
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="small fw-semibold">Lọc theo nguồn:</span>
        @foreach (var n in new[] { "", "KiemDem", "AnNinh", "ALPR", "CameraAI" })
        {
            var ten = n == "" ? "Tất cả" : (n == "KiemDem" ? "Kiểm đếm/QC" : n == "AnNinh" ? "An ninh" : n);
            <a class="btn btn-sm @(nguonLoc == n || (n == "" && string.IsNullOrEmpty(nguonLoc)) ? "btn-navy" : "btn-outline-sp")"
               href="@Url.Action("Media", new { nguon = n == "" ? null : n })">@ten</a>
        }
        <span class="ms-auto small text-muted">Hiển thị @Model.Count mục gần nhất</span>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card-sp p-5 text-center text-muted">
        <i class="bi bi-inbox" style="font-size:3rem;"></i>
        <div class="mt-2">Kho trống — chạy <b>Trạm QC soi lỗi thùng hàng</b> hoặc <b>Giám sát an ninh</b> để AI bắt đầu lưu ảnh/video.</div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var m in Model)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card-sp p-2 md-card">
                    @if (m.Loai == "Video")
                    {
                        <video src="@Url.Content(m.DuongDan)" controls preload="metadata" style="width:100%;border-radius:10px;background:#0b1520;max-height:190px;"></video>
                    }
                    else
                    {
                        <a href="@Url.Content(m.DuongDan)" target="_blank">
                            <img src="@Url.Content(m.DuongDan)" alt="" loading="lazy" style="width:100%;border-radius:10px;object-fit:cover;max-height:190px;" />
                        </a>
                    }
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <span class="badge @(m.Loai == "Video" ? "bg-danger" : "bg-primary")" style="font-size:.62rem;">
                            <i class="bi @(m.Loai == "Video" ? "bi-camera-reels" : "bi-image") me-1"></i>@m.Loai
                        </span>
                        <span class="badge bg-secondary" style="font-size:.62rem;">@m.Nguon</span>
                        <span class="small text-muted">@m.ThoiGian.ToString("HH:mm dd/MM")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(m.MoTa))
                    {
                        <div class="small mt-1" style="line-height:1.4;">@m.MoTa</div>
                    }
                </div>
            </div>
        }
    </div>
}

<style>
    .md-card { transition: transform .2s, box-shadow .2s; }
    .md-card:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(10,47,87,.16); }
</style>
