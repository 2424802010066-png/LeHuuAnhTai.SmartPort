@model SmartPort.Models.Container
@{
    ViewBag.Title = Model.MaCont == 0 ? "Thêm container" : "Sửa container " + Model.SoCont;
    string[] loais = { "20GP", "40GP", "40HC", "45HC", "20RF", "40RF", "20OT", "40OT" };
    string[] tinhTrangs = { "Full", "Empty" };
    string[] statuses = { "Trong bãi", "Chờ xuất tàu", "Đã xuất tàu", "Đã giao khách" };
}
<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card-sp">
            <div class="card-header"><i class="bi bi-box-seam me-2 text-primary"></i>@ViewBag.Title</div>
            <div class="p-4">
                @using (Html.BeginForm("Save", "Containers", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.MaCont)
                    @Html.ValidationSummary(true)
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Số container <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.SoCont, new { @class = "form-control text-uppercase", placeholder = "VD: MSCU2201417", maxlength = 11 })
                            @Html.ValidationMessageFor(m => m.SoCont)
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Loại</label>
                            @Html.DropDownListFor(m => m.LoaiCont, new SelectList(loais, Model.LoaiCont), new { @class = "form-select" })
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Tình trạng</label>
                            @Html.DropDownListFor(m => m.TinhTrang, new SelectList(tinhTrangs, Model.TinhTrang), new { @class = "form-select" })
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Trọng lượng (tấn)</label>
                            @Html.TextBoxFor(m => m.TrongLuong, new { @class = "form-control", type = "number", step = "0.01", min = "0" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Hàng hóa</label>
                            @Html.TextBoxFor(m => m.HangHoa, new { @class = "form-control" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Khách hàng (chủ hàng)</label>
                            @Html.DropDownListFor(m => m.MaKH, (SelectList)ViewBag.KhList, "— Không —", new { @class = "form-select" })
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Chuyến nhập (dỡ từ tàu)</label>
                            @Html.DropDownListFor(m => m.MaChuyenNhap, (SelectList)ViewBag.ChuyenNhapList, "— Không —", new { @class = "form-select" })
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Chuyến xuất (xếp lên tàu)</label>
                            @Html.DropDownListFor(m => m.MaChuyenXuat, (SelectList)ViewBag.ChuyenXuatList, "— Không —", new { @class = "form-select" })
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Vị trí bãi (Khu-Bay-Hàng-Tầng)</label>
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.ViTriBai, new { @class = "form-control", placeholder = "VD: A-02-03-2" })
                                <button class="btn btn-navy" type="button" id="btnAiSlot" title="AI gợi ý vị trí hạ bãi tối ưu"><i class="bi bi-stars"></i> AI</button>
                            </div>
                            <div id="aiSlotResult" class="small mt-1"></div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Trạng thái</label>
                            @Html.DropDownListFor(m => m.TrangThai, new SelectList(statuses, Model.TrangThai), new { @class = "form-select" })
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Ngày vào bãi</label>
                            @Html.TextBoxFor(m => m.NgayVaoBai, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Ngày ra bãi</label>
                            @Html.TextBoxFor(m => m.NgayRaBai, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Nhiệt độ (°C, cont lạnh)</label>
                            @Html.TextBoxFor(m => m.NhietDo, new { @class = "form-control", type = "number", step = "0.1", placeholder = "VD: -18" })
                        </div>
                        <div class="col-12 mt-4">
                            <button class="btn btn-accent px-4" type="submit"><i class="bi bi-save me-1"></i>Lưu container</button>
                            <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Quay lại</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    (function () {
        var btn = document.getElementById('btnAiSlot');
        if (!btn) return;
        btn.addEventListener('click', function () {
            var loai = document.getElementById('LoaiCont').value;
            var trangThai = document.getElementById('TrangThai').value;
            var tinhTrang = document.getElementById('TinhTrang').value;
            var nhietDo = document.getElementById('NhietDo').value;
            var box = document.getElementById('aiSlotResult');
            box.innerHTML = '<span class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span>AI đang phân tích bãi...</span>';
            var url = '@Url.Action("SuggestSlot", "Containers")' +
                '?loai=' + encodeURIComponent(loai) +
                '&trangThai=' + encodeURIComponent(trangThai) +
                '&tinhTrang=' + encodeURIComponent(tinhTrang) +
                '&nhietDo=' + encodeURIComponent(nhietDo);
            fetch(url)
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (d.viTri) {
                        document.getElementById('ViTriBai').value = d.viTri;
                        var html = '<div class="text-success fw-semibold"><i class="bi bi-stars"></i> AI đề xuất: ' + d.viTri + ' (' + d.block + ')</div><ul class="mb-0 ps-3 text-muted">';
                        d.lyDo.forEach(function (l) { html += '<li>' + l + '</li>'; });
                        box.innerHTML = html + '</ul>';
                    } else {
                        box.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-triangle"></i> ' + d.lyDo[0] + '</span>';
                    }
                })
                .catch(function () { box.innerHTML = '<span class="text-danger">Không kết nối được AI, thử lại sau.</span>'; });
        });
    })();
</script>
}
