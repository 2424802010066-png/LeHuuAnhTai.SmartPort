@model SmartPort.Models.Container
@{
    ViewBag.Title = "Hồ sơ container " + Model.SoCont;
    // Vong doi: 1 Tren tau -> 2 Trong bai -> 3 Cho giao/xuat -> 4 Hoan tat
    var tt = Model.TrangThai ?? "Trong bãi";
    var buoc = tt == "Đã giao khách" || tt == "Đã xuất tàu" ? 4
             : tt == "Chờ xuất tàu" || tt == "Chờ giao" ? 3 : 2;
    var nhatKy = ViewBag.NhatKy as List<SmartPort.Models.NhatKy>;
    var dtg = (ViewBag.DongThoiGian as List<SmartPort.Services.LienKetService.SuKien>)
              ?? new List<SmartPort.Services.LienKetService.SuKien>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <a class="btn btn-sm btn-outline-sp" href="@Url.Action("Index")"><i class="bi bi-arrow-left me-1"></i>Danh sách</a>
        <span class="fs-5 fw-bold ms-2" style="color:#0a2f57;"><i class="bi bi-box-seam me-1"></i>@Model.SoCont</span>
        <span class="badge @(buoc == 4 ? "bg-success" : buoc == 3 ? "bg-warning text-dark" : "bg-primary") ms-1">@tt</span>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-accent" target="_blank" href="@Url.Action("EIR", new { id = Model.MaCont })"><i class="bi bi-printer me-1"></i>In phiếu EIR</a>
        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Form", new { id = Model.MaCont })"><i class="bi bi-pencil me-1"></i>Sửa</a>
        @if (buoc < 4)
        {
            using (Html.BeginForm("GateOut", "Containers", new { id = Model.MaCont }, FormMethod.Post, null, new { @class = "d-inline", onsubmit = "return confirm('Giao container " + Model.SoCont + " cho khách (gate out)?');" }))
            {
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-success" type="submit"><i class="bi bi-box-arrow-right me-1"></i>Gate out</button>
            }
        }
    </div>
</div>

<!-- VONG DOI CONTAINER — stepper nhu phan mem TOS that -->
<div class="card-sp p-3 mb-3">
    <div class="hs-step">
        @{ var tenBuoc = new[] { "Trên tàu / nhập cảng", "Hạ bãi — lưu bãi", "Lệnh giao / chờ xuất", "Đã giao / đã xuất" }; }
        @for (var i = 1; i <= 4; i++)
        {
            <div class="hs-b @(i < buoc ? "xong" : i == buoc ? "hien" : "")">
                <span class="hs-cham">@(i < buoc ? "✓" : i.ToString())</span>
                <span class="hs-ten">@tenBuoc[i - 1]</span>
            </div>
            if (i < 4) { <div class="hs-noi @(i < buoc ? "xong" : "")"></div> }
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card-sp p-3 mb-3">
            <h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-info-circle me-1"></i>Thông tin container</h6>
            <table class="table table-sm align-middle mb-0">
                <tr><td class="text-muted" style="width:170px;">Số container</td><td class="fw-bold">@Model.SoCont</td></tr>
                <tr><td class="text-muted">Loại / Tình trạng</td><td>@Model.LoaiCont · @Model.TinhTrang @(Model.NhietDo != null ? " · ❄ " + Model.NhietDo + "°C" : "")</td></tr>
                <tr><td class="text-muted">Hàng hóa</td><td>@(string.IsNullOrEmpty(Model.HangHoa) ? "—" : Model.HangHoa) @(Model.TrongLuong != null ? " · " + Model.TrongLuong + " tấn" : "")</td></tr>
                <tr>
                    <td class="text-muted">Khách hàng</td>
                    <td>
                        @if (Model.KhachHang != null)
                        {
                            <b>@Model.KhachHang.TenCongTy</b>
                            <div class="small text-muted">MST @(Model.KhachHang.MaSoThue ?? "—") · @(Model.KhachHang.SoDienThoai ?? "")</div>
                        }
                        else { <span>—</span> }
                    </td>
                </tr>
                <tr>
                    <td class="text-muted">Vị trí bãi</td>
                    <td>
                        <b>@(Model.ViTriBai ?? "chưa gán")</b>
                        <a class="btn btn-sm btn-outline-sp ms-2 py-0" href="@Url.Action("YardMap")"><i class="bi bi-grid-3x3-gap me-1"></i>Sơ đồ bãi</a>
                    </td>
                </tr>
                <tr><td class="text-muted">Chuyến nhập</td><td>@(Model.ChuyenNhap != null ? Model.ChuyenNhap.MaChuyenHieu + " — " + (Model.ChuyenNhap.Tau != null ? Model.ChuyenNhap.Tau.TenTau : "") : "—")</td></tr>
                <tr><td class="text-muted">Chuyến xuất</td><td>@(Model.ChuyenXuat != null ? Model.ChuyenXuat.MaChuyenHieu + " — " + (Model.ChuyenXuat.Tau != null ? Model.ChuyenXuat.Tau.TenTau : "") : "—")</td></tr>
                <tr><td class="text-muted">Vào bãi / Ra bãi</td><td>@(Model.NgayVaoBai != null ? Model.NgayVaoBai.Value.ToString("HH:mm dd/MM/yyyy") : "—") → @(Model.NgayRaBai != null ? Model.NgayRaBai.Value.ToString("HH:mm dd/MM/yyyy") : "đang trong bãi")</td></tr>
            </table>
        </div>

        @* ĐỒNG HỒ LƯU BÃI — con so nay thay doi tung ngay cho den khi CHOT phieu *@
        <div class="card-sp p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0" style="color:#0a2f57;">
                    <i class="bi bi-stopwatch me-1"></i>Đồng hồ lưu bãi
                </h6>
                @if ((bool)ViewBag.DangChayDongHo)
                {
                    <span class="badge bg-warning text-dark"><i class="bi bi-broadcast me-1"></i>đang chạy</span>
                }
                else
                {
                    <span class="badge bg-secondary">đã dừng</span>
                }
            </div>
            <table class="table table-sm align-middle mb-2">
                <tr><td class="text-muted" style="width:170px;">Biểu giá áp dụng</td><td>@ViewBag.TenDVLuuBai — <b>@string.Format("{0:N0}", (decimal)ViewBag.DonGiaLuuBai) đ</b>/Cont/ngày</td></tr>
                <tr><td class="text-muted">Tổng thời gian lưu bãi</td><td><b>@ViewBag.TongNgay ngày</b> (miễn phí @ViewBag.MienPhi ngày đầu)</td></tr>
                <tr><td class="text-muted">Phí lưu bãi</td><td>@ViewBag.NgayTinhPhi ngày × @string.Format("{0:N0}", (decimal)ViewBag.DonGiaLuuBai) đ = <b>@string.Format("{0:N0}", (decimal)ViewBag.PhiLuuBai) đ</b></td></tr>
                @if ((decimal)ViewBag.PhiDien > 0)
                {
                    <tr><td class="text-muted">Điện lạnh</td><td>@ViewBag.SoNgayDien ngày (tính từ ngày đầu) = <b>@string.Format("{0:N0}", (decimal)ViewBag.PhiDien) đ</b></td></tr>
                }
                <tr class="table-warning">
                    <td class="fw-bold">TỔNG @((bool)ViewBag.DangChayDongHo ? "(tạm tính)" : "")</td>
                    <td class="fw-bold fs-5" style="color:#c2410c;">@string.Format("{0:N0}", (decimal)ViewBag.TongPhi) đ</td>
                </tr>
            </table>

            @{ var phieuLB = ViewBag.PhieuLuuBai as SmartPort.Models.PhieuLuuBai; }
            @if (phieuLB != null)
            {
                <div class="alert alert-success py-2 mb-2 small">
                    <i class="bi bi-receipt me-1"></i>
                    Đã chốt phiếu <a class="fw-bold" href="@Url.Action("Phieu", "LuuBai", new { id = phieuLB.MaPhieu })">@phieuLB.SoPhieu</a>
                    — @phieuLB.TongTien.ToString("N0")đ · <b>@phieuLB.TrangThai</b>
                </div>
            }
            else if ((decimal)ViewBag.TongPhi > 0)
            {
                using (Html.BeginForm("Chot", "LuuBai", new { id = Model.MaCont }, FormMethod.Post, null,
                       new { onsubmit = "return confirm('Chốt phí lưu bãi " + ((decimal)ViewBag.TongPhi).ToString("N0") + "đ cho container " + Model.SoCont + "?');" }))
                {
                    @Html.AntiForgeryToken()
                    <button class="btn btn-accent w-100 mb-2" type="submit">
                        <i class="bi bi-receipt me-1"></i>Chốt thành phiếu thu @string.Format("{0:N0}", (decimal)ViewBag.TongPhi)đ
                    </button>
                }
            }

            <div class="small text-muted">💡 @ViewBag.DienGiaiPhi Tính đến @DateTime.Now.ToString("HH:mm dd/MM/yyyy") — <a href="@Url.Action("Index", "LuuBai")">xem toàn bộ công nợ lưu bãi</a>.</div>
        </div>
    </div>

    <div class="col-lg-5">
        @* ============================================================
           DONG THOI GIAN HOP NHAT — day la diem khac biet lon nhat so voi
           ban cu: truoc kia cho nay chi ve ke hoach tau + ngay vao/ra bai.
           Gio no gom ca luot xe qua cong, lenh giao nhan, phieu can, phieu
           sua chua vo, canh bao nhiet do va chung tu — tu 7 bang khac nhau
           nhung nguoi dung chi thay MOT danh sach.
           ============================================================ *@
        <div class="card-sp p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0" style="color:#0a2f57;"><i class="bi bi-clock-history me-1"></i>Dòng thời gian hợp nhất</h6>
                <span class="badge bg-light text-dark border">@dtg.Count sự kiện</span>
            </div>
            <div class="small text-muted mb-2" style="font-size:.75rem;">
                Gom từ cổng · lệnh · trạm cân · xưởng sửa chữa · cảm biến lạnh · kho chứng từ · kế hoạch tàu.
            </div>

            @if (dtg.Count == 0)
            {
                <div class="text-center text-muted py-4 small">
                    Chưa có sự kiện nào. Container sẽ tự có dòng thời gian ngay khi<br />
                    xe chở nó qua cổng theo một lệnh giao nhận.
                </div>
            }
            else
            {
                <div class="dtg-loc" id="dtgLoc">
                    <button type="button" class="on" data-nhom="">Tất cả</button>
                    @foreach (var nhom in dtg.Select(s => s.Nhom).Distinct())
                    {
                        <button type="button" data-nhom="@nhom">@nhom</button>
                    }
                </div>
                <div class="dtg" id="dtgDs" style="max-height:520px;overflow-y:auto;">
                    @foreach (var s in dtg)
                    {
                        <div class="dtg-muc" data-nhom="@s.Nhom">
                            <span class="dtg-cham" style="background:@s.Mau"><i class="bi @s.Icon"></i></span>
                            <div class="dtg-gio">@s.Luc.ToString("HH:mm · dd/MM/yyyy")</div>
                            <div class="dtg-td">
                                @if (!string.IsNullOrEmpty(s.Url))
                                {
                                    <a href="@s.Url">@s.TieuDe</a>
                                }
                                else
                                {
                                    @s.TieuDe
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(s.MoTa))
                            {
                                <div class="dtg-mt">@s.MoTa</div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="card-sp p-3">
            <h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-journal-text me-1"></i>Nhật ký thao tác (audit trail)</h6>
            @if (nhatKy == null || nhatKy.Count == 0)
            {
                <div class="small text-muted">Chưa có thao tác nào ghi nhận với container này.</div>
            }
            else
            {
                foreach (var n in nhatKy)
                {
                    <div class="d-flex gap-2 small border-bottom py-1">
                        <span class="text-muted text-nowrap">@n.ThoiGian.ToString("HH:mm dd/MM")</span>
                        <span class="badge bg-@n.MauLoai" style="font-size:.6rem;">@n.Loai</span>
                        <span>@n.NoiDung</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    .hs-step { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .hs-b { display: flex; align-items: center; gap: 8px; }
    .hs-cham {
        width: 30px; height: 30px; border-radius: 50%; display: inline-flex;
        align-items: center; justify-content: center; font-weight: 800; font-size: .85rem;
        background: rgba(13,79,139,.1); color: #64748b; border: 2px solid rgba(13,79,139,.25);
    }
    .hs-b.xong .hs-cham { background: #16a34a; border-color: #16a34a; color: #fff; }
    .hs-b.hien .hs-cham { background: #0d4f8b; border-color: #0d4f8b; color: #fff; box-shadow: 0 0 0 4px rgba(13,79,139,.18); }
    .hs-ten { font-size: .82rem; font-weight: 600; color: #475569; }
    .hs-b.hien .hs-ten { color: #0a2f57; font-weight: 800; }
    .hs-noi { flex: 1 1 30px; height: 3px; border-radius: 2px; background: rgba(13,79,139,.15); min-width: 24px; }
    .hs-noi.xong { background: #16a34a; }
    .hs-tl { position: relative; padding-left: 18px; }
    .hs-tl::before { content: ""; position: absolute; left: 5px; top: 6px; bottom: 6px; width: 2px; background: rgba(13,79,139,.18); }
    .hs-moc { position: relative; padding: 0 0 14px 8px; }
    .hs-moc::before { content: ""; position: absolute; left: -18px; top: 4px; width: 12px; height: 12px; border-radius: 50%; border: 3px solid #0d4f8b; background: #fff; }
    .hs-moc.success::before { border-color: #16a34a; }
    .hs-moc.warning::before { border-color: #d97706; }
    .hs-moc.info::before { border-color: #0891b2; }
    .hs-luc { font-size: .72rem; color: #64748b; font-family: Consolas, monospace; }
    .hs-nd { font-size: .88rem; color: #1e293b; }
    html[data-theme="dark"] .hs-ten { color: #9fb6cc; }
    html[data-theme="dark"] .hs-b.hien .hs-ten { color: #cfe3fb; }
    html[data-theme="dark"] .hs-nd { color: #d7e6f5; }
    html[data-theme="dark"] .hs-moc::before { background: #0f2338; }
</style>

<script>
    /* Loc dong thoi gian theo nhom — nhan vien tram can chi muon xem "Cân",
       ke toan chi muon xem "Chứng từ". Loc ngay tren trinh duyet, khong goi lai server. */
    (function () {
        var loc = document.getElementById('dtgLoc'), ds = document.getElementById('dtgDs');
        if (!loc || !ds) return;
        loc.addEventListener('click', function (e) {
            var b = e.target.closest('button'); if (!b) return;
            Array.prototype.forEach.call(loc.querySelectorAll('button'), function (x) { x.classList.remove('on'); });
            b.classList.add('on');
            var nhom = b.getAttribute('data-nhom') || '';
            Array.prototype.forEach.call(ds.querySelectorAll('.dtg-muc'), function (m) {
                m.style.display = (!nhom || m.getAttribute('data-nhom') === nhom) ? '' : 'none';
            });
        });
    })();
</script>
