@model SmartPort.Models.LenhGiaoNhan
@{
    ViewBag.Title = Model.MaLenh == 0 ? "Tạo lệnh giao nhận" : "Sửa lệnh " + Model.SoLenh;
    var dsKH = ViewBag.KhachHangs as List<SmartPort.Models.KhachHang>;
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a class="btn btn-sm btn-outline-sp" href="@Url.Action("Index")"><i class="bi bi-arrow-left me-1"></i>Danh sách lệnh</a>
    <span class="fs-5 fw-bold" style="color:#0a2f57;">@ViewBag.Title</span>
</div>

<div class="card-sp p-4" style="max-width:760px;">
    @using (Html.BeginForm("Save", "GatePass", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.MaLenh)
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Loại lệnh</label>
                @Html.DropDownListFor(m => m.LoaiLenh, new SelectList(new[]
                {
                    new { V = "GiaoCont", T = "Giao container (khách nhận hàng)" },
                    new { V = "HaCont", T = "Hạ container vào bãi" },
                    new { V = "TraRong", T = "Trả container rỗng" },
                    new { V = "LayRong", T = "Lấy container rỗng" }
                }, "V", "T", Model.LoaiLenh), new { @class = "form-select" })
            </div>
            <div class="col-md-6">
                <label class="form-label">Khách hàng</label>
                <select name="MaKH" class="form-select">
                    <option value="">— Không gắn khách —</option>
                    @foreach (var k in dsKH)
                    {
                        <option value="@k.MaKH" @(Model.MaKH == k.MaKH ? "selected" : "")>@k.TenCongTy</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Biển số xe <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.BienSoXe, new { @class = "form-control", placeholder = "VD: 51C-638.72" })
                @Html.ValidationMessageFor(m => m.BienSoXe, "", new { @class = "text-danger small" })
            </div>
            <div class="col-md-6">
                <label class="form-label">Số container (nếu có)</label>
                @Html.TextBoxFor(m => m.SoCont, new { @class = "form-control", placeholder = "VD: MSCU2201417", maxlength = "11" })
            </div>
            <div class="col-md-6">
                <label class="form-label">Tài xế</label>
                @Html.TextBoxFor(m => m.TenTaiXe, new { @class = "form-control" })
            </div>
            <div class="col-md-6">
                <label class="form-label">SĐT tài xế</label>
                @Html.TextBoxFor(m => m.SdtTaiXe, new { @class = "form-control" })
            </div>
            <div class="col-md-6">
                <label class="form-label">Hẹn từ</label>
                <input type="datetime-local" name="HenTuLuc" class="form-control" value="@Model.HenTuLuc.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Hẹn đến</label>
                <input type="datetime-local" name="HenDenLuc" class="form-control" value="@Model.HenDenLuc.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="col-12">
                <label class="form-label">Ghi chú</label>
                @Html.TextBoxFor(m => m.GhiChu, new { @class = "form-control" })
            </div>
        </div>
        <!-- TAS: luoi slot 24 gio toi — hoc HHIT Lach Huyen (TAS dau tien VN) -->
        <div class="mt-3">
            <label class="form-label fw-semibold small"><i class="bi bi-calendar-week me-1"></i>LƯỚI SLOT CỔNG 24 GIỜ TỚI — bấm để chọn khung giờ (tối đa @ViewBag.SlotSucChua xe/giờ)</label>
            <div class="d-flex flex-wrap gap-1">
                @foreach (object[] sl in (List<object[]>)ViewBag.Slots)
                {
                    var luc = (DateTime)sl[0];
                    var so = (int)sl[1];
                    var max = (int)sl[2];
                    var day = so >= max;
                    <button type="button" class="btn btn-sm @(day ? "btn-outline-danger" : so >= max - 2 ? "btn-outline-warning" : "btn-outline-success") ts-slot"
                            style="min-width:86px;" @(day ? "disabled" : "")
                            data-tu="@luc.ToString("yyyy-MM-ddTHH:00")" data-den="@luc.AddHours(2).ToString("yyyy-MM-ddTHH:00")">
                        <b>@luc.ToString("HH:00")</b> <span class="small">@luc.ToString("dd/MM")</span><br />
                        <span class="small">@so/@max xe</span>
                    </button>
                }
            </div>
            <div class="small text-muted mt-1">🟢 còn chỗ · 🟡 sắp đầy · 🔴 hết slot — mô hình TAS (Truck Appointment System) điều tiết xe theo giờ như HHIT Lạch Huyện.</div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-accent" type="submit"><i class="bi bi-save me-1"></i>@(Model.MaLenh == 0 ? "Tạo lệnh + cấp PIN" : "Lưu thay đổi")</button>
            <a class="btn btn-outline-sp" href="@Url.Action("Index")">Hủy</a>
        </div>
    }
</div>

<script>
    // Bam slot -> tu dien gio hen (khong can go tay)
    document.addEventListener('click', function (e) {
        var nut = e.target.closest ? e.target.closest('.ts-slot') : null;
        if (!nut) return;
        var tu = document.querySelector('input[name="HenTuLuc"]');
        var den = document.querySelector('input[name="HenDenLuc"]');
        if (tu) tu.value = nut.getAttribute('data-tu');
        if (den) den.value = nut.getAttribute('data-den');
        document.querySelectorAll('.ts-slot').forEach(function (b) { b.classList.remove('active'); });
        nut.classList.add('active');
    });
</script>
