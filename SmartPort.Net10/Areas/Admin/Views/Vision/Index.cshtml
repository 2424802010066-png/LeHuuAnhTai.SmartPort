@{
    ViewBag.Title = "Camera AI — Deep Learning YOLO";
}
<div class="ai-box mb-3">
    <span class="ai-tag"><i class="bi bi-camera-video"></i> SMARTVISION · DEEP LEARNING</span>
    <div class="row align-items-center mt-2">
        <div class="col-lg-9">
            <h5 class="fw-bold mb-1">Nhận diện đối tượng tại cảng bằng YOLO26 (mạng nơ-ron tích chập)</h5>
            <div style="color:#c9dcef;font-size:.9rem;">
                Mô hình <strong>YOLO26</strong> (Ultralytics, 01/2026 — thế hệ YOLO mới nhất, <strong>end-to-end NMS-free</strong>, nhanh hơn YOLO11n tới <strong>43%</strong> khi suy luận ONNX trên CPU) chạy <strong>ngay trên trình duyệt</strong> bằng ONNX Runtime.
                Nhận diện 80 loại đối tượng: xe tải, ô tô, người, tàu thuyền... vẽ khung, đếm số lượng và sinh cảnh báo điều phối cổng cảng.
            </div>
        </div>
        <div class="col-lg-3 text-lg-end mt-2 mt-lg-0">
            <span id="vsEngine" class="badge-st st-info"><i class="bi bi-hourglass-split me-1"></i>Đang khởi động...</span>
        </div>
    </div>
</div>

<!-- ===== Chỉ số hôm nay + lối vào module nghiệp vụ ===== -->
<div class="row g-3 mb-3">
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#0a2f57,#1c5fa8);">
            <div class="ps-num">@ViewBag.XeTaiHomNay</div>
            <div class="ps-lbl">Lượt xe tải hôm nay</div>
            <i class="bi bi-truck"></i>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#7c3aed,#a855f7);">
            <div class="ps-num">@ViewBag.LuotHomNay</div>
            <div class="ps-lbl">Lượt AI quét hôm nay</div>
            <i class="bi bi-cpu"></i>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#dc2626,#f87171);">
            <div class="ps-num">@ViewBag.CanhBaoHomNay</div>
            <div class="ps-lbl">Cảnh báo hôm nay</div>
            <i class="bi bi-exclamation-triangle"></i>
        </div>
    </div>
    <div class="col-md-3 col-6 d-grid gap-2">
        <a class="btn btn-navy" href="@Url.Action("Analytics")"><i class="bi bi-graph-up-arrow me-1"></i>Thống kê lưu lượng</a>
        <a class="btn btn-outline-sp" href="@Url.Action("History")"><i class="bi bi-clock-history me-1"></i>Nhật ký nhận diện</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card-sp p-3 mb-3">
            <h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-sliders me-1"></i>Nguồn hình ảnh</h6>
            <div id="vsStatus" class="small mb-3 text-muted">Đang tải mô hình...</div>

            <label class="form-label small fw-semibold">🧠 Chọn mô hình YOLO26</label>
            <select id="vsModel" class="form-select form-select-sm mb-1" disabled>
                <option value="yolo26n" selected>YOLO26n — nhanh nhất (mAP 40.9 · 9,5MB)</option>
                <option value="yolo26s">YOLO26s — cân bằng (mAP 48.6 · 36,5MB)</option>
                <option value="yolo26m">YOLO26m — chính xác cao (mAP 53.1 · 78,2MB)</option>
                <option value="yolo26l">YOLO26l — MẠNH NHẤT 💪 (mAP ~55 · 95MB, nên dùng khi có GPU)</option>
            </select>
            <div class="small text-muted mb-3" style="font-size:.78rem;">
                Model lớn hơn nhận diện <strong>chính xác hơn</strong> và bắt được vật nhỏ/ở xa, nhưng tải lâu hơn.
                Dùng <em>YOLO26n</em> cho webcam real-time, <em>YOLO26s/m</em> khi phân tích ảnh tĩnh.
            </div>

            <label class="form-label small fw-semibold">📁 Tải ảnh từ máy tính</label>
            <input type="file" id="fileInput" accept="image/*" class="form-control form-control-sm mb-3" disabled />

            <label class="form-label small fw-semibold">🖼️ Hoặc dùng ảnh mẫu</label>
            <div class="d-grid gap-2 mb-3">
                <button class="btn btn-sm btn-outline-primary vs-sample" disabled data-src="https://images.unsplash.com/photo-1519003722824-194d4455a60c?q=80&w=1100&auto=format&fit=crop"><i class="bi bi-truck me-1"></i>Xe đầu kéo trên đường</button>
                <button class="btn btn-sm btn-outline-primary vs-sample" disabled data-src="https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?q=80&w=1100&auto=format&fit=crop"><i class="bi bi-truck-flatbed me-1"></i>Xe tải giao nhận</button>
                <button class="btn btn-sm btn-outline-primary vs-sample" disabled data-src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?q=80&w=1100&auto=format&fit=crop"><i class="bi bi-people me-1"></i>Nhân sự họp điều độ</button>
                <button class="btn btn-sm btn-outline-primary vs-sample" disabled data-src="https://images.unsplash.com/photo-1502920514313-52581002a659?q=80&w=1100&auto=format&fit=crop"><i class="bi bi-water me-1"></i>Tàu ngoài khơi</button>
            </div>

            <label class="form-label small fw-semibold">🎥 Webcam trực tiếp (real-time)</label>
            <button id="btnCam" class="btn btn-navy w-100 mb-3" disabled><i class="bi bi-camera-video me-1"></i>Bật webcam AI</button>

            <label class="form-label small fw-semibold d-flex justify-content-between">
                <span>Ngưỡng tin cậy</span><span id="vsConfVal" class="text-primary">35%</span>
            </label>
            <input type="range" id="vsConf" class="form-range" min="0.15" max="0.8" step="0.05" value="0.35" />

            <hr class="my-3" />
            <label class="form-label small fw-semibold">📍 Vị trí camera</label>
            <select id="vsViTri" class="form-select form-select-sm mb-2">
                <option>Cổng chính</option>
                <option>Cổng phụ</option>
                <option>Bãi container</option>
                <option>Cầu bến</option>
                <option>Kho CFS</option>
            </select>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="vsAutoSave" checked />
                <label class="form-check-label small fw-semibold" for="vsAutoSave">
                    Lưu kết quả vào CSDL
                </label>
            </div>
            <div class="small text-muted" style="font-size:.76rem;">
                Bật để hệ thống ghi nhận mỗi lần quét — làm dữ liệu thống kê lưu lượng &amp; cảnh báo ùn tắc.
                (Webcam: tối đa 1 bản ghi/8 giây)
            </div>
            <div id="vsSaved" class="badge-st st-ok mt-2" style="display:none;"></div>

            <hr class="my-3" />
            <!-- VONG LAP TU HOC: he thong tu dieu chinh nguong theo phan hoi ✓/✗ -->
            <div id="vsSelfLearn" class="vs-selflearn" style="display:none;"></div>
            <div class="small text-muted mt-1" style="font-size:.74rem;">
                Bấm <b>✓ / ✗</b> cạnh mỗi kết quả để dạy AI — hệ thống <b>tự nâng ngưỡng</b> lớp hay nhận sai
                và <b>tự hạ ngưỡng</b> lớp nhận chuẩn (Active Learning).
            </div>
        </div>

        <div class="card-sp p-3">
            <h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-lightbulb me-1"></i>Cảnh báo điều phối AI</h6>
            <div id="vsInsight"><div class="ai-note">Chưa có dữ liệu — hãy phân tích một khung hình.</div></div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card-sp p-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                <h6 class="fw-bold mb-0" style="color:#0a2f57;"><i class="bi bi-bounding-box-circles me-1"></i>Kết quả nhận diện</h6>
                <span id="vsMeta" class="text-muted small">—</span>
            </div>
            <div class="vs-stage">
                <canvas id="vsCanvas"></canvas>
                <video id="vsVideo" playsinline muted style="display:none;"></video>
            </div>
            <div id="vsChips" class="mt-3"></div>
        </div>
    </div>
</div>

<canvas id="vsWork" style="display:none;"></canvas>

<style>
    /* Nut phan hoi ✓/✗ trong chip ket qua (vong lap tu hoc) */
    .vs-fb {
        border: 0; background: rgba(21,128,61,.12); color: #15803d;
        border-radius: 6px; width: 22px; height: 22px; margin-left: 4px;
        font-size: .72rem; font-weight: 800; cursor: pointer; line-height: 1;
        transition: transform .15s;
    }
    .vs-fb:hover { transform: scale(1.15); }
    .vs-fb:disabled { opacity: .55; cursor: default; }
    .vs-fb-sai { background: rgba(185,28,28,.1); color: #b91c1c; }
    .vs-selflearn {
        background: var(--soft); border-radius: 10px; padding: 10px 12px;
        border: 1px dashed var(--line);
    }
</style>

@section scripts {
<script src="@Url.Content("~/Scripts/vision.js")?v=12"></script>
}
