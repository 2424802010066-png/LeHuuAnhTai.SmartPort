@model List<SmartPort.Models.NhanDienAI>
@{
    ViewBag.Title = "Nhật ký nhận diện AI";
    int soNgay = ViewBag.Ngay ?? 7;
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h4 class="fw-bold mb-0" style="color:#0a2f57;"><i class="bi bi-clock-history me-2"></i>Nhật ký nhận diện AI</h4>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-warning" href="@Url.Action("ExportExcel", new { ngay = soNgay })"><i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel</a>
        <a class="btn btn-sm btn-outline-sp" href="@Url.Action("Analytics")"><i class="bi bi-graph-up-arrow me-1"></i>Thống kê</a>
        <a class="btn btn-sm btn-outline-sp" href="@Url.Action("Index")"><i class="bi bi-camera-video me-1"></i>Camera AI</a>
    </div>
</div>

<div class="card-sp p-3 mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold mb-1">Khoảng thời gian</label>
            <select name="ngay" class="form-select form-select-sm">
                @foreach (var n in new[] { 1, 7, 30 })
                {
                    <option value="@n" selected="@(soNgay == n)">@(n == 1 ? "Hôm nay" : n + " ngày gần nhất")</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold mb-1">Mức cảnh báo</label>
            <select name="muc" class="form-select form-select-sm">
                <option value="">— Tất cả —</option>
                @foreach (var s in new[] { "Bình thường", "Chú ý", "Ùn tắc" })
                {
                    <option value="@s" selected="@(((string)ViewBag.Muc) == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold mb-1">Nguồn</label>
            <select name="nguon" class="form-select form-select-sm">
                <option value="">— Tất cả —</option>
                @foreach (var s in new[] { "Webcam", "TaiAnh", "AnhMau" })
                {
                    <option value="@s" selected="@(((string)ViewBag.Nguon) == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-navy btn-sm w-100"><i class="bi bi-funnel me-1"></i>Lọc dữ liệu</button>
        </div>
    </form>
</div>

<div class="card-sp p-0">
    <div class="table-responsive">
        <table class="table table-sp align-middle mb-0">
            <thead>
                <tr>
                    <th>Thời gian</th>
                    <th>Vị trí</th>
                    <th>Nguồn</th>
                    <th>Mô hình</th>
                    <th class="text-center">Xe tải</th>
                    <th class="text-center">Ô tô</th>
                    <th class="text-center">Người</th>
                    <th class="text-center">Tổng</th>
                    <th class="text-center">Tin cậy</th>
                    <th class="text-center">Xử lý</th>
                    <th>Cảnh báo</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="11" class="text-center text-muted py-4">Chưa có dữ liệu nhận diện trong khoảng thời gian này.</td></tr>
                }
                @foreach (var n in Model)
                {
                    <tr>
                        <td class="fw-semibold">@n.ThoiGian.ToString("dd/MM HH:mm")</td>
                        <td>@n.ViTriCamera</td>
                        <td><span class="badge-st st-info">@n.Nguon</span></td>
                        <td class="small">@n.TenModel</td>
                        <td class="text-center fw-bold" style="color:var(--accent);">@n.SoXeTai</td>
                        <td class="text-center">@n.SoOto</td>
                        <td class="text-center">@n.SoNguoi</td>
                        <td class="text-center">@n.TongDoiTuong</td>
                        <td class="text-center">@(n.DoTinCayTB.HasValue ? n.DoTinCayTB.Value.ToString("0") + "%" : "—")</td>
                        <td class="text-center small">@(n.ThoiGianXuLy.HasValue ? n.ThoiGianXuLy + "ms" : "—")</td>
                        <td>
                            @if (n.MucCanhBao == "Ùn tắc")
                            {
                                <span class="badge-st st-err"><i class="bi bi-exclamation-triangle-fill me-1"></i>Ùn tắc</span>
                            }
                            else if (n.MucCanhBao == "Chú ý")
                            {
                                <span class="badge-st st-warn">Chú ý</span>
                            }
                            else
                            {
                                <span class="badge-st st-ok">Bình thường</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="text-muted small mt-2">Hiển thị tối đa 300 bản ghi gần nhất. Dùng nút “Xuất Excel” để lấy toàn bộ dữ liệu kỳ báo cáo.</div>
