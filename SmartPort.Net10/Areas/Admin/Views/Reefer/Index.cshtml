@model List<SmartPort.Models.Container>
@using SmartPort.Models
@{
    ViewBag.Title = "Giám sát container lạnh";
    var logs = ViewBag.Logs as Dictionary<int, List<NhietDoLog>>;
    decimal lechCB = ViewBag.LechCanhBao;
    decimal lechNC = ViewBag.LechNguyCap;
}
@functions {
    // Ve sparkline 24h: polyline + vach nhiet do cai dat + cham do o diem lech nguong
    public static string VeSpark(List<SmartPort.Models.NhietDoLog> ds, decimal dat, decimal nguong)
    {
        if (ds == null || ds.Count == 0) return "<span class='text-muted small'>chưa có dữ liệu</span>";
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        double W = 240, H = 56, pad = 4;
        double min = (double)dat, max = (double)dat;
        foreach (var l in ds) { var v = (double)l.NhietDo; if (v < min) min = v; if (v > max) max = v; }
        min -= 1.5; max += 1.5;
        var sb = new System.Text.StringBuilder();
        sb.Append("<svg width='240' height='56' viewBox='0 0 240 56' style='overflow:visible'>");
        double yDat = H - pad - ((double)dat - min) / (max - min) * (H - 2 * pad);
        sb.AppendFormat(inv, "<line x1='0' y1='{0:0.#}' x2='240' y2='{0:0.#}' stroke='#94a3b8' stroke-dasharray='4 3' stroke-width='1'/>", yDat);
        var pts = new System.Text.StringBuilder();
        for (var i = 0; i < ds.Count; i++)
        {
            double x = ds.Count == 1 ? W / 2 : pad + i * (W - 2 * pad) / (ds.Count - 1);
            double y = H - pad - ((double)ds[i].NhietDo - min) / (max - min) * (H - 2 * pad);
            pts.AppendFormat(inv, "{0:0.#},{1:0.#} ", x, y);
        }
        sb.AppendFormat("<polyline points='{0}' fill='none' stroke='#0ea5e9' stroke-width='1.8'/>", pts.ToString().Trim());
        for (var i = 0; i < ds.Count; i++)
        {
            if (Math.Abs(ds[i].NhietDo - dat) < nguong) continue;
            double x = ds.Count == 1 ? W / 2 : pad + i * (W - 2 * pad) / (ds.Count - 1);
            double y = H - pad - ((double)ds[i].NhietDo - min) / (max - min) * (H - 2 * pad);
            sb.AppendFormat(inv, "<circle cx='{0:0.#}' cy='{1:0.#}' r='2.6' fill='#dc2626'/>", x, y);
        }
        sb.Append("</svg>");
        return sb.ToString();
    }
}

<div class="ai-box mb-3" style="background:linear-gradient(120deg,#0c4a6e,#0369a1);">
    <span class="ai-tag"><i class="bi bi-thermometer-snow"></i> REEFER · GIÁM SÁT CONTAINER LẠNH 24/7</span>
    <div style="color:#e0f2fe;font-size:.9rem;" class="mt-2">
        Cont lạnh cắm điện được đọc nhiệt độ <strong>mỗi 30 phút</strong> (cảm biến IoT — mô phỏng tất định khi chưa gắn thiết bị thật)
        + nhân viên điện lạnh đi tua <strong>đo tay</strong> nhập trực tiếp. Lệch ≥ @lechCB°C so với cài đặt = <span class="badge bg-warning text-dark">CẢNH BÁO</span>,
        lệch ≥ @lechNC°C = <span class="badge bg-danger">NGUY CẤP</span> — tự đẩy sự cố sang Trung tâm an ninh. Quy trình học từ bãi lạnh Cát Lái/TCIT.
    </div>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>@TempData["ThongBao"]</div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger py-2"><i class="bi bi-exclamation-triangle me-1"></i>@TempData["Loi"]</div>
}

<div class="row g-3 mb-3">
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#0c4a6e,#0ea5e9);">
            <div class="ps-num">@Model.Count</div>
            <div class="ps-lbl">Cont lạnh đang cắm điện trong bãi</div>
            <i class="bi bi-thermometer-snow"></i>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#b45309,#fbbf24);">
            <div class="ps-num">@ViewBag.SoCanhBao</div>
            <div class="ps-lbl">Đang CẢNH BÁO (lệch ≥ @lechCB°C)</div>
            <i class="bi bi-exclamation-triangle"></i>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#7f1d1d,#dc2626);">
            <div class="ps-num">@ViewBag.SoNguyCap</div>
            <div class="ps-lbl">NGUY CẤP (lệch ≥ @lechNC°C)</div>
            <i class="bi bi-bell-fill"></i>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#0a2f57,#1c5fa8);">
            <div class="ps-num">@ViewBag.SoLuotDo</div>
            <div class="ps-lbl">Lượt đọc nhiệt trong 24 giờ</div>
            <i class="bi bi-clock-history"></i>
        </div>
    </div>
</div>

<div class="card-sp p-3 mb-3">
    <h6 class="fw-bold mb-2" style="color:#0c4a6e;"><i class="bi bi-pencil-square me-1"></i>Nhập số đo tay (nhân viên điện lạnh đi tua)</h6>
    @using (Html.BeginForm("GhiNhan", "Reefer", FormMethod.Post, new { @class = "row g-2 align-items-end" }))
    {
        @Html.AntiForgeryToken()
        <div class="col-md-4">
            <label class="form-label small text-muted">Container</label>
            <select class="form-select" name="maCont" required>
                @foreach (var c in Model)
                {
                    <option value="@c.MaCont">@c.SoCont — cài @c.NhietDo°C (@c.ViTriBai)</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted">Nhiệt độ đo được (°C)</label>
            <input class="form-control" type="number" step="0.1" name="nhietDo" required placeholder="VD: -17.5" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-accent" type="submit"><i class="bi bi-save me-1"></i>Ghi nhận</button>
        </div>
    }
</div>

<div class="card-sp p-3">
    <h6 class="fw-bold mb-2" style="color:#0c4a6e;"><i class="bi bi-graph-down me-1"></i>Diễn biến nhiệt độ 24 giờ (nét đứt = nhiệt độ cài đặt · chấm đỏ = lượt đo vượt ngưỡng)</h6>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr class="small text-muted">
                    <th>CONTAINER</th><th>KHÁCH HÀNG</th><th>VỊ TRÍ</th><th class="text-center">CÀI ĐẶT</th>
                    <th class="text-center">ĐO GẦN NHẤT</th><th class="text-center">TRẠNG THÁI</th><th>BIỂU ĐỒ 24H</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Không có container lạnh nào đang trong bãi.</td></tr>
                }
                @foreach (var c in Model)
                {
                    List<NhietDoLog> ds = null;
                    if (logs != null) { logs.TryGetValue(c.MaCont, out ds); }
                    var cuoi = (ds != null && ds.Count > 0) ? ds[ds.Count - 1] : null;
                    var dat = c.NhietDo ?? 0;
                    var lech = cuoi != null ? Math.Abs(cuoi.NhietDo - dat) : 0;
                    <tr>
                        <td class="fw-semibold">@c.SoCont<div class="small text-muted">@c.LoaiCont</div></td>
                        <td class="small">@(c.KhachHang != null ? c.KhachHang.TenCongTy : "—")</td>
                        <td><span class="badge bg-light text-dark border">@c.ViTriBai</span></td>
                        <td class="text-center fw-semibold text-info">@dat°C</td>
                        <td class="text-center">
                            @if (cuoi != null)
                            {
                                <span class="fw-bold @(lech >= lechNC ? "text-danger" : lech >= lechCB ? "text-warning" : "text-success")">@cuoi.NhietDo°C</span>
                                <div class="small text-muted">@cuoi.ThoiGian.ToString("HH:mm") · @(cuoi.Nguon == "ThuCong" ? "đo tay" : "IoT")</div>
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td class="text-center">
                            @if (cuoi == null) { <span class="badge bg-secondary">CHƯA ĐO</span> }
                            else if (lech >= lechNC) { <span class="badge bg-danger">NGUY CẤP · lệch @Math.Round(lech, 1)°C</span> }
                            else if (lech >= lechCB) { <span class="badge bg-warning text-dark">CẢNH BÁO · lệch @Math.Round(lech, 1)°C</span> }
                            else { <span class="badge bg-success">ỔN ĐỊNH</span> }
                        </td>
                        <td>@Html.Raw(VeSpark(ds, dat, lechCB))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="small text-muted">
        💡 Vì sao quan trọng: 1 container tôm đông lạnh trị giá 1–2 tỷ đồng — mất lạnh vài giờ là đền cả lô.
        Sự cố NGUY CẤP tự xuất hiện ở <a href="@Url.Action("Index", "Security")">Trung tâm an ninh</a> và chuông thông báo.
    </div>
</div>
