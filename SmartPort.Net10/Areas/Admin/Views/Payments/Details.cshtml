@model SmartPort.Models.ThanhToan
@{
    ViewBag.Title = "Giao dịch #" + Model.MaTT;
    var bk = Model.DatDichVu;
    string qr = ViewBag.QrUrl as string;
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h4 class="fw-bold mb-0" style="color:#0a2f57;"><i class="bi bi-receipt me-2"></i>Giao dịch #@Model.MaTT</h4>
    <a class="btn btn-sm btn-outline-sp" href="@Url.Action("Index")"><i class="bi bi-arrow-left me-1"></i>Về danh sách</a>
</div>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" @(Model.TrangThai == "Đã thanh toán" ? Html.Raw("data-money-rain") : null)><i class="bi bi-check-circle me-2"></i>@TempData["Ok"]<button class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card-sp p-4">
            <h6 class="fw-bold mb-3" style="color:#0a2f57;">Thông tin giao dịch</h6>
            <div class="rc-row"><span>Mã giao dịch nội bộ</span><strong>#@Model.MaTT</strong></div>
            <div class="rc-row"><span>Mã tham chiếu ngân hàng</span><strong>@(string.IsNullOrEmpty(Model.MaGiaoDich) ? "— chưa có —" : Model.MaGiaoDich)</strong></div>
            <div class="rc-row"><span>Nội dung chuyển khoản</span><strong class="text-primary">@Model.NoiDungCK</strong></div>
            <div class="rc-row"><span>Phương thức</span><strong>@Model.TenPhuongThuc</strong></div>
            <div class="rc-row"><span>Trạng thái</span><span class="badge-st @Ui.Badge(Model.TrangThai)">@Model.TrangThai</span></div>
            <div class="rc-row"><span>Ngày tạo</span><strong>@Ui.Dt(Model.NgayTao)</strong></div>
            @if (Model.NgayThanhToan.HasValue)
            {
                <div class="rc-row"><span>Ngày thanh toán</span><strong>@Ui.Dt(Model.NgayThanhToan.Value)</strong></div>
            }
            @if (!string.IsNullOrEmpty(Model.GhiChu))
            {
                <div class="rc-row"><span>Ghi chú</span><strong style="max-width:60%;text-align:right;">@Model.GhiChu</strong></div>
            }

            <div class="rc-total mt-3">
                <span>SỐ TIỀN</span><b>@Ui.Vnd(Model.SoTien)</b>
            </div>
            <div class="text-muted fst-italic small mt-1">@ViewBag.SoTienChu</div>

            @if (bk != null)
            {
                <h6 class="fw-bold mt-4 mb-2" style="color:#0a2f57;">Đơn đặt dịch vụ</h6>
                <div class="rc-row"><span>Mã booking</span><strong>@bk.MaSoBooking</strong></div>
                <div class="rc-row"><span>Khách hàng</span><strong>@(bk.KhachHang != null ? bk.KhachHang.TenCongTy : "—")</strong></div>
                <div class="rc-row"><span>Trạng thái đơn</span><span class="badge-st @Ui.Badge(bk.TrangThai)">@bk.TrangThai</span></div>
                <a class="btn btn-sm btn-outline-sp mt-2" href="@Url.Action("Details", "Bookings", new { id = bk.MaBooking })">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Xem chi tiết đơn
                </a>
            }
        </div>
    </div>

    <div class="col-lg-5">
        @if (Model.TrangThai != "Đã thanh toán")
        {
            <div class="card-sp p-4 mb-3">
                <h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-check2-square me-1"></i>Xác nhận đã nhận tiền</h6>
                <p class="text-muted small">Đối chiếu sao kê ngân hàng với nội dung <strong>@Model.NoiDungCK</strong> và số tiền <strong>@Ui.Vnd(Model.SoTien)</strong>.</p>
                @using (Html.BeginForm("Confirm", "Payments", new { id = Model.MaTT }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <label class="form-label small fw-semibold">Mã tham chiếu ngân hàng (tùy chọn)</label>
                    <input name="maGiaoDich" class="form-control form-control-sm mb-2" value="@Model.MaGiaoDich" placeholder="VD: FT26071234567" />
                    <button class="btn btn-success w-100" type="submit" onclick="return confirm('Xác nhận ĐÃ NHẬN TIỀN cho giao dịch này?');">
                        <i class="bi bi-check-circle me-1"></i>Xác nhận đã thanh toán
                    </button>
                }
                @using (Html.BeginForm("Reject", "Payments", new { id = Model.MaTT }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <label class="form-label small fw-semibold mt-3">Lý do từ chối</label>
                    <input name="lyDo" class="form-control form-control-sm mb-2" placeholder="VD: Không tìm thấy giao dịch trong sao kê" />
                    <button class="btn btn-outline-danger w-100" type="submit" onclick="return confirm('Hủy giao dịch này?');">
                        <i class="bi bi-x-circle me-1"></i>Từ chối / Hủy giao dịch
                    </button>
                }
            </div>
        }
        else
        {
            <div class="card-sp p-4 mb-3 text-center">
                <div class="pay-done"><i class="bi bi-check-circle-fill"></i> Giao dịch đã được xác nhận</div>
                <div class="text-muted small mt-2">Đã thu @Ui.Vnd(Model.SoTien) lúc @(Model.NgayThanhToan.HasValue ? Ui.Dt(Model.NgayThanhToan.Value) : "—")</div>
            </div>
        }

        @if (Model.PhuongThuc == "ChuyenKhoan" && !string.IsNullOrEmpty(qr))
        {
            <div class="card-sp p-4 text-center">
                <h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-qr-code me-1"></i>Mã QR của giao dịch</h6>
                <img src="@qr" alt="QR" style="max-width:230px;width:100%;border-radius:12px;border:1px solid var(--line);" />
                <div class="small text-muted mt-2">@ViewBag.BankName · @ViewBag.BankAccount<br />@ViewBag.BankAccountName</div>
            </div>
        }
    </div>
</div>
