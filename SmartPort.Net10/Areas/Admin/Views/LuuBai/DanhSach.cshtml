@model List<SmartPort.Models.PhieuLuuBai>
@{
    ViewBag.Title = "Sổ phiếu thu phí lưu bãi";
    var tt = (string)ViewBag.TrangThai;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <a class="btn btn-sm btn-outline-sp" href="@Url.Action("Index")"><i class="bi bi-arrow-left me-1"></i>Bảng kê đang chạy</a>
        <span class="fs-5 fw-bold ms-2" style="color:#0a2f57;"><i class="bi bi-journal-text me-1"></i>Sổ phiếu thu phí lưu bãi</span>
    </div>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>@TempData["ThongBao"]</div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>@TempData["Loi"]</div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="border-left:4px solid #b45309;">
            <div class="lbl">KHÁCH CÒN NỢ</div>
            <div class="num" style="color:#b45309;">@ViewBag.ChoThu.ToString("N0") <span style="font-size:1rem;">đ</span></div>
            <div class="small text-muted">@ViewBag.SoChoThu phiếu chờ thu</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="border-left:4px solid #dc2626;">
            <div class="lbl">NỢ QUÁ 30 NGÀY</div>
            <div class="num" style="color:@(ViewBag.NoQuaHan > 0 ? "#dc2626" : "#15803d");">@ViewBag.NoQuaHan.ToString("N0") <span style="font-size:1rem;">đ</span></div>
            <div class="small text-muted">cần gọi đòi</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="border-left:4px solid #15803d;">
            <div class="lbl">ĐÃ THU</div>
            <div class="num" style="color:#15803d;">@ViewBag.DaThu.ToString("N0") <span style="font-size:1rem;">đ</span></div>
            <div class="small text-muted">@ViewBag.SoDaThu phiếu</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="lbl">LỌC THEO</div>
            <div class="d-flex flex-wrap gap-1 mt-1">
                <a class="btn btn-sm @(string.IsNullOrEmpty(tt) ? "btn-accent" : "btn-outline-sp") py-0" href="@Url.Action("DanhSach")">Tất cả</a>
                <a class="btn btn-sm @(tt == "Chờ thu" ? "btn-accent" : "btn-outline-sp") py-0" href="@Url.Action("DanhSach", new { trangThai = "Chờ thu" })">Chờ thu</a>
                <a class="btn btn-sm @(tt == "Đã thu" ? "btn-accent" : "btn-outline-sp") py-0" href="@Url.Action("DanhSach", new { trangThai = "Đã thu" })">Đã thu</a>
                <a class="btn btn-sm @(tt == "Hủy" ? "btn-accent" : "btn-outline-sp") py-0" href="@Url.Action("DanhSach", new { trangThai = "Hủy" })">Hủy</a>
            </div>
        </div>
    </div>
</div>

<div class="card-sp p-3">
    @if (Model.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-receipt" style="font-size:2.6rem;opacity:.35;"></i>
            <div class="mt-2">Chưa có phiếu nào@(string.IsNullOrEmpty(tt) ? "" : " ở trạng thái “" + tt + "”").</div>
            <div class="small">Vào <a href="@Url.Action("Index")">bảng kê đang chạy</a> để chốt phiếu đầu tiên.</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sp align-middle mb-0">
                <thead>
                    <tr>
                        <th>Số phiếu</th>
                        <th>Container</th>
                        <th>Khách hàng</th>
                        <th class="text-center">Kỳ tính</th>
                        <th class="text-end">Số tiền</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr class="@(p.TrangThai == "Hủy" ? "opacity-50" : "")">
                            <td>
                                <a class="fw-semibold text-decoration-none" href="@Url.Action("Phieu", new { id = p.MaPhieu })">@p.SoPhieu</a>
                                <div class="small text-muted">@p.NgayLap.ToString("HH:mm dd/MM/yyyy")</div>
                            </td>
                            <td>
                                <a class="lk-cont" href="@Url.Action("TraCuu", "Containers", new { so = p.SoCont })">@p.SoCont</a>
                            </td>
                            <td class="small">
                                @(p.KhachHang != null ? p.KhachHang.TenCongTy : "—")
                                @if (p.HangTau != null)
                                {
                                    <div class="text-muted">@p.HangTau.TenHangTau</div>
                                }
                            </td>
                            <td class="text-center small text-muted">
                                @p.TuNgay.ToString("dd/MM") → @p.DenNgay.ToString("dd/MM/yyyy")
                                <div>@p.TongNgay ngày · tính @p.NgayTinhPhi</div>
                            </td>
                            <td class="text-end fw-bold" style="color:#b45309;">@p.TongTien.ToString("N0")đ</td>
                            <td class="text-center">
                                @if (p.TrangThai == "Đã thu")
                                {
                                    <span class="badge bg-success">Đã thu</span>
                                    <div class="small text-muted">@(p.NgayThu != null ? p.NgayThu.Value.ToString("dd/MM") : "") · @p.HinhThucThu</div>
                                }
                                else if (p.TrangThai == "Hủy")
                                {
                                    <span class="badge bg-secondary" title="@p.GhiChu">Hủy</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Chờ thu</span>
                                    @if (p.SoNgayTreo > 30)
                                    {
                                        <div><span class="badge bg-danger" style="font-size:.56rem;">treo @p.SoNgayTreo ngày</span></div>
                                    }
                                    else if (p.SoNgayTreo > 0)
                                    {
                                        <div class="small text-muted">treo @p.SoNgayTreo ngày</div>
                                    }
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-sp" target="_blank" href="@Url.Action("Phieu", new { id = p.MaPhieu })" title="Mở phiếu để in">
                                    <i class="bi bi-printer"></i>
                                </a>
                                @if (p.TrangThai == "Chờ thu")
                                {
                                    using (Html.BeginForm("DanhDauDaThu", "LuuBai", new { id = p.MaPhieu }, FormMethod.Post, null,
                                           new { @class = "d-inline", onsubmit = "return confirm('Xác nhận đã thu " + p.TongTien.ToString("N0") + "đ của phiếu " + p.SoPhieu + "?');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="hinhThuc" value="Chuyển khoản" />
                                        <button class="btn btn-sm btn-outline-success" type="submit" title="Đánh dấu đã thu tiền">
                                            <i class="bi bi-cash-coin"></i>
                                        </button>
                                    }
                                    using (Html.BeginForm("Huy", "LuuBai", new { id = p.MaPhieu }, FormMethod.Post, null,
                                           new { @class = "d-inline", onsubmit = "return confirm('Hủy phiếu " + p.SoPhieu + "? Phiếu vẫn được giữ lại trong sổ để truy vết.');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="lyDo" value="Chốt nhầm" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit" title="Hủy phiếu"><i class="bi bi-x-lg"></i></button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="small text-muted mt-2">
            Phiếu <b>hủy vẫn nằm trong sổ</b> chứ không xóa hẳn — kế toán phải giải trình được vì sao hủy.
            Phiếu <b>đã thu thì không hủy được</b>, muốn sửa phải lập phiếu điều chỉnh.
        </div>
    }
</div>
