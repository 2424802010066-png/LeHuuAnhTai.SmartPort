@model SmartPort.Models.PhieuLuuBai
@{
    ViewBag.Title = "Phiếu thu " + Model.SoPhieu;
    var qr = (string)ViewBag.QrUrl;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 khong-in">
    <div>
        <a class="btn btn-sm btn-outline-sp" href="@Url.Action("DanhSach")"><i class="bi bi-arrow-left me-1"></i>Sổ phiếu</a>
        <span class="fw-bold ms-2" style="color:#0a2f57;">@Model.SoPhieu</span>
        @if (Model.TrangThai == "Đã thu")
        {
            <span class="badge bg-success ms-1">Đã thu</span>
        }
        else if (Model.TrangThai == "Hủy")
        {
            <span class="badge bg-secondary ms-1">Đã hủy</span>
        }
        else
        {
            <span class="badge bg-warning text-dark ms-1">Chờ thu</span>
        }
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-accent" onclick="window.print()"><i class="bi bi-printer me-1"></i>In phiếu</button>
        <a class="btn btn-sm btn-outline-sp" href="@Url.Action("HoSo", "Containers", new { id = Model.MaCont })">
            <i class="bi bi-box-seam me-1"></i>Hồ sơ container
        </a>
    </div>
</div>

<div class="phieu">
    <div class="ph-dau">
        <div>
            <div class="ph-cang">CẢNG QUỐC TẾ SMARTPORT</div>
            <div class="ph-nho">Hệ thống điều hành cảng &amp; depot container</div>
        </div>
        <div class="text-end">
            <div class="ph-so">@Model.SoPhieu</div>
            <div class="ph-nho">Lập lúc @Model.NgayLap.ToString("HH:mm dd/MM/yyyy")</div>
        </div>
    </div>

    <h2 class="ph-ten">PHIẾU THU PHÍ LƯU BÃI</h2>
    <div class="ph-nho text-center mb-3">STORAGE CHARGE NOTE</div>

    <table class="ph-tt">
        <tr>
            <td class="ph-nhan">Khách hàng<br /><span class="ph-en">Customer</span></td>
            <td>
                <b>@(Model.KhachHang != null ? Model.KhachHang.TenCongTy : "—")</b>
                @if (Model.KhachHang != null && !string.IsNullOrEmpty(Model.KhachHang.MaSoThue))
                {
                    <div class="ph-nho">MST: @Model.KhachHang.MaSoThue</div>
                }
                @if (Model.KhachHang != null && !string.IsNullOrEmpty(Model.KhachHang.DiaChi))
                {
                    <div class="ph-nho">@Model.KhachHang.DiaChi</div>
                }
            </td>
            <td class="ph-nhan">Số container<br /><span class="ph-en">Container No.</span></td>
            <td><b style="font-size:1.05rem;letter-spacing:.5px;">@Model.SoCont</b></td>
        </tr>
        <tr>
            <td class="ph-nhan">Hãng tàu<br /><span class="ph-en">Shipping line</span></td>
            <td>@(Model.HangTau != null ? Model.HangTau.TenHangTau : "—")</td>
            <td class="ph-nhan">Kỳ tính phí<br /><span class="ph-en">Period</span></td>
            <td>@Model.TuNgay.ToString("dd/MM/yyyy") → @Model.DenNgay.ToString("dd/MM/yyyy")</td>
        </tr>
    </table>

    <table class="ph-bang">
        <thead>
            <tr>
                <th style="width:38px;">TT</th>
                <th>Khoản mục <span class="ph-en">/ Description</span></th>
                <th class="text-center" style="width:96px;">Số ngày</th>
                <th class="text-end" style="width:118px;">Đơn giá</th>
                <th class="text-end" style="width:130px;">Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="text-center">1</td>
                <td>
                    Phí lưu bãi container
                    <div class="ph-nho">
                        Lưu tổng @Model.TongNgay ngày, miễn phí @Model.NgayMienPhi ngày đầu
                        → tính phí @Model.NgayTinhPhi ngày
                    </div>
                </td>
                <td class="text-center">@Model.NgayTinhPhi</td>
                <td class="text-end">@Model.DonGiaNgay.ToString("N0")</td>
                <td class="text-end fw-bold">@Model.PhiLuuBai.ToString("N0")</td>
            </tr>
            @if (Model.PhiDien > 0)
            {
                <tr>
                    <td class="text-center">2</td>
                    <td>
                        Phí cắm điện &amp; giám sát container lạnh
                        <div class="ph-nho">Tính từ ngày đầu tiên, không áp dụng miễn phí</div>
                    </td>
                    <td class="text-center">@Model.SoNgayDien</td>
                    <td class="text-end">@Model.DonGiaDien.ToString("N0")</td>
                    <td class="text-end fw-bold">@Model.PhiDien.ToString("N0")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="ph-tong">
                <td colspan="4" class="text-end">TỔNG CỘNG <span class="ph-en">/ TOTAL</span></td>
                <td class="text-end">@Model.TongTien.ToString("N0") đ</td>
            </tr>
        </tfoot>
    </table>

    <div class="ph-chu">Bằng chữ: <i>@ViewBag.TienBangChu</i></div>

    <div class="ph-duoi">
        <div class="ph-ck">
            <div class="fw-bold mb-1">THANH TOÁN CHUYỂN KHOẢN</div>
            @if ((bool)ViewBag.CoTaiKhoan)
            {
                <div class="ph-nho">@ViewBag.NganHang</div>
                <div class="ph-nho">Nội dung: <b>Luu bai @Model.SoCont @Model.SoPhieu</b></div>
                <div class="ph-nho mt-2">Quét mã QR bên cạnh — số tiền và nội dung đã điền sẵn.</div>
            }
            else
            {
                <div class="ph-nho">Chưa cấu hình tài khoản ngân hàng trong hệ thống.</div>
            }
        </div>
        @if (!string.IsNullOrEmpty(qr))
        {
            <div class="ph-qr">
                <img src="@qr" alt="Mã QR chuyển khoản @Model.TongTien.ToString("N0") đồng" />
                <div class="ph-nho text-center">VietQR · NAPAS 247</div>
            </div>
        }
    </div>

    <div class="ph-ky">
        <div>
            <div class="fw-bold">NGƯỜI LẬP PHIẾU</div>
            <div class="ph-en">Prepared by</div>
            <div class="ph-cho-ky"></div>
            <div>@Model.NguoiLap</div>
        </div>
        <div>
            <div class="fw-bold">KHÁCH HÀNG</div>
            <div class="ph-en">Customer</div>
            <div class="ph-cho-ky"></div>
            <div class="ph-nho">(Ký, ghi rõ họ tên)</div>
        </div>
    </div>

    <div class="ph-nho mt-3" style="border-top:1px dashed #cbd5e1;padding-top:8px;">
        Phiếu do hệ thống SmartPort lập tự động từ dữ liệu cổng và bãi. Số tiền đã được
        <b>chốt tại thời điểm lập</b> và không thay đổi theo dữ liệu phát sinh sau đó.
        Mọi thắc mắc xin đối chiếu hồ sơ container @Model.SoCont trên hệ thống.
    </div>
</div>

<style>
    .phieu { background:#fff; color:#0f172a; max-width:860px; margin:0 auto; padding:26px 30px;
             border:1px solid #e2e8f0; border-radius:12px; font-size:.88rem; }
    .ph-dau { display:flex; justify-content:space-between; align-items:flex-start;
              border-bottom:2px solid #0a2f57; padding-bottom:10px; margin-bottom:16px; }
    .ph-cang { font-weight:800; color:#0a2f57; font-size:1.02rem; letter-spacing:.3px; }
    .ph-so { font-weight:800; color:#b45309; font-size:1.1rem; font-family:Consolas,monospace; }
    .ph-nho { font-size:.74rem; color:#64748b; }
    .ph-en { font-size:.68rem; color:#94a3b8; font-style:italic; }
    .ph-ten { text-align:center; font-size:1.35rem; font-weight:800; color:#0a2f57; margin:0; letter-spacing:.5px; }
    .ph-tt { width:100%; margin-bottom:14px; border-collapse:collapse; }
    .ph-tt td { padding:6px 8px; vertical-align:top; border-bottom:1px solid #f1f5f9; }
    .ph-nhan { width:110px; color:#64748b; font-size:.78rem; }
    .ph-bang { width:100%; border-collapse:collapse; }
    .ph-bang th { background:#0a2f57; color:#fff; padding:7px 9px; font-size:.76rem; font-weight:700; text-align:left; }
    .ph-bang td { padding:9px; border-bottom:1px solid #e2e8f0; vertical-align:top; }
    .ph-tong td { background:#fef3c7; font-weight:800; font-size:1.05rem; color:#b45309; padding:10px 9px; }
    .ph-chu { margin-top:10px; font-size:.84rem; }
    .ph-duoi { display:flex; gap:18px; align-items:flex-start; margin-top:16px;
               background:#f8fafc; border:1px solid #e2e8f0; border-radius:9px; padding:12px 14px; }
    .ph-ck { flex:1; }
    .ph-qr img { width:132px; height:132px; display:block; }
    .ph-ky { display:flex; justify-content:space-around; text-align:center; margin-top:26px; font-size:.8rem; }
    .ph-cho-ky { height:58px; }

    html[data-theme="dark"] .phieu { background:#fff; color:#0f172a; }

    @@media print {
        .sidebar, .topbar, .khong-in, .side-foot { display:none !important; }
        .admin-main { margin-left:0 !important; }
        .content { padding:0 !important; }
        .phieu { border:0; max-width:100%; padding:0; }
        body { background:#fff !important; }
    }
</style>
