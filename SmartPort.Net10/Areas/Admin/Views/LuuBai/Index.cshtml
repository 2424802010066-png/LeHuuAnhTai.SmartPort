@model List<SmartPort.Services.LuuBaiService.DongBangKe>
@{
    ViewBag.Title = "Phí lưu bãi — bảng kê đang chạy";
    var tongTien = (decimal)ViewBag.TongTien;
    var tienChuaChot = (decimal)ViewBag.TienChuaChot;
}

<div class="ai-box mb-3" style="background:linear-gradient(120deg,#422006,#b45309);">
    <span class="ai-tag"><i class="bi bi-stopwatch-fill"></i> ĐỒNG HỒ LƯU BÃI</span>
    <div style="color:#fef3c7;font-size:.9rem;" class="mt-2">
        Mỗi container hạ bãi là một <strong>đồng hồ bắt đầu chạy</strong>. Miễn @ViewBag.NgayMienPhi ngày đầu,
        sau đó tính tiền từng ngày. Bảng dưới là <strong>số tiền đang treo ngoài bãi ngay lúc này</strong> —
        bấm <em>Chốt</em> là ra phiếu thu có QR chuyển khoản, đưa khách đi đòi tiền được luôn.
    </div>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>@TempData["ThongBao"]</div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>@TempData["Loi"]</div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="border-left:4px solid #b45309;">
            <div class="lbl">TIỀN ĐANG TREO NGOÀI BÃI</div>
            <div class="num" style="color:#b45309;">@tongTien.ToString("N0") <span style="font-size:1rem;">đ</span></div>
            <div class="small text-muted">@ViewBag.TongCont container trong bãi</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="lbl">ĐÃ QUÁ HẠN MIỄN PHÍ</div>
            <div class="num">@ViewBag.SoContDenHan</div>
            <div class="small text-muted">container đang tính tiền</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="border-left:4px solid #15803d;">
            <div class="lbl">CHƯA CHỐT PHIẾU</div>
            <div class="num" style="color:#15803d;">@ViewBag.TienChuaChot.ToString("N0") <span style="font-size:1rem;">đ</span></div>
            <div class="small text-muted">@ViewBag.SoContChuaChot cont — thu được ngay</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card @(ViewBag.SoContTonLau > 0 ? "" : "")" style="border-left:4px solid #dc2626;">
            <div class="lbl">TỒN QUÁ 30 NGÀY</div>
            <div class="num" style="color:@(ViewBag.SoContTonLau > 0 ? "#dc2626" : "#15803d");">@ViewBag.SoContTonLau</div>
            <div class="small text-muted">gọi khách lấy hàng ra</div>
        </div>
    </div>
</div>

<div class="card-sp p-3 mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small fw-semibold">KHÁCH HÀNG</label>
            <select class="form-select" name="maKH">
                <option value="">— Tất cả khách hàng —</option>
                @foreach (var k in (SelectList)ViewBag.KhList)
                {
                    <option value="@k.Value" selected="@(k.Selected ? "selected" : null)">@k.Text</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-semibold">HÃNG TÀU</label>
            <select class="form-select" name="maHangTau">
                <option value="">— Tất cả hãng tàu —</option>
                @foreach (var h in (SelectList)ViewBag.HangList)
                {
                    <option value="@h.Value" selected="@(h.Selected ? "selected" : null)">@h.Text</option>
                }
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button class="btn btn-outline-sp flex-fill" type="submit"><i class="bi bi-funnel me-1"></i>Lọc</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("DanhSach")"><i class="bi bi-journal-text me-1"></i>Sổ phiếu</a>
        </div>
    </form>
</div>

<div class="card-sp p-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <h6 class="fw-bold mb-0" style="color:#0a2f57;"><i class="bi bi-list-columns me-1"></i>Chi tiết từng container</h6>
        @if (ViewBag.SoContChuaChot > 0)
        {
            using (Html.BeginForm("ChotKy", "LuuBai", new { maKH = ViewBag.MaKH, maHangTau = ViewBag.MaHangTau }, FormMethod.Post, null,
                   new { onsubmit = "return confirm('Chốt " + ViewBag.SoContChuaChot + " phiếu, tổng " + ((decimal)ViewBag.TienChuaChot).ToString("N0") + "đ?\\n\\nChốt rồi thì số tiền trên phiếu không đổi nữa.');" }))
            {
                @Html.AntiForgeryToken()
                <button class="btn btn-accent" type="submit">
                    <i class="bi bi-receipt me-1"></i>Chốt kỳ — @ViewBag.SoContChuaChot phiếu
                </button>
            }
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-inboxes" style="font-size:2.6rem;opacity:.35;"></i>
            <div class="mt-2">Không có container nào đang nằm trong bãi.</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sp align-middle mb-0">
                <thead>
                    <tr>
                        <th>Container</th>
                        <th>Khách hàng · hãng tàu</th>
                        <th class="text-center">Vào bãi</th>
                        <th class="text-center">Số ngày</th>
                        <th class="text-end">Lưu bãi</th>
                        <th class="text-end">Điện lạnh</th>
                        <th class="text-end">Đang treo</th>
                        <th class="text-end">Chốt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        var p = d.Phi;
                        <tr>
                            <td>
                                <a class="lk-cont" href="@Url.Action("HoSo", "Containers", new { id = d.Cont.MaCont })">@d.Cont.SoCont</a>
                                <div class="small text-muted">@d.Cont.LoaiCont · @d.Cont.TinhTrang @(d.Cont.ViTriBai != null ? "· " + d.Cont.ViTriBai : "")</div>
                            </td>
                            <td class="small">
                                @(d.TenKhach ?? "—")
                                @if (d.TenHangTau != null)
                                {
                                    <div class="text-muted">@d.TenHangTau</div>
                                }
                            </td>
                            <td class="text-center small text-muted">@p.TuNgay.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <span class="fw-bold @(p.TongNgay > 30 ? "text-danger" : "")">@p.TongNgay</span>
                                @if (p.NgayTinhPhi == 0)
                                {
                                    <div><span class="badge bg-success" style="font-size:.56rem;">còn miễn phí</span></div>
                                }
                                else
                                {
                                    <div class="small text-muted">tính @p.NgayTinhPhi ngày</div>
                                }
                            </td>
                            <td class="text-end small">@(p.PhiLuuBai > 0 ? p.PhiLuuBai.ToString("N0") + "đ" : "—")</td>
                            <td class="text-end small">
                                @if (p.LaContLanh)
                                {
                                    <span title="@p.SoNgayDien ngày × @p.DonGiaDien.ToString("N0")đ">@p.PhiDien.ToString("N0")đ</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end fw-bold" style="color:@(p.TongTien > 0 ? "#b45309" : "#94a3b8");">
                                @p.TongTien.ToString("N0")đ
                            </td>
                            <td class="text-end text-nowrap">
                                @if (d.DaCoPhieu)
                                {
                                    <span class="badge bg-light text-dark border" title="Đã chốt phiếu @d.SoPhieuDaChot">
                                        <i class="bi bi-check2"></i> @d.SoPhieuDaChot
                                    </span>
                                }
                                else if (p.TongTien > 0)
                                {
                                    using (Html.BeginForm("Chot", "LuuBai", new { id = d.Cont.MaCont }, FormMethod.Post, null, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-accent" type="submit" title="@p.DienGiai">
                                            <i class="bi bi-receipt me-1"></i>Chốt
                                        </button>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">chưa tới hạn</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-warning">
                        <td colspan="6" class="fw-bold text-end">TỔNG ĐANG TREO NGOÀI BÃI</td>
                        <td class="fw-bold text-end fs-6" style="color:#b45309;">@tongTien.ToString("N0")đ</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="small text-muted mt-2">
            💡 Số liệu tính đến <b>@DateTime.Now.ToString("HH:mm dd/MM/yyyy")</b> và <b>thay đổi từng ngày</b>.
            Chốt phiếu là khóa số tiền lại tại thời điểm chốt — sau đó dù ai sửa ngày vào/ra, phiếu vẫn giữ nguyên.
        </div>
    }
</div>
