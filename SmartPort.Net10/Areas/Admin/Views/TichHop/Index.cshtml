@model List<SmartPort.Models.ApiKey>
@{ ViewBag.Title = "Tích hợp · Khóa API"; }

<div class="ai-box mb-3" style="background:linear-gradient(120deg,#052e16,#15803d);">
    <span class="ai-tag"><i class="bi bi-plug-fill"></i> API TÍCH HỢP</span>
    <div style="color:#dcfce7;font-size:.9rem;" class="mt-2">
        Khách hàng đã chạy <strong>kế toán, quản lý kho hoặc phần mềm vận tải</strong> rồi thì họ không bỏ đi.
        Cấp cho họ một khóa ở đây là phần mềm bên họ <strong>đọc thẳng dữ liệu SmartPort</strong> —
        tồn bãi, trạng thái container, lịch sử xe — và <strong>đặt lệnh giao nhận</strong> mà không cần gọi điều độ.
        <a class="text-white text-decoration-underline" href="@Url.Action("TaiLieu")">Xem tài liệu để gửi cho kỹ thuật bên khách →</a>
    </div>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>@TempData["ThongBao"]</div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger py-2"><i class="bi bi-exclamation-triangle me-1"></i>@TempData["Loi"]</div>
}
@if (TempData["KhoaMoi"] != null)
{
    <div class="alert alert-warning">
        <div class="fw-bold mb-1"><i class="bi bi-key-fill me-1"></i>Khóa vừa tạo — chỉ hiện lần này</div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <code id="khoaMoi" style="font-size:1rem;background:#fff;padding:.45rem .7rem;border-radius:8px;border:1px solid #d6b656;word-break:break-all;">@TempData["KhoaMoi"]</code>
            <button class="btn btn-sm btn-dark" type="button" onclick="chepKhoa()"><i class="bi bi-clipboard me-1"></i>Sao chép</button>
        </div>
        <div class="small mt-2">Gửi cho kỹ thuật bên khách qua kênh riêng. Nếu lỡ lộ, bấm <b>Thu hồi</b> ở bảng dưới là khóa chết ngay.</div>
    </div>
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card-sp p-3">
            <h6 class="fw-bold mb-2" style="color:#15803d;"><i class="bi bi-plus-square me-1"></i>Cấp khóa mới</h6>
            @using (Html.BeginForm("Tao", "TichHop", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <label class="form-label small fw-semibold">ỨNG DỤNG SẼ DÙNG KHÓA</label>
                <input class="form-control mb-2" name="tenUngDung" placeholder="Kế toán MISA — Công ty Trường Thành" required />

                <label class="form-label small fw-semibold">GIỚI HẠN THEO KHÁCH HÀNG</label>
                <select class="form-select mb-1" name="maKH">
                    <option value="">— Không giới hạn (khóa nội bộ) —</option>
                    @foreach (var k in (SelectList)ViewBag.KhList)
                    {
                        <option value="@k.Value">@k.Text</option>
                    }
                </select>
                <div class="small text-muted mb-2" style="font-size:.72rem;">
                    Chọn một khách hàng thì khóa <b>chỉ thấy dữ liệu của khách đó</b> — đưa khóa cho đối tác mà không lo lộ dữ liệu khách khác.
                </div>

                <label class="form-label small fw-semibold">QUYỀN</label>
                <select class="form-select mb-1" name="quyen">
                    <option value="Doc">Chỉ đọc (an toàn nhất)</option>
                    <option value="Ghi">Đọc + đặt lệnh giao nhận</option>
                </select>
                <div class="small text-muted mb-2" style="font-size:.72rem;">
                    Chỉ cấp quyền ghi khi bên kia thực sự cần tự đặt lệnh.
                </div>

                <label class="form-label small fw-semibold">GHI CHÚ</label>
                <input class="form-control mb-3" name="ghiChu" placeholder="Anh Hùng IT — 0912xxxxxx" />

                <button class="btn btn-accent w-100" type="submit"><i class="bi bi-key me-1"></i>Cấp khóa</button>
            }
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card-sp p-3">
            <h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-list-ul me-1"></i>Khóa đã cấp (@Model.Count)</h6>
            @if (Model.Count == 0)
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-plug" style="font-size:2.4rem;opacity:.35;"></i>
                    <div class="mt-2">Chưa cấp khóa nào.</div>
                    <div class="small">Hệ thống vẫn chạy bình thường — API chỉ cần khi khách muốn nối phần mềm của họ vào.</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sp align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Ứng dụng</th>
                                <th>Khóa</th>
                                <th>Phạm vi</th>
                                <th class="text-center">Đã gọi</th>
                                <th>Gọi lần cuối</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var k in Model)
                            {
                                <tr class="@(k.KichHoat ? "" : "opacity-50")">
                                    <td>
                                        <div class="fw-semibold">@k.TenUngDung</div>
                                        @if (!string.IsNullOrEmpty(k.GhiChu))
                                        {
                                            <div class="small text-muted">@k.GhiChu</div>
                                        }
                                        @if (!k.KichHoat)
                                        {
                                            <span class="badge bg-secondary" style="font-size:.58rem;">Đã thu hồi</span>
                                        }
                                    </td>
                                    <td><code class="small">@k.KhoaRutGon</code></td>
                                    <td class="small">
                                        <span class="badge @(k.Quyen == "Ghi" ? "bg-warning text-dark" : "bg-light text-dark border")">@(k.Quyen == "Ghi" ? "Đọc + Ghi" : "Chỉ đọc")</span>
                                        <div class="text-muted mt-1">
                                            @(k.KhachHang != null ? k.KhachHang.TenCongTy : "Toàn hệ thống")
                                        </div>
                                    </td>
                                    <td class="text-center fw-semibold">@k.SoLanGoi</td>
                                    <td class="small text-muted">
                                        @(k.LanGoiCuoi != null ? k.LanGoiCuoi.Value.ToString("HH:mm dd/MM/yyyy") : "chưa dùng lần nào")
                                    </td>
                                    <td class="text-end text-nowrap">
                                        @using (Html.BeginForm("Bat", "TichHop", new { id = k.MaKey }, FormMethod.Post, null, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm @(k.KichHoat ? "btn-outline-danger" : "btn-outline-success")" type="submit">
                                                @(k.KichHoat ? "Thu hồi" : "Bật lại")
                                            </button>
                                        }
                                        @using (Html.BeginForm("Xoa", "TichHop", new { id = k.MaKey }, FormMethod.Post, null, new { @class = "d-inline", onsubmit = "return confirm('Xóa hẳn khóa của " + k.TenUngDung + "?');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-trash"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function chepKhoa() {
        var el = document.getElementById('khoaMoi');
        if (!el) return;
        var t = el.textContent.trim();
        if (navigator.clipboard) { navigator.clipboard.writeText(t); }
        else { var r = document.createRange(); r.selectNode(el); getSelection().removeAllRanges(); getSelection().addRange(r); document.execCommand('copy'); }
        event.target.closest('button').innerHTML = '<i class="bi bi-check2 me-1"></i>Đã chép';
    }
</script>
