@model List<SmartPort.Models.SanLuongThang>
@{
    ViewBag.Title = "Báo cáo thống kê";
    int year = ViewBag.Year;
    List<int> years = ViewBag.Years;
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <form method="get" class="d-flex gap-2 align-items-center">
        <label class="form-label mb-0 fw-semibold">Năm báo cáo:</label>
        <select name="nam" class="form-select form-select-sm" style="width:110px;" onchange="this.form.submit()">
            @foreach (var y in years)
            {
                <option value="@y" @(y == year ? "selected" : "")>@y</option>
            }
        </select>
    </form>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-success" href="@Url.Action("ExportExcel", new { nam = year })"><i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel</a>
        <button class="btn btn-sm btn-navy" onclick="window.print()"><i class="bi bi-printer me-1"></i>In báo cáo</button>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="ico ico-blue"><i class="bi bi-box-seam"></i></div>
            <div><div class="num">@Ui.Num((int)ViewBag.TongTEU) TEU</div><div class="lbl">Tổng sản lượng năm @year</div></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="ico ico-green"><i class="bi bi-cash-stack"></i></div>
            <div><div class="num" style="font-size:1.25rem;">@Ui.Vnd((decimal)ViewBag.TongDoanhThu)</div><div class="lbl">Doanh thu khai thác năm @year</div></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center gap-3">
            <div class="ico ico-orange"><i class="bi bi-receipt"></i></div>
            <div><div class="num" style="font-size:1.25rem;">@Ui.Vnd((decimal)ViewBag.TongTienDV)</div><div class="lbl">Doanh thu dịch vụ ePort (booking hoàn thành)</div></div>
        </div>
    </div>
</div>

<div class="card-sp mb-3">
    <div class="card-header"><i class="bi bi-graph-up me-2 text-primary"></i>Biểu đồ sản lượng &amp; doanh thu theo tháng — năm @year</div>
    <div class="p-3" style="height:340px;"><canvas id="rptChart"></canvas></div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card-sp">
            <div class="card-header"><i class="bi bi-table me-2 text-primary"></i>Sản lượng thông qua theo tháng</div>
            <div class="table-responsive">
                <table class="table table-sp">
                    <thead><tr><th>Tháng</th><th class="text-end">Sản lượng (TEU)</th><th class="text-end">Doanh thu (VNĐ)</th></tr></thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">Chưa có dữ liệu năm @year.</td></tr>
                        }
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="fw-semibold">Tháng @r.Thang/@r.Nam</td>
                                <td class="text-end">@Ui.Num(r.TEU)</td>
                                <td class="text-end">@Ui.Vnd(r.DoanhThu)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card-sp">
            <div class="card-header"><i class="bi bi-receipt me-2 text-primary"></i>Doanh thu dịch vụ ePort theo tháng</div>
            <div class="table-responsive">
                <table class="table table-sp">
                    <thead><tr><th>Tháng</th><th class="text-center">Số booking</th><th class="text-end">Doanh thu</th></tr></thead>
                    <tbody>
                        @{ List<SvcMonthRow> svcRows = ViewBag.SvcRows; int svcCount = 0; }
                        @foreach (var s in svcRows)
                        {
                            svcCount++;
                            <tr>
                                <td class="fw-semibold">Tháng @s.Thang/@year</td>
                                <td class="text-center">@s.SoBooking</td>
                                <td class="text-end">@Ui.Vnd(s.Tien)</td>
                            </tr>
                        }
                        @if (svcCount == 0)
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">Chưa có booking hoàn thành trong năm @year.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    var rpt = @Html.Raw(ViewBag.ChartJson);
    new Chart(document.getElementById('rptChart'), {
        data: {
            labels: rpt.labels,
            datasets: [
                { type: 'bar', label: 'TEU', data: rpt.teu, backgroundColor: '#1173c4', borderRadius: 6, yAxisID: 'y', maxBarThickness: 38 },
                { type: 'line', label: 'Doanh thu (tỷ đồng)', data: rpt.doanhthu, borderColor: '#ff7d2d', backgroundColor: '#ff7d2d', tension: .35, yAxisID: 'y1' }
            ]
        },
        options: {
            maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom' } },
            scales: {
                y: { position: 'left', grid: { color: '#eef2f7' }, title: { display: true, text: 'TEU' } },
                y1: { position: 'right', grid: { drawOnChartArea: false }, title: { display: true, text: 'Tỷ đồng' } }
            }
        }
    });
</script>
}
