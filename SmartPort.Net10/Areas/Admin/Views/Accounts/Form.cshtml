@model SmartPort.Models.TaiKhoan
@{
    ViewBag.Title = Model.MaTK == 0 ? "Tạo tài khoản" : "Sửa tài khoản " + Model.TenDangNhap;
    var roles = new List<SelectListItem>
    {
        new SelectListItem { Value = "Admin", Text = "Quản trị viên (Admin)" },
        new SelectListItem { Value = "NhanVien", Text = "Nhân viên khai thác" },
        new SelectListItem { Value = "KhachHang", Text = "Khách hàng" }
    };
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-sp">
            <div class="card-header"><i class="bi bi-person-gear me-2 text-primary"></i>@ViewBag.Title</div>
            <div class="p-4">
                @using (Html.BeginForm("Save", "Accounts", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.MaTK)
                    @Html.ValidationSummary(true)
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Tên đăng nhập <span class="text-danger">*</span></label>
                            @if (Model.MaTK == 0)
                            {
                                @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control" })
                            }
                            else
                            {
                                @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control", @readonly = "readonly" })
                            }
                            @Html.ValidationMessageFor(m => m.TenDangNhap)
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@(Model.MaTK == 0 ? "Mật khẩu (trống = 123456)" : "Mật khẩu mới (trống = giữ nguyên)")</label>
                            <input class="form-control" name="matKhauMoi" type="password" autocomplete="new-password" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Họ tên <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.HoTen)
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Vai trò</label>
                            @Html.DropDownListFor(m => m.VaiTro, roles, new { @class = "form-select", id = "roleSelect" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Số điện thoại</label>
                            @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control" })
                        </div>
                        <div class="col-md-8" id="khRow">
                            <label class="form-label">Khách hàng liên kết (với vai trò Khách hàng)</label>
                            @Html.DropDownListFor(m => m.MaKH, (SelectList)ViewBag.KhList, "— Chọn doanh nghiệp —", new { @class = "form-select" })
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                @Html.CheckBoxFor(m => m.KichHoat, new { @class = "form-check-input" })
                                <label class="form-check-label">Kích hoạt</label>
                            </div>
                        </div>
                        <div class="col-12 mt-4">
                            <button class="btn btn-accent px-4" type="submit"><i class="bi bi-save me-1"></i>Lưu</button>
                            <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Quay lại</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    (function () {
        var role = document.getElementById('roleSelect');
        var khRow = document.getElementById('khRow');
        function toggle() { khRow.style.display = role.value === 'KhachHang' ? '' : 'none'; }
        role.addEventListener('change', toggle);
        toggle();
    })();
</script>
}
