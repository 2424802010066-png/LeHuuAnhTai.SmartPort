@model SmartPort.Models.DichVu
@{
    ViewBag.Title = Model.MaDV == 0 ? "Thêm dịch vụ" : "Sửa dịch vụ " + Model.TenDV;
    string[] nhoms = { "Bốc xếp", "Lưu bãi", "Kho bãi", "Vận chuyển", "Khác" };
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-sp">
            <div class="card-header"><i class="bi bi-tools me-2 text-primary"></i>@ViewBag.Title</div>
            <div class="p-4">
                @using (Html.BeginForm("Save", "Services", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.MaDV)
                    @Html.ValidationSummary(true)
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Tên dịch vụ <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.TenDV, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.TenDV)
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Nhóm dịch vụ</label>
                            @Html.DropDownListFor(m => m.NhomDV, new SelectList(nhoms, Model.NhomDV), new { @class = "form-select" })
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Đơn vị tính</label>
                            @Html.TextBoxFor(m => m.DonViTinh, new { @class = "form-control", placeholder = "Cont / Tấn / Chuyến..." })
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Đơn giá (VNĐ)</label>
                            @Html.TextBoxFor(m => m.DonGia, new { @class = "form-control", type = "number", min = "0", step = "1000" })
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                @Html.CheckBoxFor(m => m.KichHoat, new { @class = "form-check-input" })
                                <label class="form-check-label">Đang cung cấp</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Mô tả</label>
                            @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = 3 })
                        </div>
                        <div class="col-12 mt-4">
                            <button class="btn btn-accent px-4" type="submit"><i class="bi bi-save me-1"></i>Lưu</button>
                            <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Quay lại</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
