@{
    ViewBag.Title = "Cổng thông minh — Nhận diện biển số (ALPR)";
    var ds = ViewBag.DanhSach as System.Collections.Generic.List<SmartPort.Models.XeRaVao>;
}

<div class="ai-box mb-3">
    <span class="ai-tag"><i class="bi bi-upc-scan"></i> SMARTGATE · ALPR — AUTOMATIC LICENSE PLATE RECOGNITION</span>
    <div class="row align-items-center mt-2">
        <div class="col-lg-9">
            <h5 class="fw-bold mb-1">Camera làn vào: AI đọc biển số xe tự động</h5>
            <div style="color:#c9dcef;font-size:.9rem;">
                Pipeline 3 tầng chạy ngay trên trình duyệt: <strong>YOLO26</strong> phát hiện phương tiện →
                <strong>CCT-S v2</strong> (model chuyên đọc biển số, huấn luyện trên biển 65 quốc gia gồm Việt Nam)
                đọc ký tự → <strong>Tesseract LSTM</strong> đọc lại độc lập để đối chiếu — 2 engine trùng nhau mới
                báo chắc chắn → chuẩn hóa định dạng biển số VN → lưu <strong>nhật ký ra/vào cổng</strong> phục vụ
                an ninh và đối soát.
            </div>
        </div>
        <div class="col-lg-3 text-lg-end mt-2 mt-lg-0">
            <span id="gsEngine" class="badge-st st-info"><i class="bi bi-hourglass-split me-1"></i>Đang khởi động...</span>
        </div>
    </div>
</div>

<!-- ===== Chi so hom nay ===== -->
<div class="row g-3 mb-3">
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#15803d,#22c55e);">
            <div class="ps-num" id="gsVao">@ViewBag.XeVaoHomNay</div>
            <div class="ps-lbl">Lượt xe VÀO hôm nay</div>
            <i class="bi bi-box-arrow-in-right"></i>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#c2410c,#fb923c);">
            <div class="ps-num" id="gsRa">@ViewBag.XeRaHomNay</div>
            <div class="ps-lbl">Lượt xe RA hôm nay</div>
            <i class="bi bi-box-arrow-right"></i>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#0a2f57,#1c5fa8);">
            <div class="ps-num">@ViewBag.DangTrongCang</div>
            <div class="ps-lbl">Xe đang trong cảng</div>
            <i class="bi bi-truck"></i>
        </div>
    </div>
    <div class="col-md-3 col-6 d-grid gap-2">
        <a class="btn btn-navy" href="@Url.Action("History")"><i class="bi bi-clock-history me-1"></i>Nhật ký đầy đủ</a>
        <a class="btn btn-outline-sp" href="@Url.Action("ExportExcel", new { ngay = 7 })"><i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel 7 ngày</a>
    </div>
</div>

<div class="row g-3">
    <!-- ============ CAMERA LAN VAO ============ -->
    <div class="col-lg-7">
        <div class="card-sp p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0" style="color:#0a2f57;"><i class="bi bi-camera-video me-1"></i>CAMERA LÀN VÀO</h6>
                <span class="badge bg-danger">● LIVE</span>
            </div>
            <div id="gsStatus" class="small mb-2 text-muted">Đang tải engine AI...</div>

            <div style="position:relative;border-radius:12px;overflow:hidden;background:#0b1520;min-height:280px;">
                <canvas id="gsCanvas" style="width:100%;display:block;"></canvas>
                <video id="gsVideo" playsinline muted style="width:100%;display:none;"></video>
            </div>

            <!-- Ket qua doc bien so -->
            <div id="gsPlateBox" class="gs-platebox mt-3" style="display:none;">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4 text-center">
                        <div class="small text-muted fw-semibold mb-1">ẢNH VÙNG BIỂN SỐ</div>
                        <img id="gsPlateCrop" alt="" style="max-width:100%;border-radius:8px;border:2px solid #22d3ee;" />
                    </div>
                    <div class="col-md-8">
                        <div id="gsLenhKq" class="mb-2" style="display:none;"></div>
                        <div class="small text-muted fw-semibold">BIỂN SỐ ĐỌC ĐƯỢC (sửa nếu AI đọc sai)</div>
                        <input id="gsPlateText" class="form-control form-control-lg gs-plate-input" maxlength="15" />
                        <div class="d-flex flex-wrap gap-2 mt-2 small align-items-center">
                            <span>Tin cậy OCR: <b id="gsPlateConf" class="text-primary">—</b></span>
                            <span class="d-flex align-items-center gap-1">
                                Loại xe:
                                <input id="gsPlateType" class="form-control form-control-sm" list="gsLoaiXeGoiY"
                                       maxlength="30" style="max-width:210px;" placeholder="AI đoán — sửa/nhập tự do" />
                            </span>
                        </div>
                        <datalist id="gsLoaiXeGoiY">
                            <option value="Đầu kéo container"></option>
                            <option value="Xe tải thùng"></option>
                            <option value="Rơ-moóc 20ft"></option>
                            <option value="Rơ-moóc 40ft"></option>
                            <option value="Xe bồn"></option>
                            <option value="Xe container lạnh"></option>
                            <option value="Xe nâng hàng"></option>
                            <option value="Xe cẩu"></option>
                            <option value="Xe ben"></option>
                            <option value="Xe khách"></option>
                            <option value="Ô tô con"></option>
                            <option value="Xe máy"></option>
                            <option value="Xe cứu hỏa"></option>
                            <option value="Xe cứu thương"></option>
                            <option value="Xe nội bộ cảng"></option>
                        </datalist>
                        <div class="d-flex gap-2 mt-2">
                            <select id="gsCong" class="form-select form-select-sm" style="max-width:110px;">
                                <option>A1</option><option>A2</option><option>B1</option>
                            </select>
                            <select id="gsHuong" class="form-select form-select-sm" style="max-width:110px;">
                                <option>Vào</option><option>Ra</option>
                            </select>
                            <button id="btnGsSave" class="btn btn-accent btn-sm flex-grow-1">
                                <i class="bi bi-save me-1"></i>Lưu vào nhật ký + mở barrier
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-sp p-3 mt-3">
            <h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-images me-1"></i>Nguồn hình ảnh</h6>
            <div class="row g-2">
                <div class="col-md-6">
                    <button class="btn btn-outline-primary w-100 gs-sample" disabled data-src="@Url.Content("~/Content/img/alpr-demo-1.png")?v=5">
                        <i class="bi bi-truck me-1"></i>Đầu kéo container (15C-274.84)
                    </button>
                </div>
                <div class="col-md-6">
                    <button class="btn btn-outline-primary w-100 gs-sample" disabled data-src="@Url.Content("~/Content/img/alpr-demo-2.png")?v=5">
                        <i class="bi bi-truck-front me-1"></i>Xe tải thùng (29C-468.28)
                    </button>
                </div>
                <div class="col-12">
                    <button class="btn btn-outline-warning w-100 gs-sample" disabled data-src="@Url.Content("~/Content/img/alpr-bienvang.png")?v=1">
                        <i class="bi bi-truck me-1"></i>Xe kinh doanh vận tải — <b>BIỂN NỀN VÀNG</b> (51C-638.72)
                    </button>
                </div>
                <div class="col-12">
                    <button class="btn btn-outline-danger w-100 gs-sample" disabled data-src="@Url.Content("~/Content/img/alpr-demo-mop.png")?v=1">
                        <i class="bi bi-exclamation-octagon me-1"></i>Container <b>MÓP MÉO vỏ</b> — soi ngoại quan (61H-529.30)
                    </button>
                </div>
                <div class="col-md-6">
                    <input type="file" id="fileInput" accept="image/*" class="form-control" disabled />
                </div>
                <div class="col-md-3">
                    <button id="btnCam" class="btn btn-navy w-100" disabled><i class="bi bi-camera-video me-1"></i>Bật camera làn vào</button>
                </div>
                <div class="col-md-3">
                    <button id="btnShot" class="btn btn-accent w-100" style="display:none;"><i class="bi bi-camera me-1"></i>Chụp &amp; đọc biển</button>
                </div>
            </div>
            <div class="small text-muted mt-2">
                💡 Mẹo demo: bấm ảnh mẫu để xem AI đọc biển tự động; hoặc bật camera rồi đưa
                <b>ảnh biển số in trên giấy / màn hình điện thoại</b> trước webcam và bấm Chụp.
            </div>
        </div>
    </div>

    <!-- ============ DANH SACH XE CONG (nhu he thong that) ============ -->
    <div class="col-lg-5">
        <div class="card-sp p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0" style="color:#0a2f57;"><i class="bi bi-list-check me-1"></i>DANH SÁCH XE CỔNG</h6>
                <span class="small text-muted">30 lượt gần nhất</span>
            </div>
            <div style="max-height:640px;overflow-y:auto;">
                <table class="table table-sm table-hover align-middle">
                    <thead style="position:sticky;top:0;background:var(--card);">
                        <tr class="small text-muted">
                            <th>#</th><th>ẢNH</th><th>BIỂN SỐ</th><th>CỔNG</th><th>HƯỚNG</th><th>DOCK</th><th>LOẠI XE</th><th>THỜI GIAN</th>
                        </tr>
                    </thead>
                    <tbody id="gsBody">
                        @if (ds != null)
                        {
                            var stt = 0;
                            foreach (var x in ds)
                            {
                                stt++;
                                <tr>
                                    <td class="text-muted">@stt</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(x.AnhXe))
                                        {
                                            <img src="@Url.Content(x.AnhXe)" class="gs-thumb" data-anh="@Url.Content(x.AnhXe)"
                                                 data-bien="@x.BienSo" title="Bấm để xem ảnh lớn" alt="Ảnh xe @x.BienSo" />
                                        }
                                        else
                                        {
                                            <span class="text-muted small" title="Lượt này không có ảnh">—</span>
                                        }
                                    </td>
                                    <td>
                                        <a class="gs-plate text-decoration-none" style="color:inherit;" href="@Url.Action("HoSoXe", "Gate", new { bienSo = x.BienSo })" title="Xem hồ sơ xe @x.BienSo">@x.BienSo</a>
                                        @if (!string.IsNullOrEmpty(x.SoCont))
                                        {
                                            <div>
                                                <a class="lk-cont" style="font-size:.7rem;" title="Hồ sơ container @x.SoCont"
                                                   href="@Url.Action("TraCuu", "Containers", new { so = x.SoCont })">
                                                    <i class="bi bi-box-seam"></i> @x.SoCont
                                                </a>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(x.GhiChu) && x.GhiChu.Contains("móp méo"))
                                        {
                                            <div><span class="badge bg-danger" style="font-size:.58rem;" title="@x.GhiChu">⚠ móp méo</span></div>
                                        }
                                    </td>
                                    <td>@x.Cong</td>
                                    <td><span class="badge @(x.HuongDi == "Vào" ? "bg-success" : "bg-warning text-dark")">@x.HuongDi</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(x.ViTriDo))
                                        {
                                            <span class="badge" style="background:#0d9488;">@x.ViTriDo</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="small">@(x.LoaiXe ?? "—")</td>
                                    <td class="small text-muted">@x.ThoiGian.ToString("HH:mm:ss dd/MM")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<canvas id="gsWork" style="display:none;"></canvas>

<!-- Cua so xem ANH XE kich thuoc lon -->
<div id="gsAnhOverlay" class="gs-anh-overlay" style="display:none;">
    <div class="gs-anh-hop" role="dialog" aria-label="Ảnh xe qua cổng">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 id="gsAnhTieuDe" class="fw-bold mb-0" style="color:#0a2f57;">Ảnh xe</h6>
            <button id="gsAnhDong" type="button" class="btn btn-sm btn-outline-secondary" title="Đóng (Esc)">✕</button>
        </div>
        <img id="gsAnhLon" alt="Ảnh xe qua cổng" />
        <div class="mt-2 d-flex gap-2 justify-content-end">
            <a id="gsAnhTai" class="btn btn-sm btn-outline-primary" href="#" download>
                <i class="bi bi-download me-1"></i>Tải ảnh về
            </a>
        </div>
    </div>
</div>

<style>
    .gs-thumb {
        width: 62px; height: 42px; object-fit: cover; border-radius: 6px;
        border: 2px solid #22d3ee; cursor: zoom-in; transition: transform .15s ease;
    }
    .gs-thumb:hover { transform: scale(1.12); box-shadow: 0 4px 14px rgba(34,211,238,.5); }
    .gs-anh-overlay {
        position: fixed; inset: 0; z-index: 1080; background: rgba(4,12,22,.82);
        display: flex; align-items: center; justify-content: center; padding: 18px;
        backdrop-filter: blur(3px);
    }
    .gs-anh-hop {
        background: var(--card, #fff); border-radius: 14px; padding: 14px;
        max-width: min(920px, 96vw); max-height: 92vh; overflow: auto;
        box-shadow: 0 22px 60px rgba(0,0,0,.5);
    }
    .gs-anh-hop img { max-width: 100%; max-height: 74vh; border-radius: 10px; display: block; }
</style>

<style>
    .gs-plate {
        display: inline-block; font-family: Consolas, 'Courier New', monospace;
        font-weight: 800; font-size: .92rem; letter-spacing: .5px;
        background: #fff; color: #0a0a0a; border: 2px solid #111;
        border-radius: 6px; padding: 1px 8px;
    }
    html[data-theme="dark"] .gs-plate { background: #f1f5f9; }
    .gs-platebox { border: 2px dashed #22d3ee; border-radius: 14px; padding: 14px 16px; background: rgba(34,211,238,.06); }
    .gs-plate-input {
        font-family: Consolas, 'Courier New', monospace; font-weight: 800; letter-spacing: 2px;
        text-transform: uppercase; text-align: center; border: 2px solid #111; border-radius: 10px;
        background: #fff; color: #0a0a0a;
    }
</style>

@section scripts {
<script src="@Url.Content("~/Scripts/alpr.js")?v=17"></script>
}
