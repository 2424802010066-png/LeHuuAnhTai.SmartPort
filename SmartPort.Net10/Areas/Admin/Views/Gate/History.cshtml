@model List<SmartPort.Models.XeRaVao>
@{
    ViewBag.Title = "Nhật ký xe ra/vào cổng";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h4 class="fw-bold mb-0" style="color:#0a2f57;"><i class="bi bi-clock-history me-2"></i>Nhật ký xe ra/vào cổng (ALPR)</h4>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-accent" href="@Url.Action("ExportExcel", new { ngay = ViewBag.Ngay })"><i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel</a>
        <a class="btn btn-sm btn-outline-sp" href="@Url.Action("Index")"><i class="bi bi-arrow-left me-1"></i>Về Cổng thông minh</a>
    </div>
</div>

<div class="card-sp p-3 mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold">Biển số</label>
            <input name="bienSo" class="form-control form-control-sm" value="@ViewBag.BienSo" placeholder="VD: 15C" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold">Hướng</label>
            <select name="huong" class="form-select form-select-sm">
                <option value="">— Tất cả —</option>
                <option value="Vào" @(ViewBag.Huong == "Vào" ? "selected" : "")>Vào</option>
                <option value="Ra" @(ViewBag.Huong == "Ra" ? "selected" : "")>Ra</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold">Cổng</label>
            <select name="cong" class="form-select form-select-sm">
                <option value="">— Tất cả —</option>
                <option @(ViewBag.Cong == "A1" ? "selected" : "")>A1</option>
                <option @(ViewBag.Cong == "A2" ? "selected" : "")>A2</option>
                <option @(ViewBag.Cong == "B1" ? "selected" : "")>B1</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold">Khoảng thời gian</label>
            <select name="ngay" class="form-select form-select-sm">
                @{ int ng = ViewBag.Ngay; }
                <option value="1" @(ng == 1 ? "selected" : "")>Hôm nay</option>
                <option value="7" @(ng == 7 ? "selected" : "")>7 ngày gần nhất</option>
                <option value="30" @(ng == 30 ? "selected" : "")>30 ngày gần nhất</option>
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-navy btn-sm w-100"><i class="bi bi-funnel me-1"></i>Lọc dữ liệu</button>
        </div>
    </form>
</div>

<div class="card-sp p-3">
    <div class="small text-muted mb-2">Tìm thấy <b>@Model.Count</b> lượt xe
        (Vào: <b class="text-success">@Model.Count(x => x.HuongDi == "Vào")</b> ·
         Ra: <b style="color:#c2410c;">@Model.Count(x => x.HuongDi == "Ra")</b>)</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr class="small text-muted">
                    <th>THỜI GIAN</th><th>ẢNH XE</th><th>BIỂN SỐ</th><th>CỔNG</th><th>HƯỚNG</th><th>LOẠI XE</th><th>TIN CẬY OCR</th><th>NGUỒN</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td class="small fw-semibold">@x.ThoiGian.ToString("HH:mm:ss dd/MM")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(x.AnhXe))
                            {
                                <a href="@Url.Content(x.AnhXe)" target="_blank" rel="noopener"
                                   title="Bấm để mở ảnh xe @x.BienSo ở tab mới">
                                    <img src="@Url.Content(x.AnhXe)" class="gs-thumb" alt="Ảnh xe @x.BienSo" />
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td><span class="gs-plate">@x.BienSo</span></td>
                        <td>@x.Cong</td>
                        <td><span class="badge @(x.HuongDi == "Vào" ? "bg-success" : "bg-warning text-dark")">@x.HuongDi</span></td>
                        <td class="small">@(x.LoaiXe ?? "—")</td>
                        <td class="small">@(x.DoTinCay.HasValue ? x.DoTinCay.Value + "%" : "—")</td>
                        <td class="small text-muted">@x.Nguon</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .gs-plate {
        display: inline-block; font-family: Consolas, 'Courier New', monospace;
        font-weight: 800; font-size: .92rem; letter-spacing: .5px;
        background: #fff; color: #0a0a0a; border: 2px solid #111;
        border-radius: 6px; padding: 1px 8px;
    }
    html[data-theme="dark"] .gs-plate { background: #f1f5f9; }
    .gs-thumb {
        width: 74px; height: 50px; object-fit: cover; border-radius: 6px;
        border: 2px solid #22d3ee; cursor: zoom-in; transition: transform .15s ease;
    }
    .gs-thumb:hover { transform: scale(1.15); box-shadow: 0 4px 14px rgba(34,211,238,.5); }
</style>
