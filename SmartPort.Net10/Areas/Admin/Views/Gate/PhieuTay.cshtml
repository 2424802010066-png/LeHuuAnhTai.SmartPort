@{
    Layout = null;
    var bienSo = ViewBag.BienSo as string ?? "";
    var huongDi = ViewBag.HuongDi as string ?? "Vào";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Phiếu ra vào cổng (ghi tay)</title>
    <style>
        /* PHIEU DU PHONG: in ra khi he thong/mang chet. Bao ve ghi tay, xe van
           qua cong binh thuong, nhap bu vao he thong sau. In duoc 2 lien tren
           1 to A5 ngang de dua tai xe 1 lien, giu lai 1 lien. */
        * { box-sizing: border-box; }
        body { margin: 0; font-family: 'Times New Roman', serif; color: #000; background: #f1f5f9; }
        .to { width: 190mm; margin: 10mm auto; background: #fff; padding: 8mm; }
        .lien { border: 2px solid #000; padding: 6mm; margin-bottom: 6mm; }
        .dau { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #000; padding-bottom: 3mm; }
        .dau h1 { font-size: 15pt; margin: 0; letter-spacing: 1px; }
        .dau .phu { font-size: 9pt; }
        .canhBao { background: #000; color: #fff; text-align: center; font-weight: bold; padding: 2mm; font-size: 10pt; letter-spacing: 1px; margin: 3mm 0; }
        table { width: 100%; border-collapse: collapse; font-size: 11pt; margin-top: 3mm; }
        td { border-bottom: 1px dotted #555; padding: 3.5mm 2mm; }
        td.nhan { width: 34%; color: #333; }
        .oTrong { display: inline-block; min-width: 55mm; border-bottom: 1px solid #000; }
        .to-lon { font-size: 16pt; font-weight: bold; letter-spacing: 2px; }
        .kyTen { display: flex; justify-content: space-between; margin-top: 6mm; font-size: 10pt; text-align: center; }
        .kyTen div { width: 45%; }
        .kyTen .cho { height: 16mm; }
        .nutIn { text-align: center; margin: 8mm 0; }
        .nutIn button { font-size: 13pt; padding: 10px 30px; border: 0; border-radius: 8px; background: #0a2f57; color: #fff; cursor: pointer; }
        .huongDan { max-width: 190mm; margin: 0 auto 10mm; font-size: 10pt; color: #334155; background: #fff; padding: 5mm; border-left: 4px solid #f59e0b; }
        @@media print {
            body { background: #fff; }
            .nutIn, .huongDan { display: none; }
            .to { margin: 0; width: auto; padding: 0; }
        }
    </style>
</head>
<body>
    <div class="nutIn">
        <button onclick="window.print()">🖨 IN PHIẾU (2 liên)</button>
    </div>

    <div class="huongDan">
        <b>Dùng khi nào:</b> hệ thống hoặc mạng chết mà xe vẫn phải qua cổng. Bảo vệ in phiếu này,
        ghi tay đầy đủ, đưa tài xế 1 liên và giữ lại 1 liên. Khi hệ thống chạy lại, nhập bù vào
        màn hình chốt cổng — <b>không được để kẹt xe vì phần mềm</b>.
    </div>

    <div class="to">
        @for (var i = 0; i < 2; i++)
        {
            <div class="lien">
                <div class="dau">
                    <div>
                        <h1>PHIẾU RA VÀO CỔNG</h1>
                        <div class="phu">SmartPort · Liên @(i + 1): @(i == 0 ? "Bảo vệ giữ" : "Giao tài xế")</div>
                    </div>
                    <div class="phu" style="text-align:right;">
                        Số phiếu: <span class="oTrong" style="min-width:30mm;"></span><br />
                        Ngày: @DateTime.Now.ToString("dd / MM / yyyy")
                    </div>
                </div>

                <div class="canhBao">PHIẾU DỰ PHÒNG — GHI TAY KHI HỆ THỐNG GIÁN ĐOẠN</div>

                <table>
                    <tr>
                        <td class="nhan">Biển số xe</td>
                        <td class="to-lon">@(string.IsNullOrEmpty(bienSo) ? "" : bienSo)<span class="oTrong"></span></td>
                    </tr>
                    <tr>
                        <td class="nhan">Hướng</td>
                        <td>
                            <b>@(huongDi == "Ra" ? "☐ VÀO&nbsp;&nbsp;&nbsp;☒ RA" : "☒ VÀO&nbsp;&nbsp;&nbsp;☐ RA")</b>
                        </td>
                    </tr>
                    <tr><td class="nhan">Giờ qua cổng</td><td><span class="oTrong" style="min-width:25mm;"></span> giờ <span class="oTrong" style="min-width:25mm;"></span> phút</td></tr>
                    <tr><td class="nhan">Số container</td><td><span class="oTrong"></span></td></tr>
                    <tr><td class="nhan">Số lệnh giao nhận</td><td><span class="oTrong"></span></td></tr>
                    <tr><td class="nhan">Tên tài xế / SĐT</td><td><span class="oTrong"></span></td></tr>
                    <tr><td class="nhan">Tình trạng vỏ</td><td>☐ Nguyên vẹn&nbsp;&nbsp;&nbsp;☐ Có hư hỏng: <span class="oTrong" style="min-width:35mm;"></span></td></tr>
                    <tr><td class="nhan">Ghi chú</td><td><span class="oTrong" style="min-width:90mm;"></span></td></tr>
                </table>

                <div class="kyTen">
                    <div>
                        <b>BẢO VỆ CỔNG</b><br />(ký, ghi rõ họ tên)
                        <div class="cho"></div>
                    </div>
                    <div>
                        <b>TÀI XẾ</b><br />(ký, ghi rõ họ tên)
                        <div class="cho"></div>
                    </div>
                </div>
            </div>
        }
    </div>

    <script>
        // Mo ra la in luon cho nhanh — bao ve dang voi
        setTimeout(function () { try { window.print(); } catch (e) { } }, 400);
    </script>
</body>
</html>
