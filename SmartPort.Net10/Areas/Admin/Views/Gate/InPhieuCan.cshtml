@model SmartPort.Models.PhieuCan
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@Model.SoPhieu — Phiếu cân</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: "Segoe UI", Arial, sans-serif; color: #111827; background: #eef2f6; padding: 24px; }
        .to { max-width: 620px; margin: 0 auto; background: #fff; border: 1px solid #cbd5e1; padding: 24px 28px; }
        .dau { display: flex; justify-content: space-between; border-bottom: 3px double #0a2f57; padding-bottom: 10px; }
        .dau h1 { font-size: 16px; color: #0a2f57; }
        .dau .ct { font-size: 11px; color: #475569; }
        h2 { text-align: center; font-size: 17px; margin: 14px 0 2px; color: #0a2f57; letter-spacing: 1px; }
        .en { text-align: center; font-size: 10.5px; color: #64748b; margin-bottom: 12px; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
        th, td { border: 1px solid #94a3b8; padding: 6px 9px; font-size: 12.5px; text-align: left; }
        th { background: #f1f5f9; width: 38%; font-weight: 600; color: #334155; }
        .tong td { background: #fffbeb; font-weight: 800; font-size: 15px; color: #b45309; }
        .kyten { display: flex; margin-top: 20px; text-align: center; }
        .kyten div { flex: 1; font-size: 12px; }
        .kyten b { display: block; margin-bottom: 48px; }
        .nutin { position: fixed; top: 14px; right: 16px; }
        .nutin button { background: #0d4f8b; color: #fff; border: 0; border-radius: 8px; padding: 9px 18px; font-weight: 700; cursor: pointer; }
        @@media print { body { background: #fff; padding: 0; } .to { border: 0; max-width: none; } .nutin { display: none; } }
    </style>
</head>
<body>
    <div class="nutin"><button onclick="window.print()">🖨 In phiếu</button></div>
    <div class="to">
        <div class="dau">
            <div>
                <h1>⚓ CẢNG QUỐC TẾ SMARTPORT</h1>
                <div class="ct">Trạm cân điện tử · Khu bến cảng Cát Lái, TP. Thủ Đức</div>
            </div>
            <div style="text-align:right;font-size:11.5px;">
                Số phiếu:<br /><b style="font-size:15px;font-family:Consolas,monospace;color:#b91c1c;">@Model.SoPhieu</b>
            </div>
        </div>

        <h2>PHIẾU CÂN XE</h2>
        <div class="en">WEIGHBRIDGE TICKET — phục vụ khai VGM (SOLAS)</div>

        <table>
            <tr><th>Biển số xe</th><td style="font-size:15px;font-weight:800;">@Model.BienSoXe</td></tr>
            <tr><th>Số container</th><td style="font-family:Consolas,monospace;">@(string.IsNullOrEmpty(Model.SoCont) ? "—" : Model.SoCont)</td></tr>
            <tr><th>Cân lần 1 (kg)</th><td>@Model.CanLan1.ToString("N1") — lúc @Model.Luc1.ToString("HH:mm dd/MM/yyyy")</td></tr>
            <tr><th>Cân lần 2 (kg)</th><td>@(Model.CanLan2 != null ? Model.CanLan2.Value.ToString("N1") + " — lúc " + Model.Luc2.Value.ToString("HH:mm dd/MM/yyyy") : "(chưa cân)")</td></tr>
            <tr class="tong"><th>KHỐI LƯỢNG HÀNG</th><td>@(Model.KhoiLuongHang != null ? Model.KhoiLuongHang.Value.ToString("N1") + " kg" : "— chưa chốt —")</td></tr>
            <tr><th>Người cân</th><td>@Model.NguoiCan</td></tr>
            @if (!string.IsNullOrEmpty(Model.GhiChu)) { <tr><th>Ghi chú</th><td>@Model.GhiChu</td></tr> }
        </table>

        <div class="kyten">
            <div><b>NHÂN VIÊN TRẠM CÂN</b><i style="color:#94a3b8;font-size:10.5px;">Ký, ghi rõ họ tên</i></div>
            <div><b>TÀI XẾ</b><i style="color:#94a3b8;font-size:10.5px;">Ký, ghi rõ họ tên</i></div>
        </div>
    </div>
</body>
</html>
