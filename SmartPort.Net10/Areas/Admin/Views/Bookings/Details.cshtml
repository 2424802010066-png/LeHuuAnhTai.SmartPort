@model SmartPort.Models.DatDichVu
@{
    ViewBag.Title = "Xử lý booking " + Model.MaSoBooking;
    List<DatDichVuChiTiet> chiTiets = ViewBag.ChiTiets;
    KhachHang kh = Model.KhachHang;
}
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card-sp mb-3">
            <div class="card-header"><i class="bi bi-list-check me-2 text-primary"></i>Dịch vụ trong booking @Model.MaSoBooking</div>
            <div class="table-responsive">
                <table class="table table-sp">
                    <thead>
                        <tr><th>Dịch vụ</th><th class="text-center">SL</th><th class="text-end">Đơn giá</th><th class="text-end">Thành tiền</th><th>Ghi chú</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var ct in chiTiets)
                        {
                            <tr>
                                <td>@(ct.DichVu != null ? ct.DichVu.TenDV : ("#" + ct.MaDV))</td>
                                <td class="text-center">@ct.SoLuong</td>
                                <td class="text-end">@Ui.Vnd(ct.DonGia)</td>
                                <td class="text-end fw-semibold">@Ui.Vnd(ct.ThanhTien)</td>
                                <td class="small text-muted">@ct.GhiChu</td>
                            </tr>
                        }
                        <tr class="table-light">
                            <td colspan="3" class="text-end fw-bold">TỔNG CỘNG</td>
                            <td class="text-end fw-bold fs-5" style="color:#e5691d;">@Ui.Vnd(Model.TongTien)</td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        @if (kh != null)
        {
            <div class="card-sp p-3">
                <h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-buildings me-2"></i>Khách hàng</h6>
                <div class="row g-2 small">
                    <div class="col-md-6"><span class="text-muted">Công ty:</span> <strong>@kh.TenCongTy</strong></div>
                    <div class="col-md-6"><span class="text-muted">MST:</span> @kh.MaSoThue</div>
                    <div class="col-md-6"><span class="text-muted">Người liên hệ:</span> @kh.NguoiLienHe</div>
                    <div class="col-md-6"><span class="text-muted">SĐT:</span> @kh.SoDienThoai — @kh.Email</div>
                </div>
            </div>
        }
    </div>
    <div class="col-lg-4">
        <div class="card-sp p-4">
            <h6 class="fw-bold mb-3" style="color:#0a2f57;">Trạng thái xử lý</h6>
            <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Hiện tại</span><span class="badge-st @Ui.Badge(Model.TrangThai)">@Model.TrangThai</span></div>
            <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Ngày tạo</span><strong>@Ui.Dt(Model.NgayTao)</strong></div>
            <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Cần thực hiện</span><strong>@Ui.D(Model.NgayCanThucHien)</strong></div>
            @if (!string.IsNullOrEmpty(Model.GhiChu))
            {
                <div class="py-2 border-bottom"><div class="text-muted small">Ghi chú của khách</div>@Model.GhiChu</div>
            }

            <div class="d-grid gap-2 mt-3">
                <a class="btn btn-success" href="@Url.Action("ExportInvoice", new { id = Model.MaBooking })">
                    <i class="bi bi-file-earmark-excel me-1"></i>Xuất hóa đơn Excel (.xlsx)
                </a>
                <a class="btn btn-danger" target="_blank" href="@Url.Action("InvoicePrint", new { id = Model.MaBooking })">
                    <i class="bi bi-file-earmark-pdf me-1"></i>Hóa đơn PDF (in / lưu)
                </a>
                @using (Html.BeginForm("SendEmail", "Bookings", new { id = Model.MaBooking }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-primary w-100" type="submit" title="Gửi tới @(kh != null ? kh.Email : "email khách hàng")">
                        <i class="bi bi-envelope-arrow-up me-1"></i>Gửi hóa đơn qua email KH
                    </button>
                }
                @if (Model.TrangThai == "Chờ duyệt")
                {
                    using (Html.BeginForm("SetStatus", "Bookings", new { id = Model.MaBooking, status = "Đã duyệt" }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button class="btn btn-navy w-100" type="submit"><i class="bi bi-check2-circle me-1"></i>Duyệt booking</button>
                    }
                    using (Html.BeginForm("SetStatus", "Bookings", new { id = Model.MaBooking, status = "Đã hủy" }, FormMethod.Post, null, new { onsubmit = "return confirm('Từ chối booking này?');" }))
                    {
                        @Html.AntiForgeryToken()
                        <button class="btn btn-outline-danger w-100" type="submit"><i class="bi bi-x-circle me-1"></i>Từ chối</button>
                    }
                }
                @if (Model.TrangThai == "Đã duyệt")
                {
                    using (Html.BeginForm("SetStatus", "Bookings", new { id = Model.MaBooking, status = "Đang thực hiện" }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button class="btn btn-navy w-100" type="submit"><i class="bi bi-play-circle me-1"></i>Bắt đầu thực hiện</button>
                    }
                }
                @if (Model.TrangThai == "Đang thực hiện")
                {
                    using (Html.BeginForm("SetStatus", "Bookings", new { id = Model.MaBooking, status = "Hoàn thành" }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button class="btn btn-accent w-100" type="submit"><i class="bi bi-flag-fill me-1"></i>Hoàn thành</button>
                    }
                }
                <a class="btn btn-outline-secondary w-100" href="@Url.Action("Index")"><i class="bi bi-arrow-left me-1"></i>Danh sách booking</a>
            </div>
        </div>
    </div>
</div>
