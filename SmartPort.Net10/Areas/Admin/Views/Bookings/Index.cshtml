@model List<SmartPort.Models.DatDichVu>
@{
    ViewBag.Title = "Đơn đặt dịch vụ";
    string cur = ViewBag.TrangThai as string;
    string[] statuses = { "Chờ duyệt", "Đã duyệt", "Đang thực hiện", "Hoàn thành", "Đã hủy" };
}
<div class="card-sp">
    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <span><i class="bi bi-receipt-cutoff me-2 text-primary"></i>Danh sách booking</span>
        <form method="get">
            <select name="trangThai" class="form-select form-select-sm" style="width:190px;" onchange="this.form.submit()">
                <option value="">— Tất cả trạng thái —</option>
                @foreach (var s in statuses)
                {
                    <option value="@s" @(s == cur ? "selected" : "")>@s</option>
                }
            </select>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-sp">
            <thead>
                <tr><th>Số booking</th><th>Khách hàng</th><th>Ngày tạo</th><th>Ngày thực hiện</th><th class="text-end">Tổng tiền</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Không có booking nào.</td></tr>
                }
                @foreach (var b in Model)
                {
                    <tr>
                        <td class="fw-semibold">@b.MaSoBooking</td>
                        <td>@(b.KhachHang != null ? b.KhachHang.TenCongTy : "—")</td>
                        <td>@Ui.Dt(b.NgayTao)</td>
                        <td>@Ui.D(b.NgayCanThucHien)</td>
                        <td class="text-end fw-semibold">@Ui.Vnd(b.TongTien)</td>
                        <td><span class="badge-st @Ui.Badge(b.TrangThai)">@b.TrangThai</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", new { id = b.MaBooking })"><i class="bi bi-eye"></i> Xử lý</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
