@model List<SmartPort.Models.ChuyenTau>
@{
    ViewBag.Title = "Điều độ chuyến tàu";
    string cur = ViewBag.TrangThai as string;
    string[] statuses = { "Dự kiến", "Đã cập bến", "Đang làm hàng", "Đã rời bến", "Hủy" };
}
<div class="card-sp">
    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <form method="get" class="d-flex gap-2 align-items-center">
            <select name="trangThai" class="form-select form-select-sm" style="width:190px;" onchange="this.form.submit()">
                <option value="">— Tất cả trạng thái —</option>
                @foreach (var s in statuses)
                {
                    <option value="@s" @(s == cur ? "selected" : "")>@s</option>
                }
            </select>
        </form>
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-navy" href="@Url.Action("Berth", "AiTools")"><i class="bi bi-stars me-1"></i>AI phân bổ bến</a>
            <a class="btn btn-sm btn-accent" href="@Url.Action("Form")"><i class="bi bi-plus-lg me-1"></i>Thêm chuyến</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-sp">
            <thead>
                <tr><th>Chuyến</th><th>Tàu</th><th>Bến</th><th>ETA / ATA</th><th>ETD / ATD</th><th class="text-center">Cont N/X</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Không có chuyến nào.</td></tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.MaChuyenHieu</td>
                        <td>@(c.Tau != null ? c.Tau.TenTau : "—")</td>
                        <td>
                            @if (c.Ben != null)
                            {
                                @c.Ben.TenBen
                            }
                            else if (c.TrangThai == "Dự kiến")
                            {
                                <span class="badge-st st-warn">Chưa phân bến</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td>
                            <div>@Ui.Dt(c.ETA)</div>
                            @if (c.ATA.HasValue)
                            {
                                <div class="text-success small"><i class="bi bi-check2"></i> @Ui.Dt(c.ATA)</div>
                            }
                        </td>
                        <td>
                            <div>@Ui.Dt(c.ETD)</div>
                            @if (c.ATD.HasValue)
                            {
                                <div class="text-success small"><i class="bi bi-check2"></i> @Ui.Dt(c.ATD)</div>
                            }
                        </td>
                        <td class="text-center">@c.ContNhap / @c.ContXuat</td>
                        <td><span class="badge-st @Ui.Badge(c.TrangThai)">@c.TrangThai</span></td>
                        <td class="text-end" style="white-space:nowrap;">
                            @if (c.TrangThai == "Dự kiến")
                            {
                                using (Html.BeginForm("UpdateStatus", "VesselCalls", new { id = c.MaChuyen, act = "capben" }, FormMethod.Post, null, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-info" type="submit" title="Xác nhận tàu cập bến"><i class="bi bi-box-arrow-in-down"></i> Cập bến</button>
                                }
                            }
                            @if (c.TrangThai == "Đã cập bến")
                            {
                                using (Html.BeginForm("UpdateStatus", "VesselCalls", new { id = c.MaChuyen, act = "lamhang" }, FormMethod.Post, null, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-info" type="submit" title="Bắt đầu làm hàng"><i class="bi bi-boxes"></i> Làm hàng</button>
                                }
                            }
                            @if (c.TrangThai == "Đang làm hàng" || c.TrangThai == "Đã cập bến")
                            {
                                using (Html.BeginForm("UpdateStatus", "VesselCalls", new { id = c.MaChuyen, act = "roiben" }, FormMethod.Post, null, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-success" type="submit" title="Tàu rời bến"><i class="bi bi-box-arrow-up"></i> Rời bến</button>
                                }
                            }
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Form", new { id = c.MaChuyen })"><i class="bi bi-pencil"></i></a>
                            @using (Html.BeginForm("Delete", "VesselCalls", new { id = c.MaChuyen }, FormMethod.Post, null, new { @class = "d-inline", onsubmit = "return confirm('Xóa chuyến " + c.MaChuyenHieu + "?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
