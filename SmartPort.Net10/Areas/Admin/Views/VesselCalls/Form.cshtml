@model SmartPort.Models.ChuyenTau
@{
    ViewBag.Title = Model.MaChuyen == 0 ? "Thêm chuyến tàu" : "Sửa chuyến " + Model.MaChuyenHieu;
    string[] statuses = { "Dự kiến", "Đã cập bến", "Đang làm hàng", "Đã rời bến", "Hủy" };
}
<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card-sp">
            <div class="card-header"><i class="bi bi-calendar2-week me-2 text-primary"></i>@ViewBag.Title</div>
            <div class="p-4">
                @using (Html.BeginForm("Save", "VesselCalls", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.MaChuyen)
                    @Html.ValidationSummary(true)
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Mã chuyến <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.MaChuyenHieu, new { @class = "form-control", placeholder = "VD: MSCU-2609N" })
                            @Html.ValidationMessageFor(m => m.MaChuyenHieu)
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tàu <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.MaTau, (SelectList)ViewBag.TauList, "— Chọn tàu —", new { @class = "form-select" })
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Bến (có thể dùng <a href="@Url.Action("Berth", "AiTools")">AI gợi ý</a>)</label>
                            @Html.DropDownListFor(m => m.MaBen, (SelectList)ViewBag.BenList, "— Chưa phân bến —", new { @class = "form-select" })
                            @Html.ValidationMessageFor(m => m.MaBen)
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">ETA (dự kiến đến)</label>
                            @Html.TextBoxFor(m => m.ETA, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">ETD (dự kiến rời)</label>
                            @Html.TextBoxFor(m => m.ETD, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                            @Html.ValidationMessageFor(m => m.ETD)
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">ATA (thực tế đến)</label>
                            @Html.TextBoxFor(m => m.ATA, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">ATD (thực tế rời)</label>
                            @Html.TextBoxFor(m => m.ATD, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Trạng thái</label>
                            @Html.DropDownListFor(m => m.TrangThai, new SelectList(statuses, Model.TrangThai), new { @class = "form-select" })
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Container nhập</label>
                            @Html.TextBoxFor(m => m.ContNhap, new { @class = "form-control", type = "number", min = "0" })
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Container xuất</label>
                            @Html.TextBoxFor(m => m.ContXuat, new { @class = "form-control", type = "number", min = "0" })
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Ghi chú</label>
                            @Html.TextBoxFor(m => m.GhiChu, new { @class = "form-control" })
                        </div>
                        <div class="col-12 mt-4">
                            <button class="btn btn-accent px-4" type="submit"><i class="bi bi-save me-1"></i>Lưu chuyến</button>
                            <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Quay lại</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
