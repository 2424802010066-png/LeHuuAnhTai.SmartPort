@model List<SmartPort.Models.ChungTu>
@{
    ViewBag.Title = "Kho chứng từ số";
    var theoLoai = ViewBag.TheoLoai as Dictionary<string, int>;
}

<div class="ai-box mb-3">
    <span class="ai-tag"><i class="bi bi-archive-fill"></i> KHO CHỨNG TỪ SỐ · DOCUMENT ARCHIVE</span>
    <div style="color:#c9dcef;font-size:.9rem;" class="mt-2">
        Tủ hồ sơ số của cảng: mọi <strong>phiếu EIR, phiếu cân, lệnh giao nhận</strong>... phát sinh đều được
        <strong>ghi sổ tự động</strong> tại đây — tra cứu theo loại/container/biển số/ngày và <strong>mở lại bản in</strong>
        bất kỳ lúc nào. Thay thế hoàn toàn tủ kẹp giấy tờ truyền thống.
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#0a2f57,#1c5fa8);">
            <div class="ps-num">@ViewBag.TongSo</div><div class="ps-lbl">Tổng chứng từ lưu trữ</div><i class="bi bi-archive"></i>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#15803d,#22c55e);">
            <div class="ps-num">@ViewBag.HomNay</div><div class="ps-lbl">Phát sinh hôm nay</div><i class="bi bi-calendar-plus"></i>
        </div>
    </div>
    <div class="col-md-6 col-12 d-flex align-items-center flex-wrap gap-2">
        @if (theoLoai != null)
        {
            foreach (var kv in theoLoai)
            {
                <span class="badge bg-secondary">@kv.Key: @kv.Value</span>
            }
        }
    </div>
</div>

@if (TempData["ThongBao"] != null) { <div class="alert alert-success py-2">@TempData["ThongBao"]</div> }
@if (TempData["Loi"] != null) { <div class="alert alert-danger py-2">@TempData["Loi"]</div> }

<div class="card-sp p-3">
    <div class="d-flex justify-content-end mb-2">
        @using (Html.BeginForm("KiemTra", "Docs", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button class="btn btn-sm btn-outline-sp" type="submit" title="Tính lại SHA-256 toàn bộ sổ và đối chiếu chuỗi liên kết — mô hình eB/L của hãng tàu">
                <i class="bi bi-link-45deg me-1"></i>⛓ Kiểm tra toàn vẹn chuỗi khối
            </button>
        }
    </div>
    <form class="d-flex flex-wrap gap-2 mb-2" method="get">
        <select name="loai" class="form-select form-select-sm" style="max-width:170px;">
            <option value="">— Mọi loại —</option>
            @foreach (var t in new[] { "EIR", "PhieuCan", "LenhGiaoNhan", "HoaDon" })
            {
                <option value="@t" @(ViewBag.Loai as string == t ? "selected" : "")>@t</option>
            }
        </select>
        <input name="q" value="@ViewBag.Q" class="form-control form-control-sm" placeholder="Số chứng từ / container / biển số..." style="max-width:240px;" />
        <input type="date" name="tuNgay" class="form-control form-control-sm" style="max-width:160px;" value="@(ViewBag.TuNgay != null ? ((DateTime)ViewBag.TuNgay).ToString("yyyy-MM-dd") : "")" />
        <input type="date" name="denNgay" class="form-control form-control-sm" style="max-width:160px;" value="@(ViewBag.DenNgay != null ? ((DateTime)ViewBag.DenNgay).ToString("yyyy-MM-dd") : "")" />
        <button class="btn btn-sm btn-navy" type="submit"><i class="bi bi-search me-1"></i>Tra cứu</button>
    </form>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead><tr class="small text-muted"><th>SỐ CHỨNG TỪ</th><th>LOẠI</th><th>CONTAINER</th><th>BIỂN SỐ</th><th>KHÁCH HÀNG</th><th>MÔ TẢ</th><th>NGƯỜI LẬP</th><th>NGÀY LẬP</th><th>HASH ⛓</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="10" class="text-center text-muted py-4">Chưa có chứng từ khớp bộ lọc.</td></tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-bold" style="font-family:Consolas,monospace;">@c.SoChungTu</td>
                        <td><span class="badge @(c.LoaiCT == "EIR" ? "bg-primary" : c.LoaiCT == "PhieuCan" ? "bg-info text-dark" : c.LoaiCT == "LenhGiaoNhan" ? "bg-warning text-dark" : "bg-secondary")">@c.TenLoai</span></td>
                        <td class="small" style="font-family:Consolas,monospace;">
                            @if (string.IsNullOrEmpty(c.SoCont)) { <text>—</text> }
                            else { <a class="lk-cont" href="@Url.Action("TraCuu", "Containers", new { so = c.SoCont })">@c.SoCont</a> }
                        </td>
                        <td class="small">
                            @if (string.IsNullOrEmpty(c.BienSoXe)) { <text>—</text> }
                            else { <a class="lk-xe" href="@Url.Action("HoSoXe", "Gate", new { bienSo = c.BienSoXe })">@c.BienSoXe</a> }
                        </td>
                        <td class="small">@(c.KhachHang != null ? c.KhachHang.TenCongTy : "—")</td>
                        <td class="small text-muted">@c.MoTa</td>
                        <td class="small">@c.NguoiLap</td>
                        <td class="small text-nowrap">@c.NgayLap.ToString("HH:mm dd/MM/yy")</td>
                        <td class="small" style="font-family:Consolas,monospace;" title="@c.HashSHA256">@(string.IsNullOrEmpty(c.HashSHA256) ? "—" : c.HashSHA256.Substring(0, 10) + "…")</td>
                        <td class="text-end">
                            @if (!string.IsNullOrEmpty(c.LienKet))
                            {
                                <a class="btn btn-sm btn-outline-sp" target="_blank" href="@Url.Content("~" + c.LienKet)" title="Mở bản in"><i class="bi bi-printer"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
