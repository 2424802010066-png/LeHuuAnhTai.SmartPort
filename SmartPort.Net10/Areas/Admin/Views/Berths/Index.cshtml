@model List<SmartPort.Models.Ben>
@{
    ViewBag.Title = "Quản lý bến cảng";
    List<ChuyenTau> dangCap = ViewBag.DangCap;
}

<div class="card-sp mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-broadcast me-2 text-primary"></i>Sơ đồ cầu bến trực quan — thời gian thực</span>
        <span class="badge-st st-run">LIVE</span>
    </div>
    <div class="p-3">
        <div class="quay-wrap">
            <div class="quay-line">
                @foreach (var b in Model)
                {
                    ChuyenTau chiemB = dangCap.FirstOrDefault(c => c.MaBen == b.MaBen);
                    string state = b.TrangThai != "Hoạt động" ? "maint" : (chiemB != null ? "busy" : "free");
                    <div class="quay-berth @state">
                        <div class="quay-ship">
                            @if (chiemB != null)
                            {
                                <svg width="112" height="52" viewBox="0 0 112 52" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M6 34 L106 34 L96 50 L16 50 Z" fill="#123c66" />
                                    <rect x="84" y="16" width="14" height="18" rx="2" fill="#e9eef5" />
                                    <rect x="14" y="24" width="20" height="9" rx="1" fill="#ff7d2d" />
                                    <rect x="36" y="24" width="20" height="9" rx="1" fill="#22d3ee" />
                                    <rect x="58" y="24" width="20" height="9" rx="1" fill="#10b981" />
                                    <rect x="25" y="14" width="20" height="9" rx="1" fill="#f59e0b" />
                                </svg>
                            }
                        </div>
                        <div class="quay-deck">
                            <div class="qb-name">@b.TenBen</div>
                            <div class="qb-sub">@Ui.Num(b.ChieuDai)m · @Ui.Num(b.DoSau)m · @b.SoCau cẩu</div>
                            @if (state == "busy" && chiemB != null)
                            {
                                <span class="quay-status" title="@chiemB.MaChuyenHieu">⚓ @(chiemB.Tau != null ? chiemB.Tau.TenTau : "")</span>
                            }
                            else if (state == "maint")
                            {
                                <span class="quay-status">🔧 Bảo trì</span>
                            }
                            else
                            {
                                <span class="quay-status">✓ Sẵn sàng</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    @foreach (var b in Model)
    {
        ChuyenTau chiem = dangCap.FirstOrDefault(c => c.MaBen == b.MaBen);
        <div class="col-md-6 col-xl-4">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="d-flex gap-3 align-items-center">
                        <div class="ico @(b.TrangThai == "Hoạt động" ? (chiem != null ? "ico-cyan" : "ico-green") : "ico-orange")"><i class="bi bi-bounding-box"></i></div>
                        <div>
                            <div class="fw-bold fs-5">@b.TenBen</div>
                            <span class="badge-st @Ui.Badge(b.TrangThai)">@b.TrangThai</span>
                        </div>
                    </div>
                    <div>
                        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Form", new { id = b.MaBen })"><i class="bi bi-pencil"></i></a>
                        @using (Html.BeginForm("Delete", "Berths", new { id = b.MaBen }, FormMethod.Post, null, new { @class = "d-inline", onsubmit = "return confirm('Xóa " + b.TenBen + "?');" }))
                        {
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
                        }
                    </div>
                </div>
                <div class="row text-center mt-3 g-2">
                    <div class="col-4"><div class="fw-bold">@Ui.Num(b.ChieuDai) m</div><div class="text-muted small">Chiều dài</div></div>
                    <div class="col-4"><div class="fw-bold">@Ui.Num(b.DoSau) m</div><div class="text-muted small">Độ sâu</div></div>
                    <div class="col-4"><div class="fw-bold">@b.SoCau</div><div class="text-muted small">Cẩu bờ</div></div>
                </div>
                <div class="mt-3 pt-2 border-top small">
                    @if (chiem != null)
                    {
                        <i class="bi bi-water text-info me-1"></i><strong>@(chiem.Tau != null ? chiem.Tau.TenTau : "")</strong> <span class="text-muted">— chuyến @chiem.MaChuyenHieu đang làm hàng</span>
                    }
                    else if (b.TrangThai == "Hoạt động")
                    {
                        <i class="bi bi-check2-circle text-success me-1"></i><span class="text-muted">Bến trống — sẵn sàng tiếp nhận tàu</span>
                    }
                    else
                    {
                        <i class="bi bi-cone-striped text-warning me-1"></i><span class="text-muted">@b.MoTa</span>
                    }
                </div>
            </div>
        </div>
    }
</div>
<a class="btn btn-accent" href="@Url.Action("Form")"><i class="bi bi-plus-lg me-1"></i>Thêm bến mới</a>
