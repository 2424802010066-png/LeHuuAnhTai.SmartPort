@model List<SmartPort.Models.Ben>
@using SmartPort.Models
@{
    ViewBag.Title = "Gantt cầu bến";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    DateTime tu = ViewBag.Tu, den = ViewBag.Den;
    var chuyens = ViewBag.Chuyens as List<ChuyenTau>;
    var xungDot = ViewBag.XungDot as HashSet<int>;
    var canhBao = ViewBag.CanhBao as List<string>;
    var tongPhut = (den - tu).TotalMinutes;
    var soNgay = (int)(den - tu).TotalDays;
    var nowPct = ((DateTime.Now - tu).TotalMinutes / tongPhut * 100).ToString("0.##", inv);
    var luc = DateTime.Now;
    Func<ChuyenTau, DateTime> batDau = c => SmartPort.Areas.Admin.Controllers.BerthsController.BatDauBen(c);
    Func<ChuyenTau, DateTime> ketThuc = c => SmartPort.Areas.Admin.Controllers.BerthsController.KetThucBen(c, luc);
    Func<ChuyenTau, bool> quaHan = c => c.ATA != null && c.ATD == null && c.ETD < luc;
}

<div class="ai-box mb-3" style="background:linear-gradient(120deg,#1e3a5f,#0a2f57);">
    <span class="ai-tag"><i class="bi bi-bar-chart-steps"></i> GANTT CẦU BẾN · BERTH PLANNING</span>
    <div style="color:#dbeafe;font-size:.9rem;" class="mt-2">
        Màn hình điều độ chuẩn TOS thương mại (CATOS/TOPX tại Cát Lái, Lạch Huyện): mỗi hàng = 1 cầu bến,
        mỗi thanh = 1 chuyến tàu chiếm bến từ <strong>ATA/ETA → ATD/ETD</strong>. Hệ thống tự phát hiện
        <span class="badge bg-danger">TRÙNG LỊCH</span> khi 2 tàu đăng ký cùng bến chồng giờ nhau.
    </div>
</div>

@if (canhBao != null && canhBao.Count > 0)
{
    <div class="alert alert-danger py-2">
        <div class="fw-bold"><i class="bi bi-exclamation-octagon me-1"></i>PHÁT HIỆN @canhBao.Count XUNG ĐỘT LỊCH CẦU BẾN — điều độ cần xử lý:</div>
        @foreach (var cb in canhBao)
        {
            <div class="small mt-1">• @cb</div>
        }
    </div>
}
else
{
    <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>Không có xung đột lịch cầu bến trong cửa sổ @soNgay ngày.</div>
}

<div class="card-sp p-3">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <h6 class="fw-bold mb-0" style="color:#0a2f57;"><i class="bi bi-calendar3-week me-1"></i>@tu.ToString("dd/MM") → @den.AddDays(-1).ToString("dd/MM") (@soNgay ngày)</h6>
        <div class="small">
            <span class="badge" style="background:#16a34a;">Đang làm hàng</span>
            <span class="badge" style="background:#2563eb;">Kế hoạch</span>
            <span class="badge" style="background:#64748b;">Đã rời bến</span>
            <span class="badge" style="background:#b45309;">TRỄ · quá hạn ETD chưa rời</span>
            <span class="badge bg-danger">⚠ Trùng lịch</span>
            <a class="btn btn-sm btn-outline-sp ms-2" href="@Url.Action("Index")"><i class="bi bi-diagram-3 me-1"></i>Sơ đồ bến trực quan</a>
        </div>
    </div>

    <div style="overflow-x:auto;">
        <div style="min-width:980px;">
            <!-- Hang tieu de ngay -->
            <div class="d-flex" style="margin-left:130px;">
                @for (var d = 0; d < soNgay; d++)
                {
                    var ngay = tu.AddDays(d);
                    var cuoiTuan = ngay.DayOfWeek == DayOfWeek.Saturday || ngay.DayOfWeek == DayOfWeek.Sunday;
                    <div class="text-center small @(ngay.Date == DateTime.Today ? "fw-bold text-primary" : "text-muted")"
                         style="flex:1;border-left:1px solid rgba(100,116,139,.25);@(cuoiTuan ? "background:rgba(100,116,139,.08);" : "")">
                        @ngay.ToString("dd/MM")<br /><span style="font-size:.62rem;">@("CN,T2,T3,T4,T5,T6,T7".Split(',')[(int)ngay.DayOfWeek])</span>
                    </div>
                }
            </div>

            @{
                var nhomBen = new List<object[]>();
                foreach (var b in Model) { nhomBen.Add(new object[] { b.TenBen, b.MaBen, b.SoCau }); }
                nhomBen.Add(new object[] { "Chưa phân bến", (int?)null, 0 });
            }
            @foreach (var nb in nhomBen)
            {
                var tenBen = (string)nb[0];
                var maBen = nb[1] as int?;
                var cuaBen = chuyens.Where(c => (maBen == null && c.MaBen == null) || (maBen != null && c.MaBen == maBen)).ToList();
                if (maBen == null && cuaBen.Count == 0) { continue; }
                <div class="d-flex align-items-stretch" style="border-top:1px solid rgba(100,116,139,.2);min-height:52px;">
                    <div class="small fw-semibold d-flex flex-column justify-content-center" style="width:130px;flex:none;color:#0a2f57;">
                        @if (maBen == null) { <span class="text-warning">⚠ @tenBen</span> }
                        else { <span>⚓ @tenBen</span><span class="text-muted" style="font-size:.65rem;">@nb[2] cẩu bờ</span> }
                    </div>
                    <div class="position-relative" style="flex:1;background:repeating-linear-gradient(90deg, rgba(100,116,139,.14) 0, rgba(100,116,139,.14) 1px, transparent 1px, transparent calc(100%/@soNgay));">
                        <div class="position-absolute" style="left:@(nowPct)%;top:0;bottom:0;width:2px;background:#dc2626;z-index:3;"></div>
                        @foreach (var c in cuaBen)
                        {
                            var bd = batDau(c) < tu ? tu : batDau(c);
                            var kt = ketThuc(c) > den ? den : ketThuc(c);
                            if (kt <= bd) { continue; }
                            var left = ((bd - tu).TotalMinutes / tongPhut * 100);
                            var width = ((kt - bd).TotalMinutes / tongPhut * 100);
                            var mau = c.ATD != null ? "#64748b" : quaHan(c) ? "#b45309" : (c.ATA != null ? "#16a34a" : "#2563eb");
                            var trung = xungDot != null && xungDot.Contains(c.MaChuyen);
                            <div class="position-absolute text-white small text-truncate"
                                 style="left:@(left.ToString("0.##", inv))%;width:@(Math.Max(width, 1.6).ToString("0.##", inv))%;top:7px;height:36px;background:@mau;border-radius:6px;padding:2px 8px;line-height:1.15;z-index:2;@(trung ? "outline:2px solid #dc2626;outline-offset:1px;" : "")"
                                 title="@c.MaChuyenHieu · @(c.Tau != null ? c.Tau.TenTau : "?") — @batDau(c).ToString("HH:mm dd/MM") → @ketThuc(c).ToString("HH:mm dd/MM") · nhập @c.ContNhap / xuất @c.ContXuat cont · @c.TrangThai">
                                <span class="fw-bold" style="font-size:.68rem;">@(trung ? "⚠ " : "")@c.MaChuyenHieu@(quaHan(c) ? " · TRỄ" : "")</span><br />
                                <span style="font-size:.62rem;opacity:.9;">@(c.Tau != null ? c.Tau.TenTau : "")</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="small text-muted mt-2">
        💡 Vạch đỏ dọc = thời điểm hiện tại. Tàu "Chưa phân bến" cần được điều độ gán bến ở
        <a href="@Url.Action("Index", "VesselCalls")">Chuyến tàu</a> trước khi cập cảng.
    </div>
</div>
