@model SmartPort.Models.Ben
@{
    ViewBag.Title = Model.MaBen == 0 ? "Thêm bến mới" : "Sửa " + Model.TenBen;
    string[] trangThais = { "Hoạt động", "Bảo trì" };
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-sp">
            <div class="card-header"><i class="bi bi-bounding-box me-2 text-primary"></i>@ViewBag.Title</div>
            <div class="p-4">
                @using (Html.BeginForm("Save", "Berths", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.MaBen)
                    @Html.ValidationSummary(true)
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Tên bến <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.TenBen, new { @class = "form-control", placeholder = "VD: Bến B7" })
                            @Html.ValidationMessageFor(m => m.TenBen)
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Trạng thái</label>
                            @Html.DropDownListFor(m => m.TrangThai, new SelectList(trangThais, Model.TrangThai), new { @class = "form-select" })
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Chiều dài (m)</label>
                            @Html.TextBoxFor(m => m.ChieuDai, new { @class = "form-control", type = "number", step = "0.1", min = "0" })
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Độ sâu (m)</label>
                            @Html.TextBoxFor(m => m.DoSau, new { @class = "form-control", type = "number", step = "0.1", min = "0" })
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Số cẩu bờ</label>
                            @Html.TextBoxFor(m => m.SoCau, new { @class = "form-control", type = "number", min = "0" })
                        </div>
                        <div class="col-12">
                            <label class="form-label">Mô tả / công năng</label>
                            @Html.TextBoxFor(m => m.MoTa, new { @class = "form-control" })
                        </div>
                        <div class="col-12 mt-4">
                            <button class="btn btn-accent px-4" type="submit"><i class="bi bi-save me-1"></i>Lưu</button>
                            <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Quay lại</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
