@model SmartPort.Models.AgentReport
@{
    ViewBag.Title = "AI Agent điều phối cảng";
}

<div class="ai-box mb-3">
    <span class="ai-tag"><i class="bi bi-robot"></i> AUTONOMOUS AI AGENT · ĐIỀU PHỐI CẢNG</span>
    <div class="row align-items-center mt-2">
        <div class="col-lg-9">
            <h5 class="fw-bold mb-1">Tác tử AI tự phân tích toàn hệ thống và lập kế hoạch hành động</h5>
            <div style="color:#c9dcef;font-size:.9rem;">
                Agent vận hành theo vòng lặp <strong>Quan sát → Suy luận → Lập kế hoạch → Hành động</strong>:
                tự quét dữ liệu tàu, bến, container, booking, thanh toán và Camera AI, liên kết các dữ kiện,
                rồi <strong>xếp hạng việc cần làm theo điểm ưu tiên</strong> kèm giải thích lý do.
            </div>
        </div>
        <div class="col-lg-3 text-lg-end mt-2 mt-lg-0">
            <a class="btn btn-sm btn-light fw-semibold" href="@Url.Action("Agent")"><i class="bi bi-arrow-repeat me-1"></i>Chạy lại agent</a>
            <div class="small mt-2" style="color:#9fc0e4;">Xử lý trong @Model.MsXuLy ms</div>
        </div>
    </div>
</div>

<!-- ===== Kết luận của agent ===== -->
<div class="agent-verdict mb-3 @(Model.SoKhanCap > 0 ? "urgent" : "")">
    <div class="av-ico"><i class="bi @(Model.SoKhanCap > 0 ? "bi-exclamation-octagon-fill" : "bi-check-circle-fill")"></i></div>
    <div>
        <div class="av-title">Kết luận của Agent</div>
        <div class="av-text">@Model.KetLuan</div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#dc2626,#f87171);">
            <div class="ps-num">@Model.SoKhanCap</div>
            <div class="ps-lbl">Việc khẩn cấp</div>
            <i class="bi bi-exclamation-octagon"></i>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#e5691d,#ff9d4d);">
            <div class="ps-num">@Model.SoCao</div>
            <div class="ps-lbl">Ưu tiên cao</div>
            <i class="bi bi-arrow-up-circle"></i>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#0a2f57,#1c5fa8);">
            <div class="ps-num">@Model.SoTrungBinh</div>
            <div class="ps-lbl">Ưu tiên trung bình</div>
            <i class="bi bi-list-check"></i>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="pay-stat" style="background:linear-gradient(120deg,#7c3aed,#a855f7);">
            <div class="ps-num">@Model.Actions.Count</div>
            <div class="ps-lbl">Tổng hành động đề xuất</div>
            <i class="bi bi-diagram-3"></i>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- ===== Kế hoạch hành động ===== -->
    <div class="col-lg-8">
        <div class="card-sp p-3">
            <h6 class="fw-bold mb-3" style="color:#0a2f57;"><i class="bi bi-list-ol me-1"></i>Kế hoạch hành động (xếp theo mức ưu tiên)</h6>

            @if (!Model.Actions.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-check2-circle" style="font-size:3rem;color:#22c55e;"></i>
                    <div class="mt-2">Không phát hiện vấn đề nào cần can thiệp. Hệ thống đang vận hành tốt.</div>
                </div>
            }

            @{ int stt = 0; }
            @foreach (var a in Model.Actions)
            {
                stt++;
                <div class="agent-card mc-@a.MauMuc">
                    <div class="ac-head">
                        <span class="ac-rank">@stt</span>
                        <div class="flex-grow-1">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="ac-title">@a.TieuDe</span>
                                <span class="ac-badge bg-@a.MauMuc">@a.MucDo</span>
                                <span class="ac-group"><i class="bi bi-tag me-1"></i>@a.Nhom</span>
                            </div>
                            <div class="ac-desc">@a.MoTa</div>
                        </div>
                        <div class="ac-score">
                            <div class="acs-num">@a.DiemUuTien</div>
                            <div class="acs-lbl">điểm</div>
                        </div>
                    </div>

                    <div class="ac-reason">
                        <div class="acr-title"><i class="bi bi-diagram-2 me-1"></i>Chuỗi suy luận của agent</div>
                        <ol class="acr-list">
                            @foreach (var l in a.LyDo)
                            {
                                <li>@l</li>
                            }
                        </ol>
                    </div>

                    <div class="ac-foot">
                        <div class="ac-impact"><i class="bi bi-graph-up-arrow me-1"></i><span>@a.TacDong</span></div>
                        <a class="btn btn-sm btn-navy" href="@a.Url"><i class="bi bi-lightning-charge me-1"></i>@a.TenHanhDong</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ===== Nhật ký quan sát ===== -->
    <div class="col-lg-4">
        <div class="card-sp p-3 mb-3">
            <h6 class="fw-bold mb-3" style="color:#0a2f57;"><i class="bi bi-eye me-1"></i>Dữ liệu agent đã quan sát</h6>
            <div class="agent-obs">
                @foreach (var o in Model.Observations)
                {
                    <div class="ao-item"><i class="bi bi-dot"></i><span>@o</span></div>
                }
            </div>
            <div class="text-muted small mt-2">Thời điểm quét: @Model.ThoiDiem.ToString("HH:mm:ss dd/MM/yyyy")</div>
        </div>

        <div class="card-sp p-3">
            <h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-cpu me-1"></i>Cách agent hoạt động</h6>
            <div class="agent-loop">
                <div class="al-step"><span>1</span><div><strong>Perceive — Quan sát</strong><small>Quét 7 nguồn dữ liệu nghiệp vụ theo thời gian thực</small></div></div>
                <div class="al-step"><span>2</span><div><strong>Reason — Suy luận</strong><small>Liên kết dữ kiện, đối chiếu ràng buộc an toàn &amp; ngưỡng vận hành</small></div></div>
                <div class="al-step"><span>3</span><div><strong>Plan — Lập kế hoạch</strong><small>Chấm điểm ưu tiên 0–100, sắp xếp việc cần làm trước</small></div></div>
                <div class="al-step"><span>4</span><div><strong>Act — Hành động</strong><small>Đề xuất thao tác thực thi được ngay bằng 1 cú nhấp</small></div></div>
            </div>
        </div>
    </div>
</div>

<style>
    .agent-verdict { display: flex; gap: 16px; align-items: center; padding: 18px 22px; border-radius: 16px; background: linear-gradient(120deg,#dcfce7,#f0fdf4); border: 1px solid #86efac; }
    .agent-verdict.urgent { background: linear-gradient(120deg,#fee2e2,#fef2f2); border-color: #fca5a5; }
    html[data-theme="dark"] .agent-verdict { background: linear-gradient(120deg,#0f2e1c,#12271b); border-color: #166534; }
    html[data-theme="dark"] .agent-verdict.urgent { background: linear-gradient(120deg,#2d1414,#291313); border-color: #7f1d1d; }
    .av-ico { font-size: 2.1rem; color: #15803d; }
    .agent-verdict.urgent .av-ico { color: #dc2626; animation: avPulse 1.6s ease-in-out infinite; }
    @@keyframes avPulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.12); } }
    .av-title { font-weight: 800; color: var(--navy); font-size: .92rem; }
    html[data-theme="dark"] .av-title { color: #cfe3fb; }
    .av-text { font-size: .95rem; }

    .agent-card { border: 1px solid var(--line); border-left: 5px solid var(--line); border-radius: 14px; padding: 16px 18px; margin-bottom: 14px; background: var(--card); transition: box-shadow .22s, transform .22s; }
    .agent-card:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(10,47,87,.12); }
    .agent-card.mc-danger { border-left-color: #dc2626; }
    .agent-card.mc-warning { border-left-color: #e5691d; }
    .agent-card.mc-info { border-left-color: #1c5fa8; }
    .ac-head { display: flex; gap: 14px; align-items: flex-start; }
    .ac-rank { flex: 0 0 32px; width: 32px; height: 32px; border-radius: 50%; background: var(--navy); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: .9rem; }
    .ac-title { font-weight: 800; color: var(--navy); font-size: 1.02rem; }
    html[data-theme="dark"] .ac-title { color: #cfe3fb; }
    .ac-badge { font-size: .68rem; font-weight: 700; color: #fff; padding: 2px 10px; border-radius: 999px; }
    .ac-badge.bg-danger { background: #dc2626; }
    .ac-badge.bg-warning { background: #e5691d; }
    .ac-badge.bg-info { background: #1c5fa8; }
    .ac-group { font-size: .72rem; color: var(--muted); background: var(--soft); padding: 2px 9px; border-radius: 999px; }
    .ac-desc { color: var(--muted); font-size: .88rem; margin-top: 4px; }
    .ac-score { text-align: center; flex: 0 0 54px; }
    .acs-num { font-size: 1.45rem; font-weight: 900; color: var(--accent); line-height: 1; }
    .acs-lbl { font-size: .65rem; color: var(--muted); }
    .ac-reason { margin-top: 12px; padding: 12px 14px; border-radius: 10px; background: var(--soft); }
    .acr-title { font-size: .78rem; font-weight: 700; color: var(--navy); margin-bottom: 6px; }
    html[data-theme="dark"] .acr-title { color: #9ec6f2; }
    .acr-list { margin: 0; padding-left: 20px; }
    .acr-list li { font-size: .84rem; color: var(--muted); margin-bottom: 3px; line-height: 1.55; }
    .ac-foot { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; align-items: center; margin-top: 12px; }
    .ac-impact { font-size: .82rem; color: #15803d; font-weight: 600; }
    html[data-theme="dark"] .ac-impact { color: #86efac; }

    .agent-obs .ao-item { display: flex; gap: 4px; align-items: flex-start; font-size: .86rem; color: var(--muted); padding: 6px 0; border-bottom: 1px dashed var(--line); }
    .agent-obs .ao-item:last-child { border-bottom: 0; }
    .agent-loop { display: grid; gap: 10px; }
    .al-step { display: flex; gap: 11px; align-items: flex-start; }
    .al-step > span { flex: 0 0 26px; width: 26px; height: 26px; border-radius: 50%; background: linear-gradient(135deg,#7c3aed,#a855f7); color: #fff; display: flex; align-items: center; justify-content: center; font-size: .78rem; font-weight: 800; }
    .al-step strong { display: block; font-size: .85rem; color: var(--navy); }
    html[data-theme="dark"] .al-step strong { color: #cfe3fb; }
    .al-step small { display: block; font-size: .76rem; color: var(--muted); line-height: 1.45; }
</style>
