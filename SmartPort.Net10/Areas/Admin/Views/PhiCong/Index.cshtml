@model List<SmartPort.Models.BieuPhiCong>
@{
    ViewBag.Title = "Phí cổng — biểu giá";
    var tk = ViewBag.TongKetHomNay as SmartPort.Services.PhiCongService.TongKetCa;
}

<div class="ai-box mb-3" style="background:linear-gradient(120deg,#3b0764,#7e22ce);">
    <span class="ai-tag"><i class="bi bi-cash-coin"></i> THU PHÍ TẠI CỔNG</span>
    <div style="color:#f3e8ff;font-size:.9rem;" class="mt-2">
        Thu ngay tại chỗ khi xe <strong>ra cổng</strong>, không phải chờ khách chuyển khoản.
        Hệ thống xét theo thứ tự: <strong>thẻ tháng còn hạn → miễn</strong>,
        <strong>thẻ trả trước đủ tiền → trừ dần</strong>, còn lại <strong>thu tiền mặt</strong>.
        Thẻ hết hạn hay hết tiền thì <strong>tự quay về thu tiền mặt, không chặn xe</strong>.
    </div>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>@TempData["ThongBao"]</div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>@TempData["Loi"]</div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="border-left:4px solid #7e22ce;">
            <div class="lbl">THU HÔM NAY</div>
            <div class="num" style="color:#7e22ce;">@tk.TongThu.ToString("N0") <span style="font-size:1rem;">đ</span></div>
            <div class="small text-muted">@tk.SoLuot lượt qua cổng</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="lbl">TIỀN MẶT PHẢI NỘP</div>
            <div class="num">@tk.TienMat.ToString("N0") <span style="font-size:1rem;">đ</span></div>
            <div class="small text-muted">trừ tài khoản: @tk.TruTaiKhoan.ToString("N0")đ</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="lbl">THẺ ĐANG HIỆU LỰC</div>
            <div class="num">@ViewBag.SoThe</div>
            <div class="small text-muted">@tk.LuotTheThang lượt dùng thẻ tháng hôm nay</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card" style="border-left:4px solid #dc2626;">
            <div class="lbl">THẺ SẮP HẾT HẠN</div>
            <div class="num" style="color:@(ViewBag.TheSapHetHan > 0 ? "#dc2626" : "#15803d");">@ViewBag.TheSapHetHan</div>
            <div class="small text-muted">trong 7 ngày tới</div>
        </div>
    </div>
</div>

<div class="d-flex gap-2 mb-3">
    <a class="btn btn-outline-sp" href="@Url.Action("TheXe")"><i class="bi bi-credit-card-2-front me-1"></i>Quản lý thẻ xe</a>
    <a class="btn btn-outline-sp" href="@Url.Action("TongKet")"><i class="bi bi-clipboard-data me-1"></i>Tổng kết ca (giao ca)</a>
</div>

<div class="card-sp p-3">
    <h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-tags me-1"></i>Biểu giá theo loại xe</h6>
    <div class="small text-muted mb-3">
        Mỗi cảng/depot một mức giá — sửa thẳng ở đây, không cần đụng vào code.
        Bỏ dấu tích “Đang áp dụng” là loại xe đó không bị thu.
    </div>

    <div class="table-responsive">
        <table class="table table-sp align-middle mb-0">
            <thead>
                <tr>
                    <th>Loại xe</th>
                    <th style="width:180px;">Phí mỗi lượt (đ)</th>
                    <th style="width:180px;">Phí thẻ tháng (đ)</th>
                    <th style="width:120px;" class="text-center">Áp dụng</th>
                    <th style="width:100px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr class="@(b.KichHoat ? "" : "opacity-50")">
                        @using (Html.BeginForm("LuuBieuGia", "PhiCong", FormMethod.Post, new { id = "f" + b.MaBP }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="maBP" value="@b.MaBP" />
                            <td>
                                <div class="fw-semibold">@b.LoaiXe</div>
                                @if (!string.IsNullOrEmpty(b.GhiChu))
                                {
                                    <div class="small text-muted">@b.GhiChu</div>
                                }
                            </td>
                            <td><input class="form-control form-control-sm text-end" name="phiLuot" value="@b.PhiLuot.ToString("N0")" /></td>
                            <td><input class="form-control form-control-sm text-end" name="phiThang" value="@b.PhiThang.ToString("N0")" /></td>
                            <td class="text-center">
                                <input class="form-check-input" type="checkbox" name="kichHoat" value="true" @(b.KichHoat ? "checked" : "") />
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-accent" type="submit"><i class="bi bi-save"></i></button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (tk.TheoLoaiXe.Count > 0)
{
    <div class="card-sp p-3 mt-3">
        <h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-bar-chart me-1"></i>Hôm nay thu theo loại xe</h6>
        <table class="table table-sm table-sp mb-0">
            <thead><tr><th>Loại xe</th><th class="text-center">Lượt</th><th class="text-end">Thành tiền</th></tr></thead>
            <tbody>
                @foreach (var d in tk.TheoLoaiXe)
                {
                    <tr>
                        <td>@d.LoaiXe</td>
                        <td class="text-center">@d.SoLuot</td>
                        <td class="text-end fw-semibold">@d.ThanhTien.ToString("N0")đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
