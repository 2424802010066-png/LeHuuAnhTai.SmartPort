@model SmartPort.Models.TinTuc
@{
    ViewBag.Title = Model.MaTin == 0 ? "Viết bài mới" : "Sửa bài viết";
    string[] mauSac = { "g1", "g2", "g3", "g4", "g5", "g6" };
}
<div class="card-sp">
    <div class="card-header"><i class="bi bi-newspaper me-2 text-primary"></i>@ViewBag.Title</div>
    <div class="p-4">
        @using (Html.BeginForm("Save", "News", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.MaTin)
            @Html.HiddenFor(m => m.NgayDang)
            @Html.HiddenFor(m => m.LuotXem)
            @Html.ValidationSummary(true)
            <div class="row g-3">
                <div class="col-md-9">
                    <label class="form-label">Tiêu đề <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.TieuDe, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.TieuDe)
                </div>
                <div class="col-md-3">
                    <label class="form-label">Màu minh họa</label>
                    @Html.DropDownListFor(m => m.AnhMau, new SelectList(mauSac, Model.AnhMau), new { @class = "form-select" })
                </div>
                <div class="col-12">
                    <label class="form-label">Tóm tắt</label>
                    @Html.TextAreaFor(m => m.TomTat, new { @class = "form-control", rows = 2 })
                </div>
                <div class="col-12">
                    <label class="form-label">Nội dung (hỗ trợ HTML: &lt;p&gt;, &lt;strong&gt;, &lt;ul&gt;...)</label>
                    @Html.TextAreaFor(m => m.NoiDung, new { @class = "form-control", rows = 12 })
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        @Html.CheckBoxFor(m => m.NoiBat, new { @class = "form-check-input" })
                        <label class="form-check-label">Tin nổi bật (hiển thị trang chủ)</label>
                    </div>
                </div>
                <div class="col-12 mt-4">
                    <button class="btn btn-accent px-4" type="submit"><i class="bi bi-save me-1"></i>Lưu bài viết</button>
                    <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Quay lại</a>
                </div>
            </div>
        }
    </div>
</div>
