@model List<SmartPort.Models.NhatKy>
@{
    ViewBag.Title = "Nhật ký hoạt động";
    var loai = ViewBag.Loai as string;
    int trang = ViewBag.Trang, tongTrang = ViewBag.TongTrang;
}

<div class="card-sp p-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h6 class="fw-bold mb-0" style="color:#0a2f57;">
            <i class="bi bi-journal-text me-1"></i>Nhật ký hoạt động
            <span class="badge bg-secondary ms-1">@(((int)ViewBag.Tong).ToString("N0")) bản ghi</span>
        </h6>
        <div class="d-flex gap-1 flex-wrap">
            @foreach (var l in new[] { new[] { "", "Tất cả" }, new[] { "DangNhap", "Đăng nhập" }, new[] { "ThaoTac", "Thao tác" }, new[] { "BaoMat", "Bảo mật" }, new[] { "Loi", "Lỗi" } })
            {
                <a class="btn btn-sm @(loai == l[0] || (string.IsNullOrEmpty(loai) && l[0] == "") ? "btn-navy" : "btn-outline-secondary")"
                   href="@Url.Action("NhatKy", new { loai = l[0] })">@l[1]</a>
            }
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead><tr class="small text-muted"><th style="width:135px;">THỜI GIAN</th><th style="width:95px;">LOẠI</th><th style="width:120px;">TÀI KHOẢN</th><th>NỘI DUNG</th><th style="width:110px;">IP</th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Chưa có bản ghi nào@(string.IsNullOrEmpty(loai) ? "" : " thuộc loại này").</td></tr>
                }
                @foreach (var n in Model)
                {
                    <tr>
                        <td class="small">@n.ThoiGian.ToString("HH:mm:ss dd/MM")</td>
                        <td><span class="badge bg-@n.MauLoai">@n.Loai</span></td>
                        <td class="small fw-semibold">@(n.TaiKhoan ?? "—")</td>
                        <td class="small">@n.NoiDung</td>
                        <td class="small text-muted">@n.DiaChiIP</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (tongTrang > 1)
    {
        <nav class="d-flex justify-content-center mt-2">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(trang <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("NhatKy", new { loai = loai, trang = trang - 1 })">‹</a>
                </li>
                @for (var p = Math.Max(1, trang - 3); p <= Math.Min(tongTrang, trang + 3); p++)
                {
                    <li class="page-item @(p == trang ? "active" : "")">
                        <a class="page-link" href="@Url.Action("NhatKy", new { loai = loai, trang = p })">@p</a>
                    </li>
                }
                <li class="page-item @(trang >= tongTrang ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("NhatKy", new { loai = loai, trang = trang + 1 })">›</a>
                </li>
            </ul>
        </nav>
    }
</div>
