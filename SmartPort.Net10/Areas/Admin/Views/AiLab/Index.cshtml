@{
    ViewBag.Title = "AI Lab — Huấn luyện mạng nơ-ron";
}
<div class="ai-box mb-3" style="background:linear-gradient(120deg,#2e1065,#6d28d9 55%,#8b5cf6);background-size:260% 260%;">
    <span class="ai-tag"><i class="bi bi-diagram-3"></i> NEURAL NETWORK LAB · DEEP LEARNING</span>
    <div class="row align-items-center mt-2">
        <div class="col-lg-9">
            <h5 class="fw-bold mb-1">Tự huấn luyện mạng nơ-ron dự báo sản lượng — ngay trên trình duyệt</h5>
            <div style="color:#ddd6fe;font-size:.9rem;">
                Mô hình <strong>MLP (Multi-Layer Perceptron)</strong> học chuỗi thời gian @ViewBag.SoThang tháng TEU bằng <strong>TensorFlow.js</strong>:
                cửa sổ trượt 3 tháng → dự đoán tháng kế tiếp, tối ưu bằng thuật toán <strong>Adam</strong>, hàm mất mát MSE.
                Chỉnh siêu tham số rồi bấm huấn luyện — xem <strong>đường loss giảm theo thời gian thực</strong> và so sánh với hồi quy tuyến tính.
            </div>
        </div>
        <div class="col-lg-3 text-center d-none d-lg-block">
            <svg width="150" height="110" viewBox="0 0 150 110" xmlns="http://www.w3.org/2000/svg">
                <g stroke="#c4b5fd" stroke-width="1" opacity=".6">
                    <line x1="20" y1="25" x2="75" y2="15"/><line x1="20" y1="25" x2="75" y2="40"/><line x1="20" y1="25" x2="75" y2="65"/><line x1="20" y1="25" x2="75" y2="90"/>
                    <line x1="20" y1="55" x2="75" y2="15"/><line x1="20" y1="55" x2="75" y2="40"/><line x1="20" y1="55" x2="75" y2="65"/><line x1="20" y1="55" x2="75" y2="90"/>
                    <line x1="20" y1="85" x2="75" y2="15"/><line x1="20" y1="85" x2="75" y2="40"/><line x1="20" y1="85" x2="75" y2="65"/><line x1="20" y1="85" x2="75" y2="90"/>
                    <line x1="75" y1="15" x2="130" y2="55"/><line x1="75" y1="40" x2="130" y2="55"/><line x1="75" y1="65" x2="130" y2="55"/><line x1="75" y1="90" x2="130" y2="55"/>
                </g>
                <g fill="#fff"><circle cx="20" cy="25" r="7"/><circle cx="20" cy="55" r="7"/><circle cx="20" cy="85" r="7"/></g>
                <g fill="#ddd6fe"><circle cx="75" cy="15" r="7"/><circle cx="75" cy="40" r="7"/><circle cx="75" cy="65" r="7"/><circle cx="75" cy="90" r="7"/></g>
                <circle cx="130" cy="55" r="9" fill="#ffb25e"/>
            </svg>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card-sp p-3 mb-3">
            <h6 class="fw-bold mb-3" style="color:#0a2f57;"><i class="bi bi-sliders me-1"></i>Siêu tham số (hyperparameters)</h6>
            <label class="form-label small fw-semibold d-flex justify-content-between"><span>Số epoch (vòng học)</span><span id="labEpochsVal" class="text-primary">200</span></label>
            <input type="range" id="labEpochs" class="form-range mb-3" min="50" max="500" step="25" value="200" />
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label small fw-semibold">Tốc độ học (learning rate)</label>
                    <select id="labLr" class="form-select form-select-sm">
                        <option value="0.001">0.001 (chậm, mịn)</option>
                        <option value="0.005">0.005</option>
                        <option value="0.01" selected>0.01 (cân bằng)</option>
                        <option value="0.05">0.05 (nhanh, dao động)</option>
                    </select>
                </div>
                <div class="col-6">
                    <label class="form-label small fw-semibold">Nơ-ron lớp ẩn</label>
                    <select id="labHidden" class="form-select form-select-sm">
                        <option value="8">8 (mạng nhỏ)</option>
                        <option value="16" selected>16 (chuẩn)</option>
                        <option value="32">32 (mạng lớn)</option>
                    </select>
                </div>
            </div>
            <button id="btnTrain" class="btn w-100 btn-lg text-white" style="background:linear-gradient(120deg,#6d28d9,#8b5cf6);"><i class="bi bi-lightning-charge-fill me-1"></i>Bắt đầu huấn luyện</button>
            <div class="progress mt-3" style="height:8px;"><div id="labProg" class="progress-bar" style="width:0%;background:#8b5cf6;"></div></div>
            <div id="labEpochInfo" class="small text-muted mt-1">Chưa huấn luyện</div>
            <div id="labStatus" class="small mt-2">Nhấn "Bắt đầu huấn luyện" — mọi tính toán diễn ra trên máy của bạn, không cần GPU server.</div>
        </div>
        <div class="card-sp p-3">
            <h6 class="fw-bold mb-2" style="color:#0a2f57;"><i class="bi bi-graph-down me-1"></i>Đường học (loss theo epoch)</h6>
            <div style="height:180px;"><canvas id="lossChart"></canvas></div>
            <div class="text-muted mt-1" style="font-size:.72rem;">Loss (MSE, thang log) giảm dần = mạng đang "học" được quy luật chuỗi thời gian.</div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card-sp p-3 mb-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                <h6 class="fw-bold mb-0" style="color:#0a2f57;"><i class="bi bi-graph-up-arrow me-1"></i>Dự báo 6 tháng: Mạng nơ-ron vs Hồi quy tuyến tính</h6>
                <span class="badge-st st-run">Sai số huấn luyện <span id="labMae" class="ms-1">—</span></span>
            </div>
            <div style="height:340px;"><canvas id="mainChart"></canvas></div>
        </div>
        <div class="card-sp" id="labResult" style="display:none;">
            <div class="card-header"><i class="bi bi-table me-2 text-primary"></i>Bảng so sánh dự báo</div>
            <div class="table-responsive">
                <table class="table table-sp mb-0">
                    <thead><tr><th>Tháng</th><th class="text-end">Mạng nơ-ron (TEU)</th><th class="text-end">Hồi quy tuyến tính</th><th class="text-end">Chênh lệch</th></tr></thead>
                    <tbody id="labTable"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ===================== REINFORCEMENT LEARNING — Q-LEARNING ===================== -->
<div class="card-sp p-4 mt-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
        <h6 class="fw-bold mb-0" style="color:#0a2f57;">
            <i class="bi bi-joystick me-1"></i>Reinforcement Learning — Xe nâng tự học tìm đường trong bãi
            <span class="badge" style="background:linear-gradient(90deg,#e5691d,#f59e0b);font-size:.6rem;">Q-LEARNING</span>
        </h6>
        <div class="d-flex gap-2">
            <button id="btnRlMap" class="btn btn-sm btn-outline-sp"><i class="bi bi-shuffle me-1"></i>Bãi ngẫu nhiên mới</button>
            <button id="btnRlTrain" class="btn btn-sm btn-navy"><i class="bi bi-lightning-charge me-1"></i>Huấn luyện 600 episode</button>
        </div>
    </div>
    <p class="small text-muted mb-3">
        <b>Học tăng cường</b> (mảnh thứ 3 của Machine Learning, bên cạnh có giám sát &amp; không giám sát):
        agent xe nâng 🚜 <b>không được dạy trước đường đi</b> — nó tự thử-sai hàng trăm lượt, nhận
        <b>thưởng/phạt</b> (+100 tới đích 🎯, −10 đâm container, −1 mỗi bước) và cập nhật bảng Q theo
        <b>phương trình Bellman</b>. Sau huấn luyện, màu xanh = giá trị đã học, đường cam = lộ trình tối ưu.
    </p>
    <div class="row g-3 align-items-start">
        <div class="col-lg-8 text-center">
            <canvas id="rlCanvas" style="max-width:100%;border-radius:12px;background:var(--soft);"></canvas>
        </div>
        <div class="col-lg-4">
            <div id="rlInfo" class="small" style="line-height:1.7;">Đang khởi tạo bãi...</div>
        </div>
    </div>
</div>

<script type="application/json" id="labData">@Html.Raw(ViewBag.TeuJson)</script>

@section scripts {
<script src="@Url.Content("~/Scripts/ailab.js")?v=3"></script>
<script src="@Url.Content("~/Scripts/rl.js")?v=2"></script>
<script>
    // Ve bieu do lich su ngay khi vao trang (chua can train)
    (function () {
        var d = JSON.parse(document.getElementById('labData').textContent);
        new Chart(document.getElementById('mainChart'), {
            type: 'line',
            data: { labels: d.labels, datasets: [{ label: 'Thực tế', data: d.values, borderColor: '#0d4f8b', backgroundColor: 'rgba(13,79,139,.08)', fill: true, tension: .35 }] },
            options: { maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } }, scales: { y: { grid: { color: '#eef2f7' } }, x: { grid: { display: false } } } }
        });
    })();
</script>
}
