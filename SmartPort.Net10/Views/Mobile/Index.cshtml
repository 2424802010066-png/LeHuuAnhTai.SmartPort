@{
    Layout = null;
    var hoTen = ViewBag.HoTen as string;
    var vaiTro = (ViewBag.VaiTro as string) ?? "";
    var laKhach = vaiTro == "KhachHang";
    var laNoiBo = vaiTro == "Admin" || vaiTro == "NhanVien";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>SmartPort App</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0a2f57" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="apple-touch-icon" href="/Content/img/app-icons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" href="/Content/img/app-icons/icon-192.png" />
    <style>
        :root { --navy: #0a2f57; --xanh: #0369a1; --cam: #f59e0b; }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body { margin: 0; font-family: 'Segoe UI', system-ui, sans-serif; background: #f1f5f9; min-height: 100vh; padding-bottom: 76px; }
        .dau { background: linear-gradient(150deg, #0a2f57, #0c4a6e 60%, #0369a1); color: #fff; padding: max(18px, env(safe-area-inset-top)) 18px 22px; border-radius: 0 0 26px 26px; }
        .dau .hang { display: flex; align-items: center; gap: 12px; }
        .logoApp { width: 52px; height: 52px; border-radius: 14px; flex: none; }
        .dau h1 { font-size: 1.25rem; margin: 0; }
        .dau .phu { color: #7dd3fc; font-size: .78rem; letter-spacing: .5px; }
        .chao { margin-top: 12px; font-size: .9rem; color: #dbeafe; }
        .the { background: rgba(255,255,255,.12); border: 1px solid rgba(125,211,252,.35); border-radius: 14px; padding: 10px 14px; margin-top: 12px; font-size: .82rem; color: #e0f2fe; }
        .luoi { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; padding: 18px; }
        .o { background: #fff; border-radius: 18px; padding: 16px 14px; text-decoration: none; color: #0f172a; box-shadow: 0 4px 14px rgba(2, 32, 71, .08); border: 1px solid rgba(100, 116, 139, .12); display: block; transition: transform .12s; }
        .o:active { transform: scale(.96); }
        .o .bt { font-size: 30px; }
        .o .ten { font-weight: 700; font-size: .92rem; margin-top: 8px; color: var(--navy); }
        .o .mo { font-size: .72rem; color: #64748b; margin-top: 2px; line-height: 1.35; }
        .o.noiBat { background: linear-gradient(140deg, #0a2f57, #0369a1); }
        .o.noiBat .ten { color: #fff; } .o.noiBat .mo { color: #bae6fd; }
        .nhomTen { padding: 4px 20px 0; font-size: .72rem; font-weight: 700; letter-spacing: 1px; color: #64748b; }
        #nutCai { display: none; margin: 0 18px; width: calc(100% - 36px); background: var(--cam); color: #1e293b; border: 0; border-radius: 999px; padding: 13px; font-weight: 800; font-size: .95rem; box-shadow: 0 6px 18px rgba(245, 158, 11, .35); }
        .goiYIos { display: none; margin: 10px 18px 0; font-size: .78rem; color: #475569; background: #fff; border-radius: 12px; padding: 10px 14px; border: 1px dashed #94a3b8; }
        .danhDay { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-top: 1px solid rgba(100,116,139,.18); display: flex; justify-content: space-around; padding: 8px 4px calc(8px + env(safe-area-inset-bottom)); }
        .danhDay a { text-decoration: none; text-align: center; color: #64748b; font-size: .62rem; font-weight: 600; }
        .danhDay a .i { font-size: 20px; display: block; }
        .danhDay a.hienTai { color: var(--xanh); }
    </style>
</head>
<body>
    <div class="dau">
        <div class="hang">
            <img class="logoApp" src="/Content/img/app-icons/icon-192.png" alt="SmartPort" />
            <div>
                <h1>SmartPort</h1>
                <div class="phu">CẢNG THÔNG MINH AI · KHOITRI</div>
            </div>
        </div>
        @if (hoTen != null)
        {
            <div class="chao">Xin chào, <b>@hoTen</b> · @(vaiTro == "KhachHang" ? "Khách hàng" : vaiTro == "Admin" ? "Quản trị" : vaiTro == "NhanVien" ? "Điều độ" : vaiTro)</div>
        }
        else
        {
            <div class="the">📱 Đây là ứng dụng di động của cảng — <b>tài xế</b> check-in lệnh, <b>chủ hàng</b> theo dõi container, <b>điều độ</b> giám sát mọi nơi.</div>
        }
    </div>

    <button id="nutCai">📲 Cài SmartPort lên màn hình chính</button>
    <div class="goiYIos" id="goiYIos">🍎 Trên iPhone: bấm nút <b>Chia sẻ</b> (ô vuông mũi tên) → <b>Thêm vào MH chính</b> để cài app.</div>

    <div class="nhomTen">DÀNH CHO TÀI XẾ &amp; NHÀ XE</div>
    <div class="luoi">
        <a class="o noiBat" href="/TaiXe"><div class="bt">🚚</div><div class="ten">Check-in tài xế</div><div class="mo">Nhập số lệnh + PIN — tới cổng được ưu tiên</div></a>
        <a class="o" href="/Cong"><div class="bt">🚦</div><div class="ten">Tình trạng cổng</div><div class="mo">Mật độ realtime — xem trước khi cho xe chạy</div></a>
    </div>

    <div class="nhomTen">DÀNH CHO CHỦ HÀNG</div>
    <div class="luoi">
        @if (laKhach)
        {
            <a class="o noiBat" href="/HangCuaToi"><div class="bt">📦</div><div class="ten">Hàng &amp; lệnh của tôi</div><div class="mo">Vị trí cont, nhiệt độ lạnh, ảnh AI chụp</div></a>
            <a class="o" href="/Booking/Create"><div class="bt">🛎️</div><div class="ten">Đặt dịch vụ</div><div class="mo">Nâng hạ, lưu bãi, đóng rút...</div></a>
            <a class="o" href="/Booking/My"><div class="bt">🧾</div><div class="ten">Booking của tôi</div><div class="mo">Theo dõi đơn + hóa đơn</div></a>
            <a class="o" href="/Payment/History"><div class="bt">💳</div><div class="ten">Thanh toán</div><div class="mo">QR VietQR, lịch sử giao dịch</div></a>
        }
        else
        {
            <a class="o" href="/Tracking"><div class="bt">🔍</div><div class="ten">Tra cứu container</div><div class="mo">Vị trí bãi, phí lưu, nhiệt độ reefer</div></a>
            <a class="o" href="/Account/Login"><div class="bt">👤</div><div class="ten">Đăng nhập</div><div class="mo">Chủ hàng xem hàng &amp; lệnh của mình</div></a>
        }
        <a class="o" href="/Schedule"><div class="bt">🚢</div><div class="ten">Lịch tàu</div><div class="mo">ETA/ETD các chuyến sắp cập</div></a>
        <a class="o" href="/Cost"><div class="bt">🧮</div><div class="ten">Ước tính phí</div><div class="mo">AI báo giá dịch vụ tức thì</div></a>
    </div>

    @if (laNoiBo)
    {
        <div class="nhomTen">ĐIỀU HÀNH CẢNG (NỘI BỘ)</div>
        <div class="luoi">
            <a class="o noiBat" href="/Admin/Dashboard"><div class="bt">📊</div><div class="ten">Trang quản trị</div><div class="mo">Tổng quan điều hành</div></a>
            <a class="o" href="/Admin/Gate"><div class="bt">📸</div><div class="ten">Cổng ALPR</div><div class="mo">Nhận diện biển số</div></a>
            <a class="o" href="/Admin/Security"><div class="bt">🛡️</div><div class="ten">An ninh AI</div><div class="mo">Sự cố realtime</div></a>
            <a class="o" href="/Admin/Reefer"><div class="bt">❄️</div><div class="ten">Cont lạnh</div><div class="mo">Nhiệt độ + báo động</div></a>
            <a class="o" href="/Admin/Berths/Gantt"><div class="bt">⚓</div><div class="ten">Gantt cầu bến</div><div class="mo">Lịch tàu chiếm bến</div></a>
            <a class="o" href="/Admin/Dashboard/GiaTriAI"><div class="bt">🤖</div><div class="ten">Giá trị AI</div><div class="mo">ROI đo được</div></a>
        </div>
    }

    <div class="danhDay">
        <a class="hienTai" href="/Mobile"><span class="i">🏠</span>App</a>
        <a href="/Cong"><span class="i">🚦</span>Cổng</a>
        <a href="/Tracking"><span class="i">🔍</span>Tra cứu</a>
        <a href="/"><span class="i">🌐</span>Web</a>
        <a href="@(hoTen == null ? "/Account/Login" : "/Account/Profile")"><span class="i">👤</span>@(hoTen == null ? "Đăng nhập" : "Tài khoản")</a>
    </div>

    <script>
        // Dang ky service worker (can HTTPS hoac localhost)
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').catch(function () { });
        }
        // Nut cai dat Android/desktop
        var suKienCai = null;
        window.addEventListener('beforeinstallprompt', function (e) {
            e.preventDefault(); suKienCai = e;
            document.getElementById('nutCai').style.display = 'block';
        });
        document.getElementById('nutCai').addEventListener('click', function () {
            if (!suKienCai) return;
            suKienCai.prompt();
            suKienCai = null;
            this.style.display = 'none';
        });
        // Goi y iOS (khong co beforeinstallprompt)
        var laIos = /iphone|ipad|ipod/i.test(navigator.userAgent);
        var dangStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
        if (laIos && !dangStandalone) document.getElementById('goiYIos').style.display = 'block';
    </script>
</body>
</html>
