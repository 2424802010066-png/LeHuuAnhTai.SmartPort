@model List<SmartPort.Models.DatDichVu>
@{
    ViewBag.Title = "Booking của tôi";
}
<div class="page-head">
    <div class="container">
        <h1><i class="bi bi-receipt me-2"></i>Booking của tôi</h1>
        <nav><ol class="breadcrumb mt-2"><li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li><li class="breadcrumb-item active">Booking của tôi</li></ol></nav>
    </div>
</div>

<div class="container mb-5">
    <div class="d-flex justify-content-end mb-3">
        <a class="btn btn-accent" href="@Url.Action("Create", "Booking")"><i class="bi bi-plus-circle me-1"></i>Đặt dịch vụ mới</a>
    </div>
    <div class="table-responsive table-sp">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Số booking</th>
                    <th>Ngày tạo</th>
                    <th>Ngày thực hiện</th>
                    <th class="text-end">Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Bạn chưa có booking nào. <a href="@Url.Action("Create", "Booking")">Đặt dịch vụ ngay</a>!</td></tr>
                }
                @foreach (var b in Model)
                {
                    <tr>
                        <td class="fw-semibold">@b.MaSoBooking</td>
                        <td>@Ui.Dt(b.NgayTao)</td>
                        <td>@Ui.D(b.NgayCanThucHien)</td>
                        <td class="text-end fw-semibold">@Ui.Vnd(b.TongTien)</td>
                        <td><span class="badge-st @Ui.Badge(b.TrangThai)">@b.TrangThai</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-sp" href="@Url.Action("Details", "Booking", new { id = b.MaBooking })"><i class="bi bi-eye"></i> Xem</a>
                            @if (b.TrangThai == "Chờ duyệt")
                            {
                                using (Html.BeginForm("Cancel", "Booking", new { id = b.MaBooking }, FormMethod.Post, null, new { @class = "d-inline", onsubmit = "return confirm('Hủy booking " + b.MaSoBooking + "?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-x-circle"></i> Hủy</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
