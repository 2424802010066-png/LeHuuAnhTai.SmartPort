@model SmartPort.Models.DatDichVu
@{
    Layout = null;
    List<DatDichVuChiTiet> chiTiets = ViewBag.ChiTiets;
    KhachHang kh = Model.KhachHang;
    decimal vat = Math.Round(Model.TongTien * 0.08m);
    decimal tong = Model.TongTien + vat;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hóa đơn @Model.MaSoBooking — SmartPort</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Be Vietnam Pro', 'Segoe UI', sans-serif; color: #12263a; background: #eef2f7; padding: 24px; font-size: 14px; }
        .sheet { max-width: 860px; margin: auto; background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 10px 40px rgba(10,47,87,.15); }
        .inv-head { background: linear-gradient(120deg, #071f3a, #0d4f8b 70%, #1173c4); color: #fff; padding: 26px 36px; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
        .brand { display: flex; align-items: center; gap: 14px; }
        .brand h1 { font-size: 22px; font-weight: 800; letter-spacing: .4px; }
        .brand small { color: #9fc2e8; font-size: 11px; display: block; }
        .inv-no { text-align: right; }
        .inv-no .lbl { color: #9fc2e8; font-size: 11px; letter-spacing: 2px; }
        .inv-no .num { font-size: 20px; font-weight: 800; color: #ffb25e; }
        .body { padding: 30px 36px; }
        h2.title { text-align: center; font-size: 26px; font-weight: 800; color: #0a2f57; letter-spacing: 1px; }
        .sub { text-align: center; color: #5b6b7c; font-style: italic; margin: 4px 0 24px; }
        .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 22px; }
        .box { border: 1px solid #e3eaf3; border-radius: 10px; padding: 14px 16px; }
        .box h6 { font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: #1173c4; margin-bottom: 8px; }
        .box p { margin: 3px 0; }
        table.lines { width: 100%; border-collapse: collapse; margin-bottom: 4px; }
        table.lines th { background: #0a2f57; color: #fff; padding: 9px 10px; font-size: 12px; text-align: left; }
        table.lines th.r, table.lines td.r { text-align: right; }
        table.lines th.c, table.lines td.c { text-align: center; }
        table.lines td { padding: 8px 10px; border-bottom: 1px solid #edf2f8; }
        table.lines tr:nth-child(even) td { background: #f6f9fd; }
        .totals { margin-left: auto; width: 320px; margin-top: 10px; }
        .totals .row { display: flex; justify-content: space-between; padding: 5px 0; }
        .totals .row.grand { border-top: 2px solid #0a2f57; margin-top: 6px; padding-top: 9px; font-weight: 800; font-size: 18px; color: #e5691d; }
        .words { font-style: italic; color: #33506e; margin-top: 14px; background: #f4f9ff; border-left: 4px solid #1173c4; padding: 9px 14px; border-radius: 0 8px 8px 0; }
        .signs { display: grid; grid-template-columns: 1fr 1fr 1fr; text-align: center; margin-top: 38px; gap: 10px; }
        .signs strong { display: block; }
        .signs small { color: #5b6b7c; font-style: italic; }
        .signs .sp { height: 70px; }
        .foot { background: #f4f7fb; border-top: 1px solid #e3eaf3; padding: 12px 36px; text-align: center; color: #5b6b7c; font-size: 11px; }
        .toolbar { max-width: 860px; margin: 0 auto 14px; display: flex; gap: 10px; justify-content: flex-end; }
        .btn { border: none; border-radius: 9px; padding: 10px 20px; font-weight: 700; cursor: pointer; font-family: inherit; font-size: 14px; }
        .btn-p { background: #ff7d2d; color: #fff; }
        .btn-b { background: #0a2f57; color: #fff; text-decoration: none; display: inline-block; }
        @@media print {
            body { background: #fff; padding: 0; }
            .toolbar { display: none; }
            .sheet { box-shadow: none; border-radius: 0; max-width: none; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <a class="btn btn-b" href="javascript:history.back()">← Quay lại</a>
        <button class="btn btn-p" onclick="window.print()">🖨️ In / Lưu thành PDF</button>
    </div>
    <div class="sheet">
        <div class="inv-head">
            <div class="brand">
                <svg width="52" height="52" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                    <defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff7d2d"/><stop offset="1" stop-color="#ffb25e"/></linearGradient></defs>
                    <rect x="2" y="2" width="60" height="60" rx="16" fill="url(#lg)"/>
                    <path d="M14 44 V20 H44" stroke="#fff" stroke-width="4.5" stroke-linecap="round" fill="none"/>
                    <path d="M14 20 L8 28" stroke="#fff" stroke-width="4" stroke-linecap="round"/>
                    <line x1="36" y1="20" x2="36" y2="29" stroke="#fff" stroke-width="2.5"/>
                    <rect x="29" y="29" width="14" height="10" rx="2" fill="#0a2f57"/>
                    <path d="M10 50 q6 -4 12 0 t12 0 t12 0 t12 0" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" opacity=".85"/>
                </svg>
                <div>
                    <h1>SMARTPORT</h1>
                    <small>CẢNG QUỐC TẾ · Khu bến Cát Lái, TP. Thủ Đức, TP.HCM</small>
                    <small>Hotline 0387 562 579 · MST 0312 999 888 · lehuuanhtai2020tkh@gmail.com</small>
                </div>
            </div>
            <div class="inv-no">
                <div class="lbl">SỐ HÓA ĐƠN</div>
                <div class="num">@Model.MaSoBooking</div>
                <div style="font-size:12px;color:#c9dcef;">Ngày lập: @DateTime.Now.ToString("dd/MM/yyyy")</div>
            </div>
        </div>
        <div class="body">
            <h2 class="title">HÓA ĐƠN DỊCH VỤ CẢNG</h2>
            <div class="sub">(Kèm bảng kê chi tiết dịch vụ theo booking @Model.MaSoBooking)</div>

            <div class="grid2">
                <div class="box">
                    <h6>Thông tin khách hàng</h6>
                    <p><strong>@(kh != null ? kh.TenCongTy : "—")</strong></p>
                    <p>MST: @(kh != null && kh.MaSoThue != null ? kh.MaSoThue : "—")</p>
                    <p>Địa chỉ: @(kh != null && kh.DiaChi != null ? kh.DiaChi : "—")</p>
                    <p>Người liên hệ: @(kh != null && kh.NguoiLienHe != null ? kh.NguoiLienHe : "—") · @(kh != null && kh.SoDienThoai != null ? kh.SoDienThoai : "")</p>
                </div>
                <div class="box">
                    <h6>Thông tin booking</h6>
                    <p>Ngày tạo: <strong>@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</strong></p>
                    <p>Ngày thực hiện: <strong>@(Model.NgayCanThucHien.HasValue ? Model.NgayCanThucHien.Value.ToString("dd/MM/yyyy") : "—")</strong></p>
                    <p>Trạng thái: <strong>@Model.TrangThai</strong></p>
                    @if (!string.IsNullOrEmpty(Model.GhiChu))
                    {
                        <p>Ghi chú: @Model.GhiChu</p>
                    }
                </div>
            </div>

            <table class="lines">
                <thead>
                    <tr>
                        <th class="c" style="width:44px;">STT</th>
                        <th>Tên dịch vụ</th>
                        <th class="c" style="width:70px;">ĐVT</th>
                        <th class="c" style="width:80px;">SL</th>
                        <th class="r" style="width:110px;">Đơn giá (₫)</th>
                        <th class="r" style="width:130px;">Thành tiền (₫)</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int stt = 0; }
                    @foreach (var ct in chiTiets)
                    {
                        stt++;
                        <tr>
                            <td class="c">@stt</td>
                            <td>@(ct.DichVu != null ? ct.DichVu.TenDV : ("Dịch vụ #" + ct.MaDV))</td>
                            <td class="c">@(ct.DichVu != null ? ct.DichVu.DonViTinh : "")</td>
                            <td class="c">@ct.SoLuong</td>
                            <td class="r">@ct.DonGia.ToString("#,##0")</td>
                            <td class="r"><strong>@ct.ThanhTien.ToString("#,##0")</strong></td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="totals">
                <div class="row"><span>Cộng tiền dịch vụ</span><span>@Model.TongTien.ToString("#,##0") ₫</span></div>
                <div class="row"><span>Thuế GTGT (8%)</span><span>@vat.ToString("#,##0") ₫</span></div>
                <div class="row grand"><span>TỔNG THANH TOÁN</span><span>@tong.ToString("#,##0") ₫</span></div>
            </div>

            <div class="words">Bằng chữ: <strong>@SmartPort.Services.ExcelService.DocSoThanhChu(tong)</strong></div>

            <div class="signs">
                <div><strong>NGƯỜI LẬP HÓA ĐƠN</strong><small>(Ký, họ tên)</small><div class="sp"></div></div>
                <div><strong>KẾ TOÁN TRƯỞNG</strong><small>(Ký, họ tên)</small><div class="sp"></div></div>
                <div><strong>KHÁCH HÀNG</strong><small>(Ký, họ tên)</small><div class="sp"></div></div>
            </div>
        </div>
        <div class="foot">Hóa đơn phát hành từ hệ thống ePort — Cảng Quốc tế SmartPort · www.smartport.vn · Cảm ơn Quý khách đã sử dụng dịch vụ!</div>
    </div>
</body>
</html>
