@model SmartPort.Models.DatDichVu
@{
    ViewBag.Title = "Chi tiết booking " + Model.MaSoBooking;
    List<DatDichVuChiTiet> chiTiets = ViewBag.ChiTiets;
}
<div class="page-head">
    <div class="container">
        <h1><i class="bi bi-receipt-cutoff me-2"></i>Booking @Model.MaSoBooking</h1>
        <nav><ol class="breadcrumb mt-2"><li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li><li class="breadcrumb-item"><a href="@Url.Action("My", "Booking")">Booking của tôi</a></li><li class="breadcrumb-item active">@Model.MaSoBooking</li></ol></nav>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card-sp p-4">
                <h5 class="fw-bold mb-3" style="color:#0a2f57;">Danh sách dịch vụ</h5>
                <div class="table-responsive">
                    <table class="table table-sp mb-0">
                        <thead>
                            <tr>
                                <th>Dịch vụ</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ct in chiTiets)
                            {
                                <tr>
                                    <td>@(ct.DichVu != null ? ct.DichVu.TenDV : ("Dịch vụ #" + ct.MaDV))</td>
                                    <td class="text-center">@ct.SoLuong</td>
                                    <td class="text-end">@Ui.Vnd(ct.DonGia)</td>
                                    <td class="text-end fw-semibold">@Ui.Vnd(ct.ThanhTien)</td>
                                </tr>
                            }
                            <tr class="table-light">
                                <td colspan="3" class="text-end fw-bold">TỔNG CỘNG</td>
                                <td class="text-end fw-bold fs-5" style="color:#e5691d;">@Ui.Vnd(Model.TongTien)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card-sp p-4">
                <h5 class="fw-bold mb-3" style="color:#0a2f57;">Thông tin</h5>
                <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Trạng thái</span><span class="badge-st @Ui.Badge(Model.TrangThai)">@Model.TrangThai</span></div>
                <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Ngày tạo</span><strong>@Ui.Dt(Model.NgayTao)</strong></div>
                <div class="d-flex justify-content-between py-2 border-bottom"><span class="text-muted">Ngày thực hiện</span><strong>@Ui.D(Model.NgayCanThucHien)</strong></div>
                @if (!string.IsNullOrEmpty(Model.GhiChu))
                {
                    <div class="py-2"><div class="text-muted mb-1">Ghi chú</div><div>@Model.GhiChu</div></div>
                }
                @{
                    var ttHienTai = ViewBag.ThanhToan as SmartPort.Models.ThanhToan;
                }
                @if (Model.TrangThai != "Đã hủy")
                {
                    if (ttHienTai != null && ttHienTai.TrangThai == "Đã thanh toán")
                    {
                        <div class="pay-actions"><div class="pay-done mt-3"><i class="bi bi-check-circle-fill"></i> Đơn đã thanh toán</div></div>
                        <a class="btn btn-outline-success w-100 mt-2" href="@Url.Action("Receipt", "Payment", new { id = ttHienTai.MaTT })">
                            <i class="bi bi-receipt me-1"></i>Xem biên lai thanh toán
                        </a>
                    }
                    else if (ttHienTai != null && ttHienTai.TrangThai == "Chờ thanh toán")
                    {
                        <a class="btn btn-navy w-100 mt-3" href="@Url.Action("Pay", "Payment", new { id = ttHienTai.MaTT })">
                            <i class="bi bi-credit-card-2-front me-1"></i>Tiếp tục thanh toán
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-navy w-100 mt-3" href="@Url.Action("Index", "Payment", new { id = Model.MaBooking })">
                            <i class="bi bi-credit-card-2-front me-1"></i>Thanh toán ngay
                        </a>
                    }
                }
                @if (Model.TrangThai != "Chờ duyệt" && Model.TrangThai != "Đã hủy")
                {
                    <a class="btn btn-success w-100 mt-2" href="@Url.Action("Invoice", "Booking", new { id = Model.MaBooking })">
                        <i class="bi bi-file-earmark-excel me-1"></i>Tải hóa đơn Excel (.xlsx)
                    </a>
                    <a class="btn btn-danger w-100 mt-2" target="_blank" href="@Url.Action("InvoicePrint", "Booking", new { id = Model.MaBooking })">
                        <i class="bi bi-file-earmark-pdf me-1"></i>Hóa đơn PDF (in / lưu)
                    </a>
                    using (Html.BeginForm("SendEmail", "Booking", new { id = Model.MaBooking }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button class="btn btn-outline-sp w-100 mt-2" type="submit"><i class="bi bi-envelope-arrow-up me-1"></i>Gửi hóa đơn vào email của tôi</button>
                    }
                }
                @if (Model.TrangThai == "Chờ duyệt")
                {
                    using (Html.BeginForm("Cancel", "Booking", new { id = Model.MaBooking }, FormMethod.Post, null, new { onsubmit = "return confirm('Hủy booking này?');" }))
                    {
                        @Html.AntiForgeryToken()
                        <button class="btn btn-outline-danger w-100 mt-3" type="submit"><i class="bi bi-x-circle me-1"></i>Hủy booking</button>
                    }
                }
                <a class="btn btn-outline-sp w-100 mt-2" href="@Url.Action("My", "Booking")"><i class="bi bi-arrow-left me-1"></i>Quay lại danh sách</a>
            </div>
        </div>
    </div>
</div>
