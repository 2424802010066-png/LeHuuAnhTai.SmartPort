@model List<SmartPort.Models.Container>
@using SmartPort.Models
@{
    ViewBag.Title = "Hàng & lệnh của tôi";
    var lenh = ViewBag.Lenh as List<LenhGiaoNhan>;
    var chungTu = ViewBag.ChungTu as List<ChungTu>;
    var anhCong = ViewBag.AnhCong as List<XeRaVao>;
    var anhMedia = ViewBag.AnhMedia as List<MediaAI>;
    var docCuoi = ViewBag.DocCuoi as Dictionary<int, NhietDoLog>;
}

<div class="page-head">
    <div class="container">
        <h2><i class="bi bi-boxes me-2"></i>Hàng &amp; lệnh của tôi</h2>
        <p>Toàn bộ tài sản của bạn tại cảng — vị trí container, nhiệt độ hàng lạnh, tiến độ lệnh giao nhận, chứng từ điện tử và ảnh hàng do hệ thống AI chụp.</p>
    </div>
</div>

<div class="container py-4">
    <div class="row g-3 mb-4 text-center">
        <div class="col-md-3 col-6">
            <div class="card-sp p-3"><div class="fs-3 fw-bold" style="color:#0a2f57;">@ViewBag.TongCont</div><div class="small text-muted">Container của tôi</div></div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card-sp p-3"><div class="fs-3 fw-bold" style="color:#15803d;">@ViewBag.TrongBai</div><div class="small text-muted">Đang nằm trong bãi</div></div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card-sp p-3"><div class="fs-3 fw-bold" style="color:#b45309;">@ViewBag.LenhChoXe</div><div class="small text-muted">Lệnh đang chờ xe</div></div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card-sp p-3"><div class="fs-3 fw-bold" style="color:#0369a1;">@ViewBag.SoAnh</div><div class="small text-muted">Ảnh hàng AI đã chụp</div></div>
        </div>
    </div>

    <!-- 1. CONTAINER -->
    <div class="card-sp p-3 mb-4">
        <h5 class="fw-bold mb-3" style="color:#0a2f57;"><i class="bi bi-box-seam me-1"></i>Container của tôi</h5>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead><tr class="small text-muted"><th>SỐ CONT</th><th>LOẠI</th><th>HÀNG HÓA</th><th>VỊ TRÍ BÃI</th><th>NHIỆT ĐỘ ❄</th><th>TRẠNG THÁI</th><th>VÀO BÃI</th><th></th></tr></thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">Chưa có container nào gắn với tài khoản của bạn.</td></tr>
                    }
                    @foreach (var c in Model)
                    {
                        NhietDoLog doc = null;
                        if (docCuoi != null && c.NhietDo != null) { docCuoi.TryGetValue(c.MaCont, out doc); }
                        <tr>
                            <td class="fw-semibold">@c.SoCont</td>
                            <td class="small">@c.LoaiCont</td>
                            <td class="small">@c.HangHoa</td>
                            <td>@if (!string.IsNullOrEmpty(c.ViTriBai)) { <span class="badge bg-light text-dark border">@c.ViTriBai</span> }</td>
                            <td>
                                @if (c.NhietDo != null)
                                {
                                    var lech = doc != null ? Math.Abs(doc.NhietDo - c.NhietDo.Value) : 0;
                                    <span class="text-info small">cài @c.NhietDo°C</span>
                                    if (doc != null)
                                    {
                                        <span class="fw-bold small @(lech >= 6 ? "text-danger" : lech >= 3 ? "text-warning" : "text-success")"> · đo @doc.NhietDo°C</span>
                                        <div class="text-muted" style="font-size:.68rem;">lúc @doc.ThoiGian.ToString("HH:mm dd/MM")</div>
                                    }
                                }
                                else { <span class="text-muted small">—</span> }
                            </td>
                            <td><span class="badge @(c.TrangThai == "Trong bãi" ? "bg-success" : c.TrangThai == "Chờ xuất tàu" ? "bg-info" : "bg-secondary")">@c.TrangThai</span></td>
                            <td class="small">@(c.NgayVaoBai != null ? c.NgayVaoBai.Value.ToString("dd/MM/yyyy") : "—")</td>
                            <td><a class="btn btn-sm btn-outline-sp" href="@Url.Action("Index", "Tracking", new { soCont = c.SoCont })">Tra cứu</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 2. LENH GIAO NHAN -->
    <div class="card-sp p-3 mb-4">
        <h5 class="fw-bold mb-3" style="color:#0a2f57;"><i class="bi bi-truck me-1"></i>Lệnh giao nhận của tôi</h5>
        @if (lenh == null || lenh.Count == 0)
        {
            <div class="text-center text-muted py-3">Chưa có lệnh giao nhận nào. Liên hệ cảng để đăng ký lệnh trước khi điều xe.</div>
        }
        else
        {
            foreach (var l in lenh)
            {
                var buoc = l.TrangThai == "Hoàn tất" ? 3 : l.TrangThai == "Đã vào cổng" ? 2 : l.TrangThai == "Chờ xe" ? 1 : 0;
                <div class="border rounded-3 p-3 mb-2" style="border-color:rgba(100,116,139,.25)!important;">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <span class="fw-bold" style="color:#0a2f57;">@l.SoLenh</span>
                            <span class="small text-muted ms-2">@l.TenLoaiLenh @(string.IsNullOrEmpty(l.SoCont) ? "" : "· " + l.SoCont)</span>
                            <div class="small text-muted">Xe @l.BienSoXe · hẹn @l.HenTuLuc.ToString("HH:mm dd/MM") → @l.HenDenLuc.ToString("HH:mm dd/MM") · PIN tài xế: <b>@l.MaPin</b></div>
                        </div>
                        @if (buoc == 0)
                        {
                            <span class="badge bg-secondary">@l.TrangThai</span>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-1 small">
                                <span class="badge rounded-pill @(buoc >= 1 ? "bg-success" : "bg-light text-muted border")">1. Chờ xe</span>
                                <i class="bi bi-arrow-right text-muted"></i>
                                <span class="badge rounded-pill @(buoc >= 2 ? "bg-success" : "bg-light text-muted border")">2. Đã vào cổng</span>
                                <i class="bi bi-arrow-right text-muted"></i>
                                <span class="badge rounded-pill @(buoc >= 3 ? "bg-success" : "bg-light text-muted border")">3. Hoàn tất</span>
                            </div>
                        }
                    </div>
                </div>
            }
            <div class="small text-muted">💡 Đưa <b>số lệnh + mã PIN</b> cho tài xế để check-in online tại <a href="@Url.Action("Index", "TaiXe")">Cổng tài xế</a> — xe được ưu tiên xử lý khi tới cổng. Xem mật độ cổng trực tiếp tại <a href="@Url.Action("Index", "Cong")">Tình trạng cổng</a>.</div>
        }
    </div>

    <!-- 3. ANH HANG DO AI CHUP -->
    <div class="card-sp p-3 mb-4">
        <h5 class="fw-bold mb-1" style="color:#0a2f57;"><i class="bi bi-camera me-1"></i>Ảnh hàng của tôi — hệ thống AI chụp tự động</h5>
        <div class="small text-muted mb-3">Camera AI tại cổng (ALPR) chụp xe chở hàng của bạn lúc ra vào; trạm kiểm đếm/QC chụp khi soi container. Đây là ảnh thật theo thời gian thực tế — thay cho việc phải gọi điện hỏi "hàng tôi đến đâu rồi".</div>
        @if ((anhCong == null || anhCong.Count == 0) && (anhMedia == null || anhMedia.Count == 0))
        {
            <div class="text-center text-muted py-3">Chưa có ảnh nào — ảnh sẽ xuất hiện tự động khi xe của bạn qua cổng hoặc container được kiểm đếm.</div>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2">
                @if (anhCong != null)
                {
                    foreach (var x in anhCong)
                    {
                        <a href="@Url.Content(x.AnhXe)" target="_blank" rel="noopener" class="text-decoration-none text-center">
                            <img src="@Url.Content(x.AnhXe)" alt="Ảnh xe @x.BienSo" style="width:150px;height:100px;object-fit:cover;border-radius:8px;border:1px solid rgba(100,116,139,.3);" loading="lazy" />
                            <div class="small text-muted">@x.BienSo · @x.HuongDi cổng<br />@x.ThoiGian.ToString("HH:mm dd/MM")</div>
                        </a>
                    }
                }
                @if (anhMedia != null)
                {
                    foreach (var m in anhMedia)
                    {
                        <a href="@Url.Content(m.DuongDan)" target="_blank" rel="noopener" class="text-decoration-none text-center">
                            <img src="@Url.Content(m.DuongDan)" alt="@m.MoTa" style="width:150px;height:100px;object-fit:cover;border-radius:8px;border:1px solid rgba(100,116,139,.3);" loading="lazy" />
                            <div class="small text-muted">@(m.Nguon == "KiemDem" ? "Kiểm đếm" : m.Nguon)<br />@m.ThoiGian.ToString("HH:mm dd/MM")</div>
                        </a>
                    }
                }
            </div>
        }
    </div>

    <!-- 4. CHUNG TU DIEN TU -->
    <div class="card-sp p-3">
        <h5 class="fw-bold mb-3" style="color:#0a2f57;"><i class="bi bi-file-earmark-lock2 me-1"></i>Chứng từ điện tử của tôi <span class="badge bg-dark ms-1">⛓ chuỗi khối</span></h5>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead><tr class="small text-muted"><th>SỐ CHỨNG TỪ</th><th>LOẠI</th><th>CONT / XE</th><th>MÔ TẢ</th><th>NGÀY LẬP</th><th>HASH ⛓</th></tr></thead>
                <tbody>
                    @if (chungTu == null || chungTu.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-3">Chưa có chứng từ nào.</td></tr>
                    }
                    else
                    {
                        foreach (var ct in chungTu)
                        {
                            <tr>
                                <td class="fw-semibold small">@ct.SoChungTu</td>
                                <td><span class="badge bg-light text-dark border">@ct.LoaiCT</span></td>
                                <td class="small">@ct.SoCont @(string.IsNullOrEmpty(ct.BienSoXe) ? "" : "· " + ct.BienSoXe)</td>
                                <td class="small text-muted">@ct.MoTa</td>
                                <td class="small">@ct.NgayLap.ToString("HH:mm dd/MM/yyyy")</td>
                                <td class="small font-monospace" title="@ct.HashSHA256">@(string.IsNullOrEmpty(ct.HashSHA256) ? "—" : ct.HashSHA256.Substring(0, 10) + "…")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="small text-muted">Mỗi chứng từ được niêm phong bằng chuỗi hash SHA-256 nối tiếp nhau (mô hình eB/L) — không ai sửa lén được nội dung sau khi phát hành.</div>
    </div>
</div>
