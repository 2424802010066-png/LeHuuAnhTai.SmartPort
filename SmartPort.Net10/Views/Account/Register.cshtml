@model SmartPort.Models.RegisterVM
@{
    ViewBag.Title = "Đăng ký khách hàng";
}
<div class="page-head">
    <div class="container">
        <h1><i class="bi bi-person-plus me-2"></i>Đăng ký tài khoản khách hàng</h1>
        <nav><ol class="breadcrumb mt-2"><li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li><li class="breadcrumb-item active">Đăng ký</li></ol></nav>
    </div>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card-sp p-4 p-md-5">
                @using (Html.BeginForm("Register", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true)
                    <h5 class="fw-bold mb-3" style="color:#0a2f57;"><i class="bi bi-person-badge me-2"></i>Thông tin đăng nhập</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label">Tên đăng nhập <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.TenDangNhap)
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Mật khẩu <span class="text-danger">*</span></label>
                            @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.MatKhau)
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                            @Html.PasswordFor(m => m.XacNhanMatKhau, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.XacNhanMatKhau)
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3" style="color:#0a2f57;"><i class="bi bi-buildings me-2"></i>Thông tin doanh nghiệp</h5>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Tên công ty <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.TenCongTy, new { @class = "form-control", placeholder = "Công ty TNHH ..." })
                            @Html.ValidationMessageFor(m => m.TenCongTy)
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Mã số thuế</label>
                            @Html.TextBoxFor(m => m.MaSoThue, new { @class = "form-control" })
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Địa chỉ</label>
                            @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control" })
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Người liên hệ <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.HoTen)
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Email <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Email)
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Số điện thoại</label>
                            @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control" })
                        </div>
                        <div class="col-12 mt-4">
                            <button class="btn btn-accent btn-lg px-5" type="submit"><i class="bi bi-check2-circle me-1"></i>Đăng ký</button>
                            <span class="ms-3 small text-muted">Đã có tài khoản? <a href="@Url.Action("Login", "Account")">Đăng nhập</a></span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
