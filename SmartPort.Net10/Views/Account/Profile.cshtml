@model SmartPort.Models.TaiKhoan
@{
    ViewBag.Title = "Hồ sơ cá nhân";
    KhachHang kh = ViewBag.KhachHang as KhachHang;
}
<div class="page-head">
    <div class="container">
        <h1><i class="bi bi-person-gear me-2"></i>Hồ sơ cá nhân</h1>
        <nav><ol class="breadcrumb mt-2"><li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li><li class="breadcrumb-item active">Hồ sơ</li></ol></nav>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card-sp p-4 mb-4">
                <h5 class="fw-bold mb-3" style="color:#0a2f57;"><i class="bi bi-person-vcard me-2"></i>Thông tin tài khoản</h5>
                @using (Html.BeginForm("UpdateProfile", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Tên đăng nhập</label>
                            <input class="form-control" value="@Model.TenDangNhap" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Vai trò</label>
                            <input class="form-control" value="@Model.VaiTro" disabled />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Họ tên</label>
                            <input class="form-control" name="hoTen" value="@Model.HoTen" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input class="form-control" name="email" value="@Model.Email" type="email" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Số điện thoại</label>
                            <input class="form-control" name="soDienThoai" value="@Model.SoDienThoai" />
                        </div>
                        <div class="col-12">
                            <button class="btn btn-navy" type="submit"><i class="bi bi-save me-1"></i>Lưu thay đổi</button>
                        </div>
                    </div>
                }
            </div>

            <!-- ===== FACE LOGIN: loi vao trang cai dat khuon mat ===== -->
            <div class="card-sp p-4 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="fw-bold mb-1" style="color:#0a2f57;"><i class="bi bi-person-bounding-box me-2"></i>Đăng nhập bằng khuôn mặt</h5>
                    <div class="text-muted small">Đăng ký Face ID (AI ArcFace) — lần sau đăng nhập không cần gõ mật khẩu.</div>
                </div>
                <a class="btn btn-navy" href="@Url.Action("FaceSetup", "Account")">
                    <i class="bi bi-camera me-1"></i>Cài đặt khuôn mặt
                </a>
            </div>

            <div class="card-sp p-4">
                <h5 class="fw-bold mb-3" style="color:#0a2f57;"><i class="bi bi-shield-lock me-2"></i>Đổi mật khẩu</h5>
                @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Mật khẩu hiện tại</label>
                            <input class="form-control" name="MatKhauCu" type="password" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Mật khẩu mới</label>
                            <input class="form-control" name="MatKhauMoi" type="password" minlength="6" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Xác nhận mật khẩu mới</label>
                            <input class="form-control" name="XacNhan" type="password" minlength="6" required />
                        </div>
                        <div class="col-12">
                            <button class="btn btn-accent" type="submit"><i class="bi bi-key me-1"></i>Đổi mật khẩu</button>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-5">
            @if (kh != null)
            {
                <div class="card-sp p-4 mb-4">
                    <h5 class="fw-bold mb-3" style="color:#0a2f57;"><i class="bi bi-buildings me-2"></i>Doanh nghiệp liên kết</h5>
                    <div class="mb-2"><div class="text-muted small">Tên công ty</div><div class="fw-semibold">@kh.TenCongTy</div></div>
                    <div class="mb-2"><div class="text-muted small">Mã số thuế</div><div class="fw-semibold">@(kh.MaSoThue ?? "—")</div></div>
                    <div class="mb-2"><div class="text-muted small">Địa chỉ</div><div class="fw-semibold">@(kh.DiaChi ?? "—")</div></div>
                    <div class="mb-0"><div class="text-muted small">Người liên hệ</div><div class="fw-semibold">@(kh.NguoiLienHe ?? "—")</div></div>
                </div>
                <div class="card-sp p-4">
                    <h6 class="fw-bold" style="color:#0a2f57;">Lối tắt</h6>
                    <div class="d-grid gap-2">
                        <a class="btn btn-accent" href="@Url.Action("Create", "Booking")"><i class="bi bi-plus-circle me-1"></i>Đặt dịch vụ mới</a>
                        <a class="btn btn-outline-sp" href="@Url.Action("My", "Booking")"><i class="bi bi-receipt me-1"></i>Booking của tôi</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
