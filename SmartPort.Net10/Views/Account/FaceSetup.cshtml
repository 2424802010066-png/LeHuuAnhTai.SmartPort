@{
    ViewBag.Title = "Cài đặt đăng nhập khuôn mặt";
    int soGoc = (int)(ViewBag.SoGoc ?? 0);
    bool aiAlive = (bool)(ViewBag.AiAlive ?? false);
    var clTB = ViewBag.ChatLuongTB as decimal?;
}

<div class="auth-page">
    <div class="container">
        <div class="auth-shell" style="max-width:600px;grid-template-columns:1fr;">
            <div class="auth-form">
                <div class="af-inner">
                    <div class="af-head">
                        <span class="af-badge"><i class="bi bi-person-bounding-box me-1"></i>FACE ID PRO · ArcFace + FIQA</span>
                        <h3>Cài đặt khuôn mặt</h3>
                        <p>Đăng ký <b>5 góc mặt</b> — AI tự chấm chất lượng từng ảnh để đảm bảo lần sau nhận diện chuẩn.</p>
                    </div>

                    @* Form rong de sinh anti-forgery token cho JS *@
                    <form id="frmFace" onsubmit="return false;">@Html.AntiForgeryToken()</form>

                    @if (!aiAlive)
                    {
                        <div class="alert alert-warning small">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            <b>Dịch vụ AI khuôn mặt chưa chạy.</b> Hãy khởi động dịch vụ
                            (<code>4-chay-ai-cho-smartport.bat</code> trong thư mục FaceAuth) rồi tải lại trang.
                        </div>
                    }

                    @if (soGoc > 0)
                    {
                        <div class="alert alert-success small d-flex justify-content-between align-items-center">
                            <span>
                                <i class="bi bi-check-circle me-1"></i>Đã đăng ký <b>@soGoc góc mặt</b>
                                @if (clTB.HasValue)
                                {<text> · chất lượng TB <b>@Math.Round(clTB.Value, 1)/100</b></text>}
                                — đăng nhập khuôn mặt đang BẬT.
                            </span>
                            <button type="button" id="btnFsRemove" class="btn btn-sm btn-outline-danger">Xóa đăng ký</button>
                        </div>
                        <p class="small text-muted mb-2">Chụp lại bên dưới sẽ <b>thay thế</b> toàn bộ dữ liệu cũ.</p>
                    }

                    <!-- Vong camera (tai dung style scanner) -->
                    <div class="face-ring idle" style="margin-top:6px;">
                        <div class="face-hole" id="fsHole">
                            <video id="fsVideo" playsinline muted></video>
                        </div>
                    </div>

                    <p id="fsGuide" class="face-status" style="color:#334155;"></p>
                    <div id="fsQuality" class="small text-center mb-2" style="min-height:20px;"></div>

                    <!-- 5 o anh da chup -->
                    <div class="face-shots" id="fsShots">
                        <div class="face-shot" id="fsShot0">Thẳng</div>
                        <div class="face-shot" id="fsShot1">Trái</div>
                        <div class="face-shot" id="fsShot2">Phải</div>
                        <div class="face-shot" id="fsShot3">Ngẩng</div>
                        <div class="face-shot" id="fsShot4">Cúi</div>
                    </div>

                    <div class="face-actions mt-3">
                        <button type="button" id="btnFsShot" class="btn-face">📸 Chụp góc 1</button>
                        <button type="button" id="btnFsSubmit" class="btn-face" style="display:none;">✔ Hoàn tất đăng ký</button>
                        <a class="btn-face-ghost" href="@Url.Action("Profile", "Account")" style="text-decoration:none;">
                            <i class="bi bi-arrow-left"></i> Về trang hồ sơ
                        </a>
                    </div>

                    <div id="fsMsg"></div>

                    <div class="alert alert-light border small mt-3 mb-0">
                        <b><i class="bi bi-shield-check me-1"></i>Cách hoạt động:</b>
                        ảnh của bạn được mạng nơ-ron <b>ArcFace (buffalo_l)</b> chuyển thành vector 512 số
                        <b>(không lưu ảnh gốc)</b>, có hợp nhất ảnh lật ngang để vector ổn định hơn.
                        Khi đăng nhập hệ thống chấm <b>chất lượng ảnh</b>, kiểm tra <b>liveness</b> chống ảnh giả,
                        so cosine với <b>toàn bộ góc đã đăng ký</b>, đòi <b>biên an toàn</b> so với người giống nhì
                        và cần <b>@(ViewBag.SoKhungCan ?? 2) khung hình liên tiếp</b> cùng khớp mới cho vào.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script src="@Url.Content("~/Scripts/facelogin.js")?v=4"></script>
}
