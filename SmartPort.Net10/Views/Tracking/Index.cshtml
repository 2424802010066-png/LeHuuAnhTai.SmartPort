@model SmartPort.Models.Container
@{
    ViewBag.Title = "Tra cứu container";
    string searched = ViewBag.Searched as string;
}
@section scripts {
    <script src="@Url.Content("~/Scripts/ocr.js")?v=5"></script>
}
<div class="page-head">
    <div class="container">
        <h1><i class="bi bi-box-seam me-2"></i>Tra cứu container</h1>
        <nav><ol class="breadcrumb mt-2"><li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li><li class="breadcrumb-item active">Tra cứu container</li></ol></nav>
    </div>
</div>

<div class="container mb-5">
    <div class="card-sp p-4 mb-4">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label">Số container (4 chữ cái + 7 chữ số)</label>
                <input type="text" name="soCont" value="@searched" class="form-control form-control-lg" placeholder="VD: MSCU2201417" />
            </div>
            <div class="col-md-4">
                <button class="btn btn-accent btn-lg w-100" type="submit"><i class="bi bi-search me-1"></i>Tra cứu</button>
            </div>
        </form>
        <div class="text-muted small mt-2"><i class="bi bi-lightbulb me-1"></i>Thử với: MSCU2201417, MAEU3305891, MSCU2299876 (lạnh), MSCU2210555 (chờ xuất)</div>
    </div>

    <!-- OCR DEEP LEARNING: doc so container tu anh -->
    <div class="card-sp p-4 mb-4" style="border:2px dashed #8b5cf6;">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
            <h5 class="fw-bold mb-0" style="color:#0a2f57;">
                <i class="bi bi-camera me-2" style="color:#8b5cf6;"></i>Quét số container bằng AI
                <span class="badge ms-1" style="background:#8b5cf6;font-size:.6rem;vertical-align:middle;">OCR · DEEP LEARNING</span>
            </h5>
            <span class="text-muted small">Mạng nơ-ron LSTM (Tesseract) chạy ngay trên trình duyệt</span>
        </div>
        <p class="text-muted small mb-3">Lười gõ? Chụp/tải ảnh vỏ container — AI tự đọc ký tự, nhận ra mã hợp lệ (4 chữ + 7 số) và điền vào ô tra cứu.</p>
        <div class="row g-3 align-items-start">
            <div class="col-md-5">
                <input type="file" id="ocrFile" accept="image/*" capture="environment" class="form-control mb-2" />
                <button type="button" id="ocrDemo" class="btn btn-outline-sp btn-sm w-100 mb-2"><i class="bi bi-magic me-1"></i>Chạy thử với ảnh container mẫu</button>
                <div class="progress mb-1" style="height:7px;"><div id="ocrBar" class="progress-bar" style="width:0%;background:#8b5cf6;"></div></div>
                <div id="ocrProgLabel" class="text-muted" style="font-size:.72rem;"></div>
                <div id="ocrStatus" class="small mt-2">Chọn ảnh hoặc bấm chạy thử — mô hình OCR tải một lần rồi dùng mãi.</div>
            </div>
            <div class="col-md-7">
                <img id="ocrPreview" alt="Ảnh container" style="display:none;max-width:100%;border-radius:12px;box-shadow:0 8px 24px rgba(10,47,87,.18);" />
                <div id="ocrResult" style="display:none;" class="mt-3">
                    <div id="ocrCode" class="fs-5 fw-bold" style="color:#0a2f57;"></div>
                    <button type="button" id="ocrGo" class="btn btn-accent btn-glow mt-2" style="display:none;"><i class="bi bi-search me-1"></i>Tra cứu ngay</button>
                    <div class="mt-2 p-2 rounded" style="background:#f4f7fb;font-family:monospace;font-size:.74rem;color:#5b6b7c;max-height:80px;overflow:auto;">
                        <span class="fw-bold">Văn bản AI đọc được:</span> <span id="ocrRawText"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model == null && !string.IsNullOrEmpty(searched))
    {
        <div class="card-sp p-5 text-center">
            <div style="font-size:3.5rem;">🔍</div>
            <h5 class="fw-bold mt-2">Không tìm thấy container "@searched"</h5>
            <p class="text-muted mb-0">Vui lòng kiểm tra lại số container hoặc liên hệ hotline 0387 562 579 để được hỗ trợ.</p>
        </div>
    }
    @if (Model != null)
    {
        KhachHang kh = ViewBag.KhachHang as KhachHang;
        ChuyenTau cn = ViewBag.ChuyenNhap as ChuyenTau;
        Tau tauNhap = ViewBag.TauNhap as Tau;
        ChuyenTau cx = ViewBag.ChuyenXuat as ChuyenTau;
        Tau tauXuat = ViewBag.TauXuat as Tau;

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card-sp p-4 h-100">
                    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
                        <h4 class="fw-bold mb-0" style="color:#0a2f57;"><i class="bi bi-box-seam me-2"></i>@Model.SoCont</h4>
                        <span class="badge-st @Ui.Badge(Model.TrangThai)" style="font-size:.9rem;">@Model.TrangThai</span>
                    </div>
                    <div class="row g-3">
                        <div class="col-6 col-md-4"><div class="text-muted small">Loại container</div><div class="fw-semibold">@Model.LoaiCont</div></div>
                        <div class="col-6 col-md-4"><div class="text-muted small">Tình trạng</div><div class="fw-semibold">@(Model.TinhTrang == "Full" ? "Có hàng (Full)" : "Rỗng (Empty)")</div></div>
                        <div class="col-6 col-md-4"><div class="text-muted small">Trọng lượng</div><div class="fw-semibold">@(Model.TrongLuong.HasValue ? Ui.Num(Model.TrongLuong) + " tấn" : "—")</div></div>
                        <div class="col-6 col-md-4"><div class="text-muted small">Vị trí bãi</div><div class="fw-semibold">@(string.IsNullOrEmpty(Model.ViTriBai) ? "—" : Model.ViTriBai)</div></div>
                        <div class="col-6 col-md-4"><div class="text-muted small">Hàng hóa</div><div class="fw-semibold">@(string.IsNullOrEmpty(Model.HangHoa) ? "—" : Model.HangHoa)</div></div>
                        @if (Model.NhietDo.HasValue)
                        {
                            <div class="col-6 col-md-4"><div class="text-muted small">Nhiệt độ cài đặt</div><div class="fw-semibold text-info"><i class="bi bi-thermometer-snow"></i> @Model.NhietDo °C</div></div>
                        }
                        @if (kh != null)
                        {
                            <div class="col-12"><div class="text-muted small">Chủ hàng</div><div class="fw-semibold">@kh.TenCongTy</div></div>
                        }
                    </div>

                    @if (ViewBag.SoNgayLuuBai != null)
                    {
                        <div class="alert alert-warning mt-4 mb-0">
                            <i class="bi bi-cash-coin me-1"></i>
                            Đã lưu bãi <strong>@ViewBag.SoNgayLuuBai ngày</strong> — phí lưu bãi ước tính (miễn 5 ngày đầu@(Model.NhietDo.HasValue ? ", gồm điện lạnh" : "")):
                            <strong>@Ui.Vnd((decimal)ViewBag.PhiLuuBai)</strong>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card-sp p-4 h-100">
                    <h5 class="fw-bold mb-3" style="color:#0a2f57;"><i class="bi bi-signpost-split me-2"></i>Hành trình container</h5>
                    <div class="tl">
                        @if (cn != null)
                        {
                            <div class="tl-item done">
                                <h6>Dỡ từ tàu @(tauNhap != null ? tauNhap.TenTau : "") (chuyến @cn.MaChuyenHieu)</h6>
                                <small>@Ui.Dt(cn.ATA ?? cn.ETA)</small>
                            </div>
                        }
                        @if (Model.NgayVaoBai.HasValue)
                        {
                            <div class="tl-item done">
                                <h6>Hạ bãi tại cảng @(string.IsNullOrEmpty(Model.ViTriBai) ? "" : "— vị trí " + Model.ViTriBai)</h6>
                                <small>@Ui.Dt(Model.NgayVaoBai)</small>
                            </div>
                        }
                        <div class="tl-item now">
                            <h6>Trạng thái hiện tại: @Model.TrangThai</h6>
                            <small>Cập nhật @Ui.Dt(DateTime.Now)</small>
                        </div>
                        @if (cx != null && !Model.NgayRaBai.HasValue)
                        {
                            <div class="tl-item">
                                <h6>Dự kiến xuất theo tàu @(tauXuat != null ? tauXuat.TenTau : "") (chuyến @cx.MaChuyenHieu)</h6>
                                <small>ETD @Ui.Dt(cx.ETD)</small>
                            </div>
                        }
                        @if (Model.NgayRaBai.HasValue)
                        {
                            <div class="tl-item done">
                                <h6>@(Model.TrangThai == "Đã giao khách" ? "Giao cho khách (gate out)" : "Xếp lên tàu xuất")</h6>
                                <small>@Ui.Dt(Model.NgayRaBai)</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
