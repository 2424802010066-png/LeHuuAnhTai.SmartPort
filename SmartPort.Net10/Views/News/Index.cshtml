@model List<SmartPort.Models.TinTuc>
@{
    ViewBag.Title = "Tin tức";
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
}
<div class="page-head">
    <div class="container">
        <h1><i class="bi bi-newspaper me-2"></i>Tin tức &amp; sự kiện</h1>
        <nav><ol class="breadcrumb mt-2"><li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li><li class="breadcrumb-item active">Tin tức</li></ol></nav>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-4">
        @foreach (var t in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="news-card">
                    <div class="news-thumb" style="@Photos.Bg(t.AnhMau ?? "g1")"></div>
                    <div class="p-3">
                        <div class="news-meta mb-2">
                            <i class="bi bi-calendar3 me-1"></i>@Ui.D(t.NgayDang) · <i class="bi bi-eye me-1"></i>@t.LuotXem lượt xem
                            @if (t.NoiBat)
                            {
                                <span class="badge-st st-warn ms-1">Nổi bật</span>
                            }
                        </div>
                        <h5><a href="@Url.Action("Details", "News", new { id = t.MaTin })">@t.TieuDe</a></h5>
                        <p class="text-muted small mb-0">@t.TomTat</p>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
