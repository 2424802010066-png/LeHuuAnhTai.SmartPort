<button id="pbFab" class="pb-fab" type="button" title="Chat với PortBot AI">
    <i class="bi bi-robot"></i>
</button>
<div id="pbPanel" class="pb-panel">
    <div class="pb-head">
        <div class="pb-avatar"><i class="bi bi-robot"></i></div>
        <div>
            <h6>PortBot</h6>
            <small><span class="me-1" style="color:#7CFC9A;">●</span>Trợ lý ảo AI — Cảng SmartPort</small>
        </div>
        <button id="pbClose" type="button" class="btn-close btn-close-white ms-auto"></button>
    </div>
    <div id="pbBody" class="pb-body"></div>
    <div class="pb-foot">
        <button id="pbMic" type="button" class="pb-mic" title="Nói câu hỏi (tiếng Việt)"><i class="bi bi-mic-fill"></i></button>
        <input id="pbInput" type="text" placeholder="Nhập hoặc nói câu hỏi..." maxlength="500" />
        <button id="pbSpeak" type="button" class="pb-mic" title="Bật/tắt đọc câu trả lời"><i class="bi bi-volume-mute-fill"></i></button>
        <button id="pbSend" type="button" title="Gửi"><i class="bi bi-send-fill"></i></button>
    </div>
</div>
