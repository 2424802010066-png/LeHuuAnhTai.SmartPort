@* Logo thuong hieu SmartPort v2 — SVG doc quyen (tau container + cau STS + mat troi + song + tin hieu AI) *@
<svg class="sp-logo" width="42" height="42" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="SmartPort logo">
    <defs>
        <linearGradient id="spBg2" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#083058" />
            <stop offset=".5" stop-color="#0d4f8b" />
            <stop offset="1" stop-color="#14b8d4" />
        </linearGradient>
        <radialGradient id="spGlow2" cx=".3" cy=".18" r=".9">
            <stop offset="0" stop-color="#ffffff" stop-opacity=".28" />
            <stop offset=".45" stop-color="#ffffff" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="spSun2" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffd98a" />
            <stop offset="1" stop-color="#ff9d45" />
        </linearGradient>
        <linearGradient id="spHull2" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#0b2d51" />
            <stop offset="1" stop-color="#061c35" />
        </linearGradient>
    </defs>

    <!-- Nen + anh sang -->
    <rect x="2" y="2" width="60" height="60" rx="17" fill="url(#spBg2)" />
    <rect x="2" y="2" width="60" height="60" rx="17" fill="url(#spGlow2)" />
    <rect x="4.2" y="4.2" width="55.6" height="55.6" rx="14.5" fill="none" stroke="#ffffff" stroke-opacity=".22" stroke-width="1.3" />

    <!-- Mat troi -->
    <circle cx="47" cy="17" r="9" fill="url(#spSun2)" opacity=".35" />
    <circle cx="47" cy="17" r="5.5" fill="url(#spSun2)" />

    <!-- Cau STS -->
    <g stroke="#ffffff" stroke-width="3.4" stroke-linecap="round" fill="none">
        <path d="M15 40 V15" />
        <path d="M15 17 H41" />
        <path d="M15 17 L9 25" />
    </g>
    <line x1="33" y1="17" x2="33" y2="25" stroke="#ffffff" stroke-width="1.8" />
    <rect x="27.5" y="25" width="11" height="8" rx="1.8" fill="#ff7d2d" stroke="#ffffff" stroke-opacity=".35" stroke-width=".8" />

    <!-- Tau container -->
    <g>
        <rect x="20" y="36.5" width="8.5" height="6" rx="1.2" fill="#22d3ee" />
        <rect x="29.5" y="36.5" width="8.5" height="6" rx="1.2" fill="#ffb25e" />
        <rect x="39" y="36.5" width="8.5" height="6" rx="1.2" fill="#4ade80" />
        <rect x="46" y="30.5" width="5.5" height="12" rx="1.2" fill="#e9eef5" />
        <rect x="47.2" y="32.3" width="3.1" height="1.7" rx=".6" fill="#0d3b66" />
        <path d="M14 43 H53 L48.5 51 H18.5 Z" fill="url(#spHull2)" stroke="#ffffff" stroke-opacity=".18" stroke-width=".8" />
    </g>

    <!-- Song bien -->
    <path d="M11 55 q5 -3.4 10 0 t10 0 t10 0 t10 0" stroke="#7fd0f5" stroke-width="2.6" fill="none" stroke-linecap="round" />
    <path d="M16 59.5 q5 -3.4 10 0 t10 0 t10 0" stroke="#3f8fc9" stroke-width="2.2" fill="none" stroke-linecap="round" opacity=".8" />

    <!-- Tin hieu AI -->
    <circle cx="52.5" cy="9.5" r="2.6" fill="#7CFC9A" />
    <circle class="logo-ping" cx="52.5" cy="9.5" r="6" fill="none" stroke="#7CFC9A" stroke-width="1.4" />
</svg>
