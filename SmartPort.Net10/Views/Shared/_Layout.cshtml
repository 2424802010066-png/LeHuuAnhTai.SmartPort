@{
    var ctrl = ViewContext.RouteData.Values["controller"].ToString().ToLowerInvariant();
    var act = ViewContext.RouteData.Values["action"].ToString().ToLowerInvariant();
    var Phien = new SmartPort.Helpers.SessionBag(Context.Session);
    var hoTen = Phien["HoTen"] as string;
    var vaiTro = Phien["VaiTro"] as string;
    var fbCaNhan = CauHinh.AppSettings["FacebookCaNhan"];
    var zaloPhone = CauHinh.AppSettings["ZaloPhone"];
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title != null ? ViewBag.Title + " — " : "")SmartPort — Cảng Quốc tế</title>
    <script>try { var t = localStorage.getItem('sp-theme'); var qm = location.search.match(/[?&]theme=(dark|light)/); if (qm) t = qm[1]; if (!t && window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches) t = 'dark'; if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) { }</script>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect x='2' y='2' width='60' height='60' rx='17' fill='%230d4f8b'/%3E%3Ccircle cx='47' cy='17' r='5.5' fill='%23ffb25e'/%3E%3Cpath d='M15 40 V15 M15 17 H41 M15 17 L9 25' stroke='white' stroke-width='3.4' fill='none' stroke-linecap='round'/%3E%3Crect x='27.5' y='25' width='11' height='8' rx='1.8' fill='%23ff7d2d'/%3E%3Crect x='20' y='36.5' width='8.5' height='6' rx='1.2' fill='%2322d3ee'/%3E%3Crect x='29.5' y='36.5' width='8.5' height='6' rx='1.2' fill='%23ffb25e'/%3E%3Crect x='39' y='36.5' width='8.5' height='6' rx='1.2' fill='%234ade80'/%3E%3Cpath d='M14 43 H53 L48.5 51 H18.5 Z' fill='%23061c35'/%3E%3Cpath d='M11 55 q5 -3.4 10 0 t10 0 t10 0 t10 0' stroke='%237fd0f5' stroke-width='2.6' fill='none'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/site.css")?v=10" rel="stylesheet" />
    <link href="@Url.Content("~/Content/payment.css")?v=2" rel="stylesheet" />
    <link href="@Url.Content("~/Content/auth.css")?v=5" rel="stylesheet" />
    <link href="@Url.Content("~/Content/wow.css")?v=6" rel="stylesheet" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0a2f57" />
    <link rel="apple-touch-icon" href="/Content/img/app-icons/apple-touch-icon.png" />
</head>
<body>
    <div class="scroll-progress" id="scrollProgress"></div>
    <nav class="navbar navbar-expand-lg navbar-sp sticky-top">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                @Html.Partial("_Logo")
                <span>SmartPort<span class="brand-sub">Cảng quốc tế · Logistics</span></span>
            </a>
            <button class="navbar-toggler text-white border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <i class="bi bi-list fs-2"></i>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link @(ctrl == "home" && act == "index" ? "active" : "")" href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link @(ctrl == "home" && act == "about" ? "active" : "")" href="@Url.Action("About", "Home")">Giới thiệu</a></li>
                    <li class="nav-item"><a class="nav-link @(ctrl == "schedule" ? "active" : "")" href="@Url.Action("Index", "Schedule")">Lịch tàu</a></li>
                    <li class="nav-item"><a class="nav-link @(ctrl == "tracking" ? "active" : "")" href="@Url.Action("Index", "Tracking")">Tra cứu container</a></li>
                    <li class="nav-item"><a class="nav-link @(ctrl == "services" ? "active" : "")" href="@Url.Action("Index", "Services")">Dịch vụ &amp; Giá</a></li>
                    <li class="nav-item"><a class="nav-link @(ctrl == "cost" ? "active" : "")" href="@Url.Action("Index", "Cost")">Ước tính phí <span class="badge" style="background:#22c55e;font-size:.55rem;vertical-align:top;">AI</span></a></li>
                    <li class="nav-item"><a class="nav-link @(ctrl == "news" ? "active" : "")" href="@Url.Action("Index", "News")">Tin tức</a></li>
                    <li class="nav-item"><a class="nav-link @(ctrl == "home" && act == "contact" ? "active" : "")" href="@Url.Action("Contact", "Home")">Liên hệ</a></li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <button class="theme-btn" id="themeToggle" type="button" title="Chuyển chế độ tối/sáng"><i class="bi bi-moon-stars-fill"></i></button>
                    @if (hoTen == null)
                    {
                        <a class="nav-link text-white-50 me-1" href="@Url.Action("Register", "Account")">Đăng ký</a>
                        <a class="btn btn-login" href="@Url.Action("Login", "Account")"><i class="bi bi-person-circle me-1"></i>Đăng nhập</a>
                    }
                    else
                    {
                        <div class="dropdown">
                            <a class="btn btn-login dropdown-toggle" data-bs-toggle="dropdown" href="#">
                                <i class="bi bi-person-circle me-1"></i>@hoTen
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (vaiTro == "Admin" || vaiTro == "NhanVien")
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("Index", "Dashboard", new { area = "Admin" })"><i class="bi bi-speedometer2 me-2"></i>Trang quản trị</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                                @if (vaiTro == "KhachHang")
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("Index", "HangCuaToi")"><i class="bi bi-boxes me-2"></i>Hàng &amp; lệnh của tôi</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Create", "Booking")"><i class="bi bi-plus-circle me-2"></i>Đặt dịch vụ</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("My", "Booking")"><i class="bi bi-receipt me-2"></i>Booking của tôi</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("History", "Payment")"><i class="bi bi-clock-history me-2"></i>Lịch sử thanh toán</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                                <li><a class="dropdown-item" href="@Url.Action("Profile", "Account")"><i class="bi bi-person-gear me-2"></i>Hồ sơ cá nhân</a></li>
                                <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </nav>

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show alert-float" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Err"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show alert-float" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Err"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @RenderBody()

    <div class="container" style="margin-top:56px;">
        <div class="newsletter" data-reveal>
            <div class="row align-items-center g-3">
                <div class="col-lg-6">
                    <h4 class="fw-bold mb-1"><i class="bi bi-envelope-heart me-2"></i>Nhận bản tin lịch tàu &amp; ưu đãi</h4>
                    <p class="mb-0" style="color:#d8ecff;">Lịch tàu tuần, thay đổi biểu phí và ưu đãi dịch vụ — gửi mỗi sáng thứ 2.</p>
                </div>
                <div class="col-lg-6">
                    @using (Html.BeginForm("Subscribe", "Home", FormMethod.Post, new { @class = "d-flex gap-2" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="email" name="email" class="form-control" placeholder="Email doanh nghiệp của bạn..." required />
                        <button class="btn btn-accent btn-glow px-4 flex-shrink-0" type="submit">Đăng ký</button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="footer-wave" aria-hidden="true">
        <svg class="fw-svg" viewBox="0 0 2880 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path class="fw2" d="M0 46 Q180 16 360 46 T720 46 T1080 46 T1440 46 T1800 46 T2160 46 T2520 46 T2880 46 V80 H0 Z" />
            <path class="fw1" d="M0 58 Q180 32 360 58 T720 58 T1080 58 T1440 58 T1800 58 T2160 58 T2520 58 T2880 58 V80 H0 Z" />
        </svg>
    </div>
    <footer class="footer">
        <div class="f-glow" style="left:-120px;top:-60px;background:#1173c4;"></div>
        <div class="f-glow" style="right:-100px;bottom:-140px;background:#ff7d2d;"></div>
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        @Html.Partial("_Logo")
                        <span class="fs-5 fw-bold text-white">SmartPort</span>
                    </div>
                    <p class="small">Cảng container quốc tế ứng dụng công nghệ AI trong quản lý khai thác — kết nối hàng hóa Việt Nam với hơn 50 tuyến dịch vụ toàn cầu.</p>
                    <div class="d-flex gap-3 fs-4 mb-3">
                        <a href="https://www.facebook.com/groups/congdonglogisticsvaxuatnhapkhau/" target="_blank" rel="noopener" title="Cộng đồng Logistics & XNK"><i class="bi bi-facebook"></i></a>
                        <a href="@("https://www.youtube.com/" + "@" + "vietnamlogisticsreview")" target="_blank" rel="noopener" title="Vietnam Logistics Review"><i class="bi bi-youtube"></i></a>
                        <a href="@Url.Action("Contact", "Home")" title="Liên hệ"><i class="bi bi-envelope"></i></a>
                    </div>
                    <div class="owner-links small">
                        <div class="mb-1" style="color:#7f9cbd;">Kết nối với chủ dự án:</div>
                        <a href="@fbCaNhan" target="_blank" rel="noopener"><i class="bi bi-facebook"></i> Anh Tài</a>
                        <a href="https://zalo.me/@zaloPhone" target="_blank" rel="noopener"><span style="font-weight:800;color:#4da3ff;">Z</span> Zalo @zaloPhone</a>
                    </div>
                </div>
                <div class="col-lg-2 col-6">
                    <h6>Liên kết</h6>
                    <ul class="small">
                        <li><a href="@Url.Action("About", "Home")">Giới thiệu cảng</a></li>
                        <li><a href="@Url.Action("Index", "Schedule")">Lịch tàu</a></li>
                        <li><a href="@Url.Action("Index", "News")">Tin tức</a></li>
                        <li><a href="@Url.Action("Contact", "Home")">Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-6">
                    <h6>Dịch vụ</h6>
                    <ul class="small">
                        <li><a href="@Url.Action("Index", "Services")">Bốc xếp container</a></li>
                        <li><a href="@Url.Action("Index", "Services")">Lưu bãi &amp; kho CFS</a></li>
                        <li><a href="@Url.Action("Index", "Services")">Vận chuyển nội địa</a></li>
                        <li><a href="@Url.Action("Index", "TaiXe")">Cổng tài xế · check-in</a></li>
                        <li><a href="@Url.Action("Index", "Cong")">Tình trạng cổng (realtime)</a></li>
                        <li><a href="/Mobile">📱 Ứng dụng di động</a></li>
                        <li><a href="@Url.Action("Index", "Tracking")">Tra cứu container</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h6>Liên hệ</h6>
                    <ul class="small f-contact">
                        <li><span class="f-ico"><i class="bi bi-geo-alt"></i></span><span>Khu bến cảng Cát Lái,<br />TP. Thủ Đức, TP.HCM</span></li>
                        <li><span class="f-ico f-hot"><i class="bi bi-telephone-fill"></i></span><span>Hotline: <a class="fw-bold text-white" href="tel:0387562579">0387 562 579</a><br /><small style="color:#7f9cbd;">Quản lý: Lê Hữu Anh Tài</small></span></li>
                        <li><span class="f-ico"><i class="bi bi-envelope"></i></span><span style="word-break:break-all;"><a href="mailto:lehuuanhtai2020tkh@gmail.com">lehuuanhtai2020tkh@gmail.com</a></span></li>
                    </ul>
                </div>
            </div>
            <div class="f-bottom d-flex flex-wrap justify-content-between gap-2">
                <span>© @DateTime.Now.Year Cảng Quốc tế SmartPort.</span>
                <span style="opacity:.65;">Hình ảnh: Unsplash (giấy phép miễn phí)</span>
                @if (SmartPort.Helpers.AppMode.TrinhDien)
                {
                <span>Đồ án môn Lập trình Web — Lê Hữu Anh Tài (2424802010066)</span>
                }
                else
                {
                <span>SmartPort — Nền tảng AI quản lý cảng &amp; depot · v1.0</span>
                }
            </div>
        </div>
    </footer>

    @Html.Partial("_Chatbot")
    <a class="zalo-fab" href="https://zalo.me/@zaloPhone" target="_blank" rel="noopener" title="Chat Zalo với Anh Tài">Zalo</a>
    @* Nut len dau trang: da co #btnWowTop (wow.js, co vong tien trinh SVG) — bo nut cu de khoi trung 2 nut *@

    <script>window.APP_ROOT = '@Url.Content("~/")';</script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Scripts/site.js")?v=7"></script>
    <script src="@Url.Content("~/Scripts/effects.js")?v=1"></script>
    <script src="@Url.Content("~/Scripts/wow.js")?v=5"></script>
    <script src="@Url.Content("~/Scripts/chatbot.js")?v=8"></script>
    @RenderSection("scripts", required: false)
    <script>if ('serviceWorker' in navigator) { navigator.serviceWorker.register('/sw.js').catch(function () { }); }</script>
</body>
</html>
