                    </svg>
                    <div class="cap"><i class="bi bi-boxes"></i> Cẩu STS làm hàng</div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3" data-reveal data-delay="100">
                <div class="scene-card">
