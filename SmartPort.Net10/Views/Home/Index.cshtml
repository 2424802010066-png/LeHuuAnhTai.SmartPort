@{
    ViewBag.Title = "Trang chủ";
    List<string> ticker = ViewBag.Ticker;
}
@functions {
    public static string SvcIcon(string nhom)
    {
        switch (nhom ?? "")
        {
            case "Bốc xếp": return "bi-boxes";
            case "Lưu bãi": return "bi-stack";
            case "Kho bãi": return "bi-archive";
            case "Vận chuyển": return "bi-truck";
            default: return "bi-gear-wide-connected";
        }
    }
}

<!-- ================= TICKER TRUC TIEP ================= -->
<div class="ticker-bar d-flex align-items-stretch">
    <div class="ticker-label"><span class="dot"></span> TRỰC TIẾP</div>
    <div class="marquee">
        <div class="marquee-track">
            @foreach (var t in ticker)
            {
                <span class="ticker-item">@t</span>
            }
        </div>
    </div>
</div>

<!-- ================= HERO SLIDER + HOAT HINH ================= -->
<section class="hero">
    <div class="hero-slides">
        <div class="hero-slide active" style="background-image:url('@Photos.Url("hero")');"></div>
        <div class="hero-slide" style="background-image:url('@Photos.Url("slide2")');"></div>
        <div class="hero-slide" style="background-image:url('@Photos.Url("slide3")');"></div>
        <div class="hero-slide" style="background-image:url('@Photos.Url("slide4")');"></div>
    </div>
    <div class="hero-dots">
        <button class="active" type="button" aria-label="Ảnh 1"></button>
        <button type="button" aria-label="Ảnh 2"></button>
        <button type="button" aria-label="Ảnh 3"></button>
        <button type="button" aria-label="Ảnh 4"></button>
    </div>
    <div class="hero-particles" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="scroll-hint" aria-hidden="true"><span></span></div>
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="hero-badge mb-3"><i class="bi bi-stars"></i> 10 công nghệ AI · 3 mô hình Deep Learning chạy thật</span>
                <h1 class="mt-3">Quản lý cảng <span class="hl">Logistics</span><br />nhanh — chính xác — trực tuyến</h1>
                <p class="lead mt-3">Tra cứu container thời gian thực, lịch tàu trực tuyến, đặt dịch vụ ePort, ước tính chi phí bằng AI và trò chuyện cùng PortBot 24/7.</p>
                <div class="d-flex flex-wrap gap-2 mt-4 mb-4">
                    <a class="btn btn-accent btn-lg btn-glow" href="@Url.Action("Index", "Schedule")"><i class="bi bi-calendar2-week me-2"></i>Lịch tàu</a>
                    <a class="btn btn-outline-light btn-lg" href="@Url.Action("Index", "Cost")"><i class="bi bi-calculator me-2"></i>Ước tính phí AI</a>
                </div>
                <div class="track-box mt-2" data-reveal="zoom">
                    <label class="mb-1"><i class="bi bi-search me-1"></i>Tra cứu container nhanh</label>
                    <form method="get" action="@Url.Action("Index", "Tracking")" class="d-flex gap-2">
                        <input type="text" name="soCont" class="form-control" placeholder="Nhập số container, VD: MSCU2201417" />
                        <button class="btn btn-navy px-4" type="submit">Tra cứu</button>
                    </form>
                </div>
            </div>
            <div class="col-lg-6 hero-art d-none d-lg-block">
                <!-- TAU THAT tach nen: anh tau container THAT (da son lai thanh
                     SMARTPORT bang AI tach nen U2-Net) noi tren song CSS,
                     bong benh + 3 lop song chay + the AIS truc tiep -->
                <div class="tau-noi" aria-hidden="true">
                    <span class="tn-live"><span class="tn-cham"></span>AIS · THEO DÕI TRỰC TIẾP</span>
                    <div class="tn-boc">
                        <img class="tn-tau" src="@Url.Content("~/Content/img/tau-noi.png")?v=1" alt="" />
                        <!-- Thuy thu doan ti hon di lai tren boong (mu bao ho cam) -->
                        <span class="tn-nguoi n1"></span>
                        <span class="tn-nguoi n2"></span>
                        <span class="tn-nguoi n3"></span>
                        <div class="tn-song s3"></div>
                        <div class="tn-song s2"></div>
                        <div class="tn-song s1"></div>
                    </div>
                    <div class="tn-ten">M/V SMARTPORT EXPRESS</div>
                    <div class="tn-so">IMO 9839272 · 14,2 hải lý/giờ · hướng 087°</div>
                    <div><span class="tn-tag">🛳 Đang vào luồng — cập Bến B3 lúc 18:00</span></div>
                </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= STATS ================= -->
<section class="stats-band">
    <div class="container">
        <div class="row g-3">
            <div class="col-6 col-lg-3" data-reveal data-delay="0">
                <div class="card-stats wiggle">
                    <div class="stat-ico"><i class="bi bi-bounding-box"></i></div>
                    <div class="stat-num count-up" data-target="@ViewBag.SoBen">0</div>
                    <div class="stat-lbl">Bến đang khai thác</div>
                </div>
            </div>
            <div class="col-6 col-lg-3" data-reveal data-delay="100">
                <div class="card-stats wiggle">
                    <div class="stat-ico" style="background:#e6f6fb;color:#0b7ea8;"><i class="bi bi-water"></i></div>
                    <div class="stat-num count-up" data-target="@ViewBag.TauDangCap">0</div>
                    <div class="stat-lbl">Tàu đang trong cảng</div>
                </div>
            </div>
            <div class="col-6 col-lg-3" data-reveal data-delay="200">
                <div class="card-stats wiggle">
                    <div class="stat-ico" style="background:#fff0e3;color:#e5691d;"><i class="bi bi-box-seam"></i></div>
                    <div class="stat-num count-up" data-target="@ViewBag.ContTrongBai">0</div>
                    <div class="stat-lbl">Container trong bãi</div>
                </div>
            </div>
            <div class="col-6 col-lg-3" data-reveal data-delay="300">
                <div class="card-stats wiggle">
                    <div class="stat-ico" style="background:#e6f7ee;color:#0f8a4d;"><i class="bi bi-graph-up-arrow"></i></div>
                    <div class="stat-num count-up" data-target="@ViewBag.SanLuongNam">0</div>
                    <div class="stat-lbl">TEU thông qua năm nay</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= 6 TRO LY AI ================= -->
<section class="sec pb-0">
    <div class="container">
        <div class="ai-strip" data-reveal>
            <div class="text-center mb-4 position-relative">
                <div class="sec-kicker" style="color:#ffb25e;">TRÍ TUỆ NHÂN TẠO</div>
                <h2 class="sec-title text-white mb-1">10 công nghệ AI vận hành cùng SmartPort</h2>
                <p class="mb-0" style="color:#bcd3ea;">Từ chatbot, thị giác máy tính, OCR đến mạng nơ-ron tự huấn luyện — AI ở mọi khâu</p>
            </div>
            <div class="row g-3 position-relative justify-content-center">
                <div class="col-md-6 col-lg-4" data-reveal data-delay="0">
                    <a class="ai-card d-block" href="#" onclick="document.getElementById('pbFab').click(); return false;">
                        <div class="ico"><i class="bi bi-robot"></i></div>
                        <h6>PortBot — Chatbot 24/7</h6>
                        <p>Tra container, lịch tàu, bảng giá, booking bằng ngôn ngữ tự nhiên. Tích hợp Google Gemini.</p>
                    </a>
                </div>
                <div class="col-md-6 col-lg-4" data-reveal data-delay="80">
                    <a class="ai-card d-block" href="@Url.Action("Index", "Cost")">
                        <span class="tag-new">MỚI</span>
                        <div class="ico"><i class="bi bi-calculator"></i></div>
                        <h6>Ước tính chi phí</h6>
                        <p>Khai báo lô hàng — AI tính chi tiết từng khoản phí kèm gợi ý tiết kiệm thông minh.</p>
                    </a>
                </div>
                <div class="col-md-6 col-lg-4" data-reveal data-delay="160">
                    <div class="ai-card">
                        <div class="ico"><i class="bi bi-graph-up-arrow"></i></div>
                        <h6>Dự báo sản lượng</h6>
                        <p>Hồi quy tuyến tính trên dữ liệu 18 tháng, dự báo TEU 3 tháng tới cho ban điều hành.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4" data-reveal data-delay="240">
                    <div class="ai-card">
                        <div class="ico"><i class="bi bi-bounding-box"></i></div>
                        <h6>Phân bổ bến tàu</h6>
                        <p>Chấm điểm bến theo LOA, mớn nước, lịch trống và dự đoán giờ giải phóng tàu.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4" data-reveal data-delay="320">
                    <div class="ai-card">
                        <span class="tag-new">MỚI</span>
                        <div class="ico"><i class="bi bi-grid-3x3-gap"></i></div>
                        <h6>Gợi ý vị trí hạ bãi</h6>
                        <p>Chọn khu — bay — hàng — tầng tối ưu cho từng container, hạn chế đảo chuyển.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4" data-reveal data-delay="400">
                    <div class="ai-card">
                        <span class="tag-new">MỚI</span>
                        <div class="ico"><i class="bi bi-bell"></i></div>
                        <h6>Trợ lý cảnh báo vận hành</h6>
                        <p>Quét dữ liệu liên tục: tàu chưa có bến, cont lạnh thiếu nhiệt độ, hàng tồn bãi lâu...</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4" data-reveal data-delay="480">
                    <div class="ai-card">
                        <span class="tag-new" style="background:#8b5cf6;">DEEP LEARNING</span>
                        <div class="ico" style="background:linear-gradient(135deg,#8b5cf6,#c084fc);"><i class="bi bi-camera-video"></i></div>
                        <h6>Camera AI — YOLOv10</h6>
                        <p>Mạng nơ-ron nhận diện xe tải, người, tàu... qua ảnh &amp; webcam real-time, cảnh báo điều phối cổng.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4" data-reveal data-delay="560">
                    <a class="ai-card d-block" href="@Url.Action("Index", "Tracking")">
                        <span class="tag-new" style="background:#8b5cf6;">DEEP LEARNING</span>
                        <div class="ico" style="background:linear-gradient(135deg,#0ea5e9,#38bdf8);"><i class="bi bi-upc-scan"></i></div>
                        <h6>OCR quét số container</h6>
                        <p>Mạng LSTM đọc ký tự trên vỏ container từ ảnh chụp — tự điền mã và tra cứu ngay.</p>
                    </a>
                </div>
                <div class="col-md-6 col-lg-4" data-reveal data-delay="640">
                    <div class="ai-card">
                        <span class="tag-new" style="background:#8b5cf6;">DEEP LEARNING</span>
                        <div class="ico" style="background:linear-gradient(135deg,#6d28d9,#8b5cf6);"><i class="bi bi-diagram-3"></i></div>
                        <h6>AI Lab — mạng nơ-ron tự huấn luyện</h6>
                        <p>Train MLP dự báo TEU ngay trên trình duyệt: chỉnh epochs, learning rate, xem loss giảm real-time.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4" data-reveal data-delay="720">
                    <a class="ai-card d-block" href="#" onclick="document.getElementById('pbFab').click(); return false;">
                        <span class="tag-new" style="background:#22c55e;">MỚI</span>
                        <div class="ico" style="background:linear-gradient(135deg,#059669,#34d399);"><i class="bi bi-mic"></i></div>
                        <h6>Trợ lý giọng nói tiếng Việt</h6>
                        <p>Bấm mic nói câu hỏi với PortBot và nghe bot đọc câu trả lời — rảnh tay khi đang lái xe vào cảng.</p>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= DICH VU ================= -->
<section class="sec">
    <div class="container">
        <div class="text-center mb-5" data-reveal>
            <div class="sec-kicker">Dịch vụ cảng</div>
            <h2 class="sec-title">Giải pháp logistics trọn gói tại cảng</h2>
        </div>
        <div class="row g-4">
            @{ int dvIdx = 0; }
            @foreach (DichVu dv in ViewBag.DichVus)
            {
                <div class="col-md-6 col-lg-4" data-reveal data-delay="@(dvIdx * 70)">
                    <div class="svc-card">
                        <div class="svc-ico float-slow"><i class="bi @SvcIcon(dv.NhomDV)"></i></div>
                        <h5>@dv.TenDV</h5>
                        <p class="text-muted small mb-2" style="min-height:40px;">@dv.MoTa</p>
                        <div class="svc-price">@Ui.Vnd(dv.DonGia) <span class="text-muted fw-normal small">/ @dv.DonViTinh</span></div>
                    </div>
                </div>
                dvIdx++;
            }
        </div>
        <div class="text-center mt-4" data-reveal>
            <a class="btn btn-outline-sp" href="@Url.Action("Index", "Services")">Xem bảng giá đầy đủ <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
    </div>
</section>

<!-- ================= QUY TRINH ================= -->
<section class="sec pt-0">
    <div class="container">
        <div class="text-center mb-5" data-reveal>
            <div class="sec-kicker">Quy trình</div>
            <h2 class="sec-title">4 bước sử dụng dịch vụ cảng</h2>
        </div>
        <div class="row g-4 step-flow">
            <div class="col-6 col-lg-3 step-item" data-reveal data-delay="0">
                <div class="step-num"><i class="bi bi-person-plus"></i></div>
                <h6>1. Đăng ký ePort</h6>
                <p>Tạo tài khoản doanh nghiệp miễn phí, đặt dịch vụ trực tuyến trong 3 phút.</p>
            </div>
            <div class="col-6 col-lg-3 step-item" data-reveal data-delay="120">
                <div class="step-num"><i class="bi bi-clipboard-check"></i></div>
                <h6>2. Booking được duyệt</h6>
                <p>Phòng khai thác xác nhận, trạng thái cập nhật trực tuyến từng bước.</p>
            </div>
            <div class="col-6 col-lg-3 step-item" data-reveal data-delay="240">
                <div class="step-num"><i class="bi bi-boxes"></i></div>
                <h6>3. Làm hàng tại cảng</h6>
                <p>Bốc xếp — lưu bãi — đóng rút với vị trí bãi do AI đề xuất tối ưu.</p>
            </div>
            <div class="col-6 col-lg-3 step-item" data-reveal data-delay="360">
                <div class="step-num"><i class="bi bi-truck"></i></div>
                <h6>4. Giao nhận &amp; theo dõi</h6>
                <p>Gate out nhanh chóng, tra cứu hành trình container mọi lúc mọi nơi.</p>
            </div>
        </div>
    </div>
</section>

<!-- ================= PARALLAX SO LIEU ================= -->
<section class="parallax-band" style="background-image:url('@Photos.Url("head")');">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-6 col-lg-3" data-reveal data-delay="0">
                <div class="px-num"><span class="count-up" data-target="214">0</span>+</div>
                <div class="px-lbl">Chuyến tàu mỗi quý</div>
            </div>
            <div class="col-6 col-lg-3" data-reveal data-delay="100">
                <div class="px-num"><span class="count-up" data-target="2500">0</span>+</div>
                <div class="px-lbl">Lượt xe container/ngày</div>
            </div>
            <div class="col-6 col-lg-3" data-reveal data-delay="200">
                <div class="px-num"><span class="count-up" data-target="99">0</span>,2%</div>
                <div class="px-lbl">Booking xử lý đúng hạn</div>
            </div>
            <div class="col-6 col-lg-3" data-reveal data-delay="300">
                <div class="px-num">24/7</div>
                <div class="px-lbl">Vận hành không nghỉ — kể cả lễ Tết</div>
            </div>
        </div>
    </div>
</section>

<!-- ================= LICH TAU ================= -->
<section class="sec">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-4" data-reveal>
            <div>
                <div class="sec-kicker">Lịch khai thác</div>
                <h2 class="sec-title mb-0">Tàu sắp cập cảng</h2>
            </div>
            <a class="btn btn-outline-sp btn-sm" href="@Url.Action("Index", "Schedule")">Xem tất cả <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
        <div class="table-responsive table-sp" data-reveal>
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Chuyến</th>
                        <th>Tàu</th>
                        <th>ETA</th>
                        <th>ETD</th>
                        <th>Bến</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ChuyenTau c in ViewBag.ChuyenSapToi)
                    {
                        <tr>
                            <td class="fw-semibold">@c.MaChuyenHieu</td>
                            <td>@(c.Tau != null ? c.Tau.TenTau : "—")</td>
                            <td>@Ui.Dt(c.ETA)</td>
                            <td>@Ui.Dt(c.ETD)</td>
                            <td>@(c.Ben != null ? c.Ben.TenBen : "Chưa phân bến")</td>
                            <td><span class="badge-st @Ui.Badge(c.TrangThai)">@c.TrangThai</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

