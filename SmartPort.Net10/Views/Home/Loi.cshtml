@{
    ViewBag.Title = "Có lỗi xảy ra";
}

<div class="container py-5 text-center" style="max-width:640px;">
    <div style="font-size:6rem;line-height:1;">⚓</div>
    <div class="fw-bold" style="font-size:4.2rem;color:#b45309;letter-spacing:4px;">500</div>
    <h1 class="fw-bold mb-2" style="color:#0a2f57;font-size:1.5rem;">Hệ thống gặp sự cố ngoài ý muốn</h1>
    <p class="text-muted mb-4">
        Sự cố đã được <b>tự động ghi vào nhật ký</b> để đội kỹ thuật xử lý.
        Bạn hãy thử tải lại trang, hoặc quay về trang chủ — thao tác của bạn không bị mất dữ liệu quan trọng.
    </p>
    <div class="d-flex gap-2 justify-content-center flex-wrap">
        <a class="btn btn-primary px-4" href="javascript:location.reload()"><i class="bi bi-arrow-clockwise me-1"></i>Tải lại trang</a>
        <a class="btn btn-outline-primary px-4" href="@Url.Action("Index", "Home")"><i class="bi bi-house-door me-1"></i>Về trang chủ</a>
        <a class="btn btn-outline-secondary px-4" href="@Url.Action("Contact", "Home")"><i class="bi bi-chat-left-text me-1"></i>Báo cho chúng tôi</a>
    </div>
</div>
