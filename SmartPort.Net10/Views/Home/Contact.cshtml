@model SmartPort.Models.LienHe
@{
    ViewBag.Title = "Liên hệ";
    var fbCaNhan = CauHinh.AppSettings["FacebookCaNhan"];
    var zaloPhone = CauHinh.AppSettings["ZaloPhone"];
}
<div class="page-head">
    <div class="container">
        <h1><i class="bi bi-envelope-paper me-2"></i>Liên hệ với chúng tôi</h1>
        <nav><ol class="breadcrumb mt-2"><li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li><li class="breadcrumb-item active">Liên hệ</li></ol></nav>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card-sp p-4">
                <h5 class="fw-bold mb-3" style="color:#0a2f57;">Gửi yêu cầu hỗ trợ</h5>
                @using (Html.BeginForm("Contact", "Home", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true)
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Họ tên <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", placeholder = "Nguyễn Văn A" })
                            @Html.ValidationMessageFor(m => m.HoTen)
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "email@congty.vn" })
                            @Html.ValidationMessageFor(m => m.Email)
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Số điện thoại</label>
                            @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control", placeholder = "09xx xxx xxx" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Chủ đề</label>
                            @Html.TextBoxFor(m => m.ChuDe, new { @class = "form-control", placeholder = "VD: Báo giá lưu bãi" })
                        </div>
                        <div class="col-12">
                            <label class="form-label">Nội dung <span class="text-danger">*</span></label>
                            @Html.TextAreaFor(m => m.NoiDung, new { @class = "form-control", rows = 5, placeholder = "Nội dung cần hỗ trợ..." })
                            @Html.ValidationMessageFor(m => m.NoiDung)
                        </div>
                        <div class="col-12">
                            <button class="btn btn-accent px-4" type="submit"><i class="bi bi-send me-1"></i>Gửi liên hệ</button>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card-sp p-4 mb-4">
                <h5 class="fw-bold mb-3" style="color:#0a2f57;"><i class="bi bi-geo-alt me-2"></i>Thông tin liên hệ</h5>
                <p class="mb-2"><i class="bi bi-building me-2 text-primary"></i>Cảng Quốc tế SmartPort — Khu bến cảng Cát Lái, TP. Thủ Đức, TP.HCM</p>
                <p class="mb-2"><i class="bi bi-telephone me-2 text-primary"></i>Hotline: <strong>0387 562 579</strong> — Quản lý: Lê Hữu Anh Tài</p>
                <p class="mb-2"><i class="bi bi-headset me-2 text-primary"></i>Quản lý: Lê Hữu Anh Tài</p>
                <p class="mb-2"><i class="bi bi-envelope me-2 text-primary"></i>lehuuanhtai2020tkh@gmail.com</p>
                <p class="mb-2"><i class="bi bi-facebook me-2 text-primary"></i>Facebook: <a href="@fbCaNhan" target="_blank" rel="noopener">Anh Tài (chủ dự án)</a></p>
                <p class="mb-0"><span class="me-2 fw-bold" style="color:#0068ff;">Z</span>Zalo: <a href="https://zalo.me/@zaloPhone" target="_blank" rel="noopener">@zaloPhone</a></p>
            </div>
            <div class="card-sp p-4 mb-4" style="background:linear-gradient(150deg,#0a2f57,#0d4f8b);border:none;color:#fff;">
                <h5 class="fw-bold"><i class="bi bi-robot me-2"></i>Cần trả lời ngay?</h5>
                <p class="mb-0" style="color:#c9dcef;">Hãy hỏi <strong>PortBot</strong> — trợ lý ảo AI ở góc phải màn hình: tra container, lịch tàu, bảng giá... phản hồi trong vài giây!</p>
            </div>
            <div class="card-sp p-4">
                <h5 class="fw-bold mb-3" style="color:#0a2f57;"><i class="bi bi-people me-2"></i>Cộng đồng Logistics</h5>
                <a class="d-flex align-items-center gap-3 mb-3 text-decoration-none" href="https://www.facebook.com/groups/congdonglogisticsvaxuatnhapkhau/" target="_blank" rel="noopener">
                    <span style="width:44px;height:44px;border-radius:12px;background:#e8f1fc;color:#1266b0;display:grid;place-items:center;font-size:1.4rem;"><i class="bi bi-facebook"></i></span>
                    <span>
                        <span class="fw-semibold d-block" style="color:#12263a;">Cộng đồng Logistics &amp; XNK</span>
                        <small class="text-muted">Group Facebook hỏi đáp nghiệp vụ</small>
                    </span>
                </a>
                <a class="d-flex align-items-center gap-3 text-decoration-none" href="@("https://www.youtube.com/" + "@" + "vietnamlogisticsreview")" target="_blank" rel="noopener">
                    <span style="width:44px;height:44px;border-radius:12px;background:#fdeeee;color:#dc2626;display:grid;place-items:center;font-size:1.4rem;"><i class="bi bi-youtube"></i></span>
                    <span>
                        <span class="fw-semibold d-block" style="color:#12263a;">Vietnam Logistics Review</span>
                        <small class="text-muted">Kênh video kiến thức logistics</small>
                    </span>
                </a>
            </div>
        </div>
    </div>
</div>
