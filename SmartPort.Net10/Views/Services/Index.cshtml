@model List<SmartPort.Models.DichVu>
@{
    ViewBag.Title = "Dịch vụ & Bảng giá";
    var groups = Model.GroupBy(d => d.NhomDV ?? "Khác").ToList();
    bool isKhach = (new SmartPort.Helpers.SessionBag(Context.Session)["VaiTro"] as string) == "KhachHang";
}
@functions {
    public static string GroupIcon(string nhom)
    {
        switch (nhom ?? "")
        {
            case "Bốc xếp": return "bi-boxes";
            case "Lưu bãi": return "bi-stack";
            case "Kho bãi": return "bi-archive";
            case "Vận chuyển": return "bi-truck";
            default: return "bi-gear-wide-connected";
        }
    }
}
<div class="page-head">
    <div class="container">
        <h1><i class="bi bi-tools me-2"></i>Dịch vụ &amp; Bảng giá</h1>
        <nav><ol class="breadcrumb mt-2"><li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li><li class="breadcrumb-item active">Dịch vụ &amp; Bảng giá</li></ol></nav>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card-sp p-4 h-100">
                <h5 class="fw-bold" style="color:#0a2f57;">Đặt dịch vụ cảng trực tuyến qua ePort</h5>
                <p class="text-muted mb-2">Doanh nghiệp đăng nhập tài khoản khách hàng để gửi yêu cầu dịch vụ online — hệ thống tự động tính phí, bộ phận khai thác duyệt và cập nhật trạng thái theo thời gian thực.</p>
                @if (isKhach)
                {
                    <a class="btn btn-accent" href="@Url.Action("Create", "Booking")"><i class="bi bi-plus-circle me-1"></i>Đặt dịch vụ ngay</a>
                }
                else
                {
                    <div class="d-flex gap-2">
                        <a class="btn btn-accent" href="@Url.Action("Login", "Account")"><i class="bi bi-person-circle me-1"></i>Đăng nhập để đặt</a>
                        <a class="btn btn-outline-sp" href="@Url.Action("Register", "Account")">Đăng ký tài khoản</a>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card-sp p-4 h-100" style="background:linear-gradient(150deg,#0a2f57,#0d4f8b);border:none;color:#fff;">
                <h6 class="fw-bold"><i class="bi bi-percent me-2"></i>Ưu đãi</h6>
                <ul class="small mb-0" style="color:#c9dcef;">
                    <li>Miễn phí lưu bãi <strong>5 ngày đầu</strong> với mọi container</li>
                    <li>Giảm 10% phí bốc xếp cho booking từ 50 cont/tháng</li>
                    <li>Miễn phí cân VGM cho 100 booking đầu qua ePort</li>
                </ul>
            </div>
        </div>
    </div>

    @foreach (var g in groups)
    {
        <div class="d-flex align-items-center gap-2 mb-3 mt-4">
            <span class="svc-ico" style="width:42px;height:42px;font-size:1.2rem;margin:0;"><i class="bi @GroupIcon(g.Key)"></i></span>
            <h4 class="fw-bold mb-0" style="color:#0a2f57;">@g.Key</h4>
        </div>
        <div class="table-responsive table-sp mb-2">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th style="width:32%;">Dịch vụ</th>
                        <th>Mô tả</th>
                        <th style="width:12%;">Đơn vị</th>
                        <th style="width:15%;" class="text-end">Đơn giá</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in g)
                    {
                        <tr>
                            <td class="fw-semibold">@d.TenDV</td>
                            <td class="text-muted small">@d.MoTa</td>
                            <td>@d.DonViTinh</td>
                            <td class="text-end fw-bold" style="color:#e5691d;">@Ui.Vnd(d.DonGia)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <div class="text-muted small mt-3"><i class="bi bi-info-circle me-1"></i>Đơn giá chưa bao gồm VAT. Bảng giá áp dụng từ 01/01/@DateTime.Now.Year, có thể thay đổi theo thông báo của cảng.</div>
</div>
