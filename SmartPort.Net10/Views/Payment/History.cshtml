@model List<SmartPort.Models.ThanhToan>
@{
    ViewBag.Title = "Lịch sử thanh toán";
}
<div class="page-head">
    <div class="container">
        <h1><i class="bi bi-clock-history me-2"></i>Lịch sử thanh toán</h1>
        <nav>
            <ol class="breadcrumb mt-2">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("My", "Booking")">Booking của tôi</a></li>
                <li class="breadcrumb-item active">Lịch sử thanh toán</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="pay-stat" style="background:linear-gradient(120deg,#15803d,#22c55e);">
                <div class="ps-num">@Ui.Vnd((decimal)ViewBag.TongDaTT)</div>
                <div class="ps-lbl">Đã thanh toán</div>
                <i class="bi bi-check-circle-fill"></i>
            </div>
        </div>
        <div class="col-md-4">
            <div class="pay-stat" style="background:linear-gradient(120deg,#e5691d,#ff9d4d);">
                <div class="ps-num">@Ui.Vnd((decimal)ViewBag.TongChoTT)</div>
                <div class="ps-lbl">Chờ thanh toán</div>
                <i class="bi bi-hourglass-split"></i>
            </div>
        </div>
        <div class="col-md-4">
            <div class="pay-stat" style="background:linear-gradient(120deg,#0a2f57,#1c5fa8);">
                <div class="ps-num">@Model.Count</div>
                <div class="ps-lbl">Tổng số giao dịch</div>
                <i class="bi bi-receipt"></i>
            </div>
        </div>
    </div>

    <div class="card-sp p-4">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size:3rem;opacity:.4;"></i>
                <div class="mt-2">Chưa có giao dịch thanh toán nào.</div>
                <a class="btn btn-navy mt-3" href="@Url.Action("Create", "Booking")"><i class="bi bi-plus-circle me-1"></i>Đặt dịch vụ ngay</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sp align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Mã GD</th>
                            <th>Booking</th>
                            <th>Phương thức</th>
                            <th class="text-end">Số tiền</th>
                            <th>Ngày tạo</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td class="fw-semibold">#@t.MaTT</td>
                                <td>@(t.DatDichVu != null ? t.DatDichVu.MaSoBooking : "—")</td>
                                <td>@t.TenPhuongThuc</td>
                                <td class="text-end fw-semibold">@Ui.Vnd(t.SoTien)</td>
                                <td>@Ui.Dt(t.NgayTao)</td>
                                <td><span class="badge-st @Ui.Badge(t.TrangThai)">@t.TrangThai</span></td>
                                <td class="text-end">
                                    @if (t.TrangThai == "Đã thanh toán")
                                    {
                                        <a class="btn btn-sm btn-outline-success" href="@Url.Action("Receipt", new { id = t.MaTT })"><i class="bi bi-receipt me-1"></i>Biên lai</a>
                                    }
                                    else if (t.TrangThai == "Chờ thanh toán")
                                    {
                                        <a class="btn btn-sm btn-navy" href="@Url.Action("Pay", new { id = t.MaTT })"><i class="bi bi-credit-card me-1"></i>Thanh toán</a>
                                    }
                                    else if (t.DatDichVu != null)
                                    {
                                        <a class="btn btn-sm btn-outline-sp" href="@Url.Action("Index", "Payment", new { id = t.MaBooking })"><i class="bi bi-arrow-repeat me-1"></i>Tạo lại</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
