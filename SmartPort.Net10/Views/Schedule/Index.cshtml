@model List<SmartPort.Models.ChuyenTau>
@{
    ViewBag.Title = "Lịch tàu";
    string curStatus = ViewBag.TrangThai as string;
    int? curHang = ViewBag.HangTau as int?;
    string[] statuses = { "Dự kiến", "Đã cập bến", "Đang làm hàng", "Đã rời bến", "Hủy" };
}
<div class="page-head">
    <div class="container">
        <h1><i class="bi bi-calendar2-week me-2"></i>Lịch tàu cập cảng</h1>
        <nav><ol class="breadcrumb mt-2"><li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li><li class="breadcrumb-item active">Lịch tàu</li></ol></nav>
    </div>
</div>

<div class="container mb-5">
    <div class="card-sp p-3 mb-4">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label mb-1">Trạng thái</label>
                <select name="trangThai" class="form-select">
                    <option value="">— Tất cả —</option>
                    @foreach (var s in statuses)
                    {
                        <option value="@s" @(s == curStatus ? "selected" : "")>@s</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label mb-1">Hãng tàu</label>
                <select name="hangTau" class="form-select">
                    <option value="">— Tất cả —</option>
                    @foreach (HangTau h in ViewBag.HangTaus)
                    {
                        <option value="@h.MaHangTau" @(curHang == h.MaHangTau ? "selected" : "")>@h.TenHangTau</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button class="btn btn-navy w-100" type="submit"><i class="bi bi-funnel me-1"></i>Lọc lịch tàu</button>
            </div>
        </form>
    </div>

    <div class="table-responsive table-sp">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Chuyến</th>
                    <th>Tàu</th>
                    <th>Hãng tàu</th>
                    <th>ETA / ATA</th>
                    <th>ETD / ATD</th>
                    <th>Bến</th>
                    <th class="text-end">Cont nhập/xuất</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Không có chuyến tàu nào phù hợp bộ lọc.</td></tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.MaChuyenHieu</td>
                        <td>
                            @(c.Tau != null ? c.Tau.TenTau : "—")
                            @if (c.Tau != null && c.Tau.SucChuaTEU.HasValue)
                            {
                                <div class="text-muted small">@Ui.Num(c.Tau.SucChuaTEU) TEU</div>
                            }
                        </td>
                        <td>@(c.Tau != null && c.Tau.HangTau != null ? c.Tau.HangTau.TenHangTau : "—")</td>
                        <td>
                            @Ui.Dt(c.ETA)
                            @if (c.ATA.HasValue)
                            {
                                <div class="text-success small"><i class="bi bi-check2"></i> @Ui.Dt(c.ATA)</div>
                            }
                        </td>
                        <td>
                            @Ui.Dt(c.ETD)
                            @if (c.ATD.HasValue)
                            {
                                <div class="text-success small"><i class="bi bi-check2"></i> @Ui.Dt(c.ATD)</div>
                            }
                        </td>
                        <td>@(c.Ben != null ? c.Ben.TenBen : "Chưa phân bến")</td>
                        <td class="text-end">@c.ContNhap / @c.ContXuat</td>
                        <td><span class="badge-st @Ui.Badge(c.TrangThai)">@c.TrangThai</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="text-muted small mt-3"><i class="bi bi-info-circle me-1"></i>ETA/ETD: thời gian dự kiến đến/rời — ATA/ATD: thời gian thực tế. Lịch có thể thay đổi theo điều kiện khai thác và thời tiết.</div>
</div>
