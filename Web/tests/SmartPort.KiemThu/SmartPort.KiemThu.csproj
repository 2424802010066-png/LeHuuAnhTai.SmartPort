<Project Sdk="Microsoft.NET.Sdk">

  <!--
    KIEM THU KIEN TRUC + TICH HOP cho Modular Monolith huong su kien.
      dotnet run (project nay) voi tham so: kien-truc | tich-hop | tat-ca
      tich-hop can bien moi truong SMARTPORT_KIEMTHU_DB; ten CSDL phai ket thuc bang _KiemThu.
    Khong dung goi NuGet test (xUnit...) de chay duoc tren may khong co mang.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SmartPort.KiemThu</RootNamespace>
    <AssemblyName>SmartPort.KiemThu</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SmartPort.Core\SmartPort.Core.csproj" />
    <ProjectReference Include="..\..\SmartPort.NenTang\SmartPort.NenTang.csproj" />
    <ProjectReference Include="..\..\SmartPort.Modules.Cong\SmartPort.Modules.Cong.csproj" />
    <ProjectReference Include="..\..\SmartPort.Modules.Bai\SmartPort.Modules.Bai.csproj" />
    <ProjectReference Include="..\..\SmartPort.Modules.TaiChinh\SmartPort.Modules.TaiChinh.csproj" />
    <ProjectReference Include="..\..\SmartPort.Modules.ThongBao\SmartPort.Modules.ThongBao.csproj" />
  </ItemGroup>

</Project>
