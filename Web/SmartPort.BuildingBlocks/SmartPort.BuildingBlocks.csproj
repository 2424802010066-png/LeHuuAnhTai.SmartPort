<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SMARTPORT.BUILDINGBLOCKS — HA TANG DUNG CHUNG cho cac module (khong chua nghiep vu):
      - Su kien tich hop (integration event) + danh muc loai su kien
      - Transactional Outbox: ghi su kien CUNG giao dich voi du lieu nghiep vu
      - Bo phat su kien (dispatcher) chay nen: doc Outbox -> goi cac bo xu ly
      - Chong xu ly trung (inbox SuKienDaXuLy) + thu lai + danh dau loi vinh vien
    Modular Monolith: module KHONG goi thang nhau, chi nhan tin qua lop nay.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SmartPort.BuildingBlocks</RootNamespace>
    <AssemblyName>SmartPort.BuildingBlocks</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- BackgroundService, DI, logging -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>

</Project>
